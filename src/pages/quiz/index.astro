---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { 
    getBeginnerQuestions, 
    INTERMEDIATE_QUESTIONS, 
    ADVANCED_QUESTIONS, 
    MASTER_QUESTIONS,
    TOP_10_DINOSAURS
} from '../../data/quiz';
import { EXAM_QUESTIONS } from '../../data/exam';

const dinosaurEntries = await getCollection('dinosaurs');
const DINOSAURS = dinosaurEntries.map(entry => entry.data);
const BEGINNER_QUESTIONS = getBeginnerQuestions();
---

<Layout title="恐竜クイズ | Dino-Portal" activeTab="quiz" description="大迫力のイラスト・シルエット・3大ヒント・最新学説から解き明かす新感覚の恐竜サイバークイズ。目指せ恐竜博士！">
    <!-- Data bridge to client script -->
    <div id="quiz-data-bridge" 
         data-dinosaurs={JSON.stringify(DINOSAURS)} 
         data-top10-dinosaurs={JSON.stringify(TOP_10_DINOSAURS)}
         data-beginner-questions={JSON.stringify(BEGINNER_QUESTIONS)}
         data-intermediate-questions={JSON.stringify(INTERMEDIATE_QUESTIONS)}
         data-advanced-questions={JSON.stringify(ADVANCED_QUESTIONS)}
         data-master-questions={JSON.stringify(MASTER_QUESTIONS)}
         data-exam-questions={JSON.stringify(EXAM_QUESTIONS)} 
         style="display: none;">
    </div>

    <div class="quiz-container">
        <!-- HEADER -->
        <section class="page-header" style="margin-bottom: 20px;">
            <h2 class="page-title">恐竜クイズ ＆ 検定</h2>
        </section>

        <!-- START PANEL -->
        <div id="quiz-start-panel" class="hud-panel start-panel">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            
            <div class="panel-icon">🦖</div>
            <h3>CYBER DINO QUIZ TERMINAL</h3>
            
            <!-- モード選択タブ -->
            <div class="mode-selector" style="display: flex; justify-content: center; gap: 15px; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 15px;">
                <button class="mode-tab active" data-mode="aptitude" style="flex: 1; max-width: 250px; background: rgba(0, 242, 255, 0.03); border: 1px solid rgba(0, 242, 255, 0.2); padding: 12px; border-radius: 4px; color: var(--text-dim); cursor: pointer; transition: all 0.3s ease;">
                    <div style="font-size: 14px; font-weight: bold; color: var(--primary-neon); transition: color 0.3s ease;">恐竜クイズ</div>
                </button>
                <button class="mode-tab" data-mode="exam" style="flex: 1; max-width: 250px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--panel-border); padding: 12px; border-radius: 4px; color: var(--text-dim); cursor: pointer; transition: all 0.3s ease;">
                    <div style="font-size: 14px; font-weight: bold; color: var(--text-main); transition: color 0.3s ease;">恐竜学検定 模擬試験</div>
                </button>
            </div>

            <p id="mode-description-text" style="line-height: 1.8; color: var(--text-dim); font-size: 14px; max-width: 600px; margin: 0 auto 25px auto;">
                美麗イラスト、シルエット、3大ヒント、骨格スキャン、最新学説から恐竜の謎を解き明かすクイズです。<br>
                難易度を選んで挑戦してください。
            </p>

            <!-- 難易度セレクター -->
            <div class="difficulty-section" style="margin-bottom: 30px;">
                <div style="font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 2px;">
                    難易度を選択
                </div>
                <div class="difficulty-buttons" style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                    <button class="diff-btn active" data-difficulty="beginner" style="min-width: 120px;">
                        初級<span style="display:block; font-size: 9px; font-family: var(--font-mono); color: var(--secondary-neon); margin-top: 2px;">BEGINNER</span>
                    </button>
                    <button class="diff-btn" data-difficulty="intermediate" style="min-width: 120px;">
                        中級<span style="display:block; font-size: 9px; font-family: var(--font-mono); color: var(--secondary-neon); margin-top: 2px;">INTERMEDIATE</span>
                    </button>
                    <button class="diff-btn" data-difficulty="advanced" style="min-width: 120px;">
                        上級<span style="display:block; font-size: 9px; font-family: var(--font-mono); color: var(--secondary-neon); margin-top: 2px;">ADVANCED</span>
                    </button>
                    <button class="diff-btn locked" data-difficulty="master" disabled style="min-width: 120px;">
                        恐竜博士<span class="diff-subtext" style="display:block; font-size: 9px; font-family: var(--font-mono); color: var(--text-dim); margin-top: 2px;">🔒 LOCKED</span>
                    </button>
                </div>
                <div id="master-unlock-notice" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-top: 8px;">
                    ※「恐竜博士」は上級で80%以上正解するとアンロックされます
                </div>
            </div>

            <div class="start-meta" style="font-family: var(--font-mono); font-size: 12px; color: var(--secondary-neon); margin-bottom: 25px;">
                [ <span id="difficulty-label-display">初級</span>ハイスコア: <span id="start-high-score">0%</span> ]
            </div>

            <button id="start-test-btn" class="action-btn">
                クイズスタート
            </button>
        </div>

        <!-- MAIN QUIZ PANEL (Hidden Initially) -->
        <div id="quiz-main-panel" class="hud-panel quiz-panel" style="display: none;">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>

            <!-- Quiz Header Info -->
            <div class="quiz-progress-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--panel-border); padding-bottom: 12px; margin-bottom: 20px; font-family: var(--font-mono); font-size: 12px;">
                <span class="quiz-step-indicator" style="color: var(--primary-neon);">[ QUESTION: 01 / 05 ]</span>
                <span id="quiz-category-tag" style="background: rgba(0, 242, 255, 0.1); border: 1px solid var(--primary-neon); color: var(--primary-neon); padding: 2px 8px; border-radius: 2px; font-size: 10px;">STANDARD</span>
                <span class="quiz-score-indicator" style="color: var(--secondary-neon);">正解数: 0</span>
            </div>

            <!-- Master Timer Bar (Only visible in Master mode) -->
            <div id="quiz-timer-container" style="display: none; margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; margin-bottom: 4px;">
                    <span style="color: var(--alert-neon);">LIMIT TIMER (30s)</span>
                    <span id="quiz-timer-text" style="color: var(--alert-neon); font-weight: bold;">30s</span>
                </div>
                <div style="width: 100%; height: 6px; background: rgba(255, 0, 90, 0.1); border: 1px solid rgba(255, 0, 90, 0.3); border-radius: 3px; overflow: hidden;">
                    <div id="quiz-timer-fill" style="width: 100%; height: 100%; background: var(--alert-neon); transition: width 0.1s linear;"></div>
                </div>
            </div>

            <!-- Question Prompt Title (Top Full-width) -->
            <div class="question-prompt" id="question-prompt-text" style="font-family: var(--font-mono); font-size: 16px; color: var(--text-main); margin-bottom: 20px; border-left: 3px solid var(--primary-neon); padding-left: 15px; line-height: 1.6;">
                クイズをロード中...
            </div>

            <div class="quiz-content-layout" style="display: flex; gap: 25px; flex-wrap: wrap;">
                <!-- Visual/Question Left Area -->
                <div class="quiz-question-visual-area" style="flex: 1.2; min-width: 300px;">
                    <!-- Visual Frame Container -->
                    <div class="quiz-visual-frame" style="width: 100%; aspect-ratio: 16 / 9; background: #000; border: 1px solid var(--panel-border); border-radius: 4px; overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center;">
                        
                        <!-- 1. Main Visual Mode (Full Color Art) -->
                        <div id="visual-main-container" style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; position: relative;">
                            <img id="main-art-image" src="" alt="Dinosaur Visual" style="width: 90%; height: 90%; object-fit: contain;">
                        </div>

                        <!-- 2. Silhouette Mode with Reveal Animation -->
                        <div id="visual-silhouette-container" style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; position: relative;">
                            <img id="silhouette-image" src="" alt="Silhouette Specimen" style="width: 88%; height: 88%; object-fit: contain; filter: drop-shadow(0 0 12px var(--primary-neon)); transition: opacity 0.5s ease;">
                            <!-- Reveal color image on answer -->
                            <img id="silhouette-reveal-image" src="" alt="Revealed Dinosaur" style="position: absolute; width: 88%; height: 88%; object-fit: contain; opacity: 0; transition: opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); pointer-events: none;">
                        </div>

                        <!-- 3. Skeletal Scan Mode (Cyber Asset) -->
                        <div id="visual-skeletal-container" style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; position: relative; background: radial-gradient(circle, rgba(0, 242, 255, 0.05) 0%, rgba(0, 0, 0, 0.9) 100%);">
                            <img id="skeletal-image" src="" alt="Cyber Skeletal Scan" style="width: 92%; height: 92%; object-fit: contain; filter: drop-shadow(0 0 15px rgba(0, 242, 255, 0.6));">
                            <div style="position: absolute; bottom: 8px; right: 10px; font-family: var(--font-mono); font-size: 9px; color: var(--primary-neon); letter-spacing: 1px;">
                                [ SKELETAL SCAN: 1:1 LATERAL PROJECTION ]
                            </div>
                        </div>

                        <!-- 4. 3-Hints Telemetry Mode -->
                        <div id="visual-hints-container" style="display: none; width: 100%; padding: 5px 0; flex-direction: column; font-family: var(--font-mono);">
                            <div class="telemetry-hints-box" style="display: flex; flex-direction: column; gap: 10px; width: 100%;">
                                <div class="hint-line" style="background: rgba(0, 242, 255, 0.03); border: 1px solid rgba(0, 242, 255, 0.1); border-left: 3px solid var(--secondary-neon); padding: 12px 16px; font-size: 13px; color: var(--text-main); line-height: 1.6; border-radius: 0 4px 4px 0; display: flex; align-items: flex-start; gap: 12px;">
                                    <span style="color: var(--secondary-neon); font-weight: bold; white-space: nowrap; font-family: var(--font-mono); letter-spacing: 1px;">[ヒント1]</span>
                                    <span id="hint-text-1" style="flex: 1;"></span>
                                </div>
                                <div class="hint-line" style="background: rgba(0, 242, 255, 0.03); border: 1px solid rgba(0, 242, 255, 0.1); border-left: 3px solid var(--primary-neon); padding: 12px 16px; font-size: 13px; color: var(--text-main); line-height: 1.6; border-radius: 0 4px 4px 0; display: flex; align-items: flex-start; gap: 12px;">
                                    <span style="color: var(--primary-neon); font-weight: bold; white-space: nowrap; font-family: var(--font-mono); letter-spacing: 1px;">[ヒント2]</span>
                                    <span id="hint-text-2" style="flex: 1;"></span>
                                </div>
                                <div class="hint-line" style="background: rgba(0, 242, 255, 0.03); border: 1px solid rgba(0, 242, 255, 0.1); border-left: 3px solid #ffcc00; padding: 12px 16px; font-size: 13px; color: var(--text-main); line-height: 1.6; border-radius: 0 4px 4px 0; display: flex; align-items: flex-start; gap: 12px;">
                                    <span style="color: #ffcc00; font-weight: bold; white-space: nowrap; font-family: var(--font-mono); letter-spacing: 1px;">[ヒント3]</span>
                                    <span id="hint-text-3" style="flex: 1;"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Scanning overlay line -->
                        <div class="quiz-scan-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; background: linear-gradient(180deg, rgba(0, 242, 255, 0) 0%, rgba(0, 242, 255, 0.03) 40%, rgba(0, 242, 255, 0.08) 50%, rgba(0, 242, 255, 0.03) 60%, rgba(0, 242, 255, 0) 100%); animation: quiz-beam 6s linear infinite;"></div>
                    </div>
                </div>

                <!-- Control/Answer Choices Right Area -->
                <div class="quiz-answers-area" style="flex: 1; min-width: 280px; display: flex; flex-direction: column; justify-content: center;">
                    <div class="answer-label" style="font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 12px; display: flex; justify-content: space-between;">
                        <span>回答を選択してください</span>
                        <span id="choices-tip-text" style="font-size: 11px; color: var(--primary-neon);">[4択]</span>
                    </div>
                    
                    <div class="choices-container" id="quiz-choices-box" style="display: flex; flex-direction: column; gap: 10px;">
                        <!-- Choice Buttons will be injected here -->
                    </div>
                </div>
            </div>

            <!-- Answer Explaining Panel (Full Width Below Content Layout) -->
            <div id="answer-explanation-panel" style="display: none; margin-top: 25px; animation: scan-info-fade 0.4s ease forwards;">
                <div class="explanation-box" style="border: 1px solid var(--panel-border); background: rgba(0, 242, 255, 0.02); padding: 22px 25px; border-radius: 4px; position: relative;">
                    <!-- Correctness Indicator Tag -->
                    <div id="correctness-indicator" style="font-family: var(--font-mono); font-weight: bold; font-size: 17px; margin-bottom: 12px; letter-spacing: 2px;"></div>
                    
                    <!-- Detailed analysis text -->
                    <div id="explanation-detail-text" style="font-size: 14px; line-height: 1.8; color: var(--text-main); margin: 0 0 16px 0;"></div>

                    <!-- Link to dictionary -->
                    <div id="dictionary-link-container" style="margin-bottom: 18px; display: none;">
                        <a id="dino-dictionary-btn" href="#" target="_blank" class="nav-link" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--primary-neon); background: rgba(0, 242, 255, 0.08); color: var(--primary-neon); padding: 8px 18px; font-size: 13px; font-family: var(--font-mono); border-radius: 3px; text-decoration: none; transition: all 0.2s ease;">
                            <span>📖</span> <span id="dict-btn-label">この恐竜を図鑑で詳しく見る ></span>
                        </a>
                    </div>

                    <!-- Other Choices Notes (Hybrid Smart Notes) -->
                    <div id="other-choices-notes" style="display: none; border-top: 1px dashed rgba(255, 255, 255, 0.1); padding-top: 14px; margin-bottom: 18px;">
                        <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); margin-bottom: 10px;">[ 他の選択肢の恐竜メモ ]</div>
                        <div id="other-choices-list" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px; font-size: 12px; color: var(--text-dim); line-height: 1.6;"></div>
                    </div>
                    
                    <!-- Next button -->
                    <button id="next-question-btn" class="action-btn" style="width: 100%; padding: 12px; font-size: 15px;">
                        次の問題へ >
                    </button>
                </div>
            </div>
        </div>

        <!-- SCANNING LOADING PANEL (Hidden Initially) -->
        <div id="quiz-scan-loading" class="hud-panel loading-panel" style="display: none; padding: 60px 20px; text-align: center;">
            <div class="scan-radar-icon" style="color: var(--primary-neon); margin-bottom: 15px; animation: compass-spin 2s linear infinite;">☲</div>
            <h3 style="color: var(--primary-neon); font-family: var(--font-mono); letter-spacing: 3px; font-size: 18px; margin-bottom: 5px;">LOADING QUESTION...</h3>
            <p style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-bottom: 15px;">標本データを解析中</p>
            <div style="width: 100%; height: 6px; background: rgba(0, 242, 255, 0.05); border: 1px solid var(--panel-border); overflow: hidden; width: 220px; margin: 0 auto;">
                <div id="scan-progress-fill" style="width: 0%; height: 100%; background: var(--primary-neon); box-shadow: 0 0 10px var(--primary-neon);"></div>
            </div>
        </div>

        <!-- RESULT PANEL (Hidden Initially) -->
        <div id="quiz-result-panel" class="hud-panel result-panel" style="display: none;">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            
            <div id="high-score-announcement" style="display: none; border: 1px solid var(--alert-neon); background: rgba(255, 0, 90, 0.05); border-left-width: 5px; color: var(--alert-neon); font-family: var(--font-mono); font-size: 12px; padding: 12px 20px; margin-bottom: 25px; letter-spacing: 1px; border-radius: 0 4px 4px 0; animation: glitch 0.5s ease-in-out;">
                ▲ NEW HIGH SCORE: 自己記録を更新しました！
            </div>

            <div style="text-align: center; margin-bottom: 30px;">
                <div class="result-title" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); letter-spacing: 2px;">// FINISHED //</div>
                <h3 style="font-size: 24px; margin: 10px 0 25px 0;">クイズ結果レポート</h3>

                <!-- Synchronization Score Circle Meter -->
                <div class="sync-meter-container" style="position: relative; width: 160px; height: 160px; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center;">
                    <svg style="width: 100%; height: 100%; transform: rotate(-90deg);">
                        <circle cx="80" cy="80" r="70" fill="transparent" stroke="rgba(0, 242, 255, 0.06)" stroke-width="8"></circle>
                        <circle id="sync-meter-circle" cx="80" cy="80" r="70" fill="transparent" stroke="var(--primary-neon)" stroke-width="8" stroke-dasharray="440" stroke-dashoffset="440" style="transition: stroke-dashoffset 1.5s cubic-bezier(0.1, 0.8, 0.1, 1); filter: drop-shadow(0 0 8px var(--primary-neon));"></circle>
                    </svg>
                    <div class="sync-score-text-box" style="position: absolute; text-align: center; font-family: var(--font-mono);">
                        <div id="result-score-percent" style="font-size: 32px; font-weight: bold; color: var(--text-main); line-height: 1;">0%</div>
                        <div style="font-size: 9px; color: var(--primary-neon); margin-top: 4px; letter-spacing: 1.5px;">正解率</div>
                    </div>
                </div>

                <div id="result-rank-badge" style="font-family: var(--font-mono); font-size: 18px; font-weight: bold; color: var(--secondary-neon); letter-spacing: 2px;"></div>
                <div id="result-rank-desc" style="font-size: 13px; color: var(--text-dim); max-width: 600px; margin: 15px auto 0 auto; line-height: 1.7;"></div>
            </div>

            <!-- Master Certificate Box (Only on Master Mode with 80%+ Score) -->
            <div id="master-certificate-area" style="display: none; max-width: 640px; margin: 0 auto 35px auto;">
                <div class="hud-panel cert-card" style="border: 2px solid var(--secondary-neon); background: rgba(0, 255, 102, 0.03); padding: 30px; border-radius: 6px; text-align: center; position: relative; box-shadow: 0 0 25px rgba(0, 255, 102, 0.15);">
                    <div style="font-family: var(--font-mono); font-size: 10px; color: var(--secondary-neon); letter-spacing: 2px; margin-bottom: 8px;">DINO-PORTAL PALEONTOLOGY COUNCIL</div>
                    <h3 style="font-size: 22px; color: #fff; letter-spacing: 3px; margin-bottom: 6px;">恐竜博士 認定証</h3>
                    <div id="cert-rank-title" style="font-size: 16px; color: var(--secondary-neon); font-family: var(--font-mono); font-weight: bold; margin-bottom: 18px;">
                        [ S級・主席 恐竜博士 ]
                    </div>
                    
                    <p style="font-size: 13px; color: var(--text-main); line-height: 1.8; margin-bottom: 20px;">
                        貴殿は当ポータルが実施した恐竜博士認定試験（全10問タイムアタック）において、卓抜した古生物学的知見と探究心を示し、極めて優秀な成績を収めたことをここに証します。
                    </p>

                    <!-- User Name Input -->
                    <div style="margin-bottom: 20px; display: flex; justify-content: center; align-items: center; gap: 10px;">
                        <span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-dim);">認定者氏名:</span>
                        <input type="text" id="cert-user-name" placeholder="お名前・ニックネーム" maxlength="20" style="background: rgba(0,0,0,0.5); border: 1px solid var(--panel-border); color: #fff; padding: 6px 12px; border-radius: 3px; font-size: 13px; text-align: center; outline: none;">
                    </div>

                    <div style="display: flex; justify-content: space-around; border-top: 1px dashed rgba(0, 255, 102, 0.2); padding-top: 15px; font-family: var(--font-mono); font-size: 11px; color: var(--secondary-neon);">
                        <div>SERIAL: <span id="cert-serial-id">DP-MST-000000</span></div>
                        <div>DATE: <span id="cert-issue-date">2026.11.04</span></div>
                    </div>
                </div>

                <!-- Share to X (Twitter) -->
                <div style="text-align: center; margin-top: 18px;">
                    <a id="share-x-btn" href="#" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; background: #000; border: 1px solid rgba(255, 255, 255, 0.3); color: #fff; text-decoration: none; padding: 10px 24px; font-size: 13px; font-family: var(--font-mono); font-weight: bold; border-radius: 20px; transition: all 0.3s ease;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        <span>認定証をXでシェアする</span>
                    </a>
                </div>
            </div>

            <!-- Review Items -->
            <div class="review-section" style="margin-top: 35px; border-top: 1px solid var(--panel-border); padding-top: 25px;">
                <h4 style="font-family: var(--font-mono); color: var(--primary-neon); margin-bottom: 20px; font-size: 13px;">出題された恐竜・問題の復習 (図鑑へリンク)</h4>
                
                <div class="review-grid" id="result-review-box" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; margin-bottom: 30px;">
                    <!-- Review cards dynamically injected here -->
                </div>
            </div>

            <!-- Result Actions -->
            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <button id="retry-test-btn" class="action-btn" style="border-color: var(--secondary-neon); color: var(--secondary-neon); box-shadow: 0 0 10px rgba(0, 255, 102, 0.1);">
                    もう一度挑戦する
                </button>
                <button id="back-to-start-btn" class="action-btn" style="border-color: var(--primary-neon); color: var(--primary-neon); box-shadow: 0 0 10px rgba(0, 242, 255, 0.1);">
                    難易度・モード選択へ戻る
                </button>
                <a href="/dictionary/" class="nav-link" style="display: flex; align-items: center; justify-content: center; border: 1px solid var(--panel-border); background: var(--panel-bg); text-decoration: none; padding: 12px 25px; font-size: 14px; font-family: var(--font-mono); text-transform: uppercase; font-weight: 700; border-radius: 4px; transition: all 0.3s ease;">
                    [ 図鑑アーカイブへ ]
                </a>
            </div>
        </div>
    </div>

    <!-- Client-side Interactive Logic -->
    <script>
        const HIGH_SCORE_BASE_KEY = 'dino_portal_quiz_highscore';
        
        let quizState = {
            dinosaurs: [] as any[],
            top10Dinosaurs: [] as any[],
            beginnerQuestions: [] as any[],
            intermediateQuestions: [] as any[],
            advancedQuestions: [] as any[],
            masterQuestions: [] as any[],
            examQuestions: [] as any[],
            questions: [] as any[], // Active generated questions for this session
            currentStep: 0,
            score: 0,
            answersRecorded: [] as any[],
            selectedDifficulty: 'beginner', // 'beginner' | 'intermediate' | 'advanced' | 'master'
            selectedMode: 'aptitude', // 'aptitude' | 'exam'
            timerInterval: null as any,
            timerSecondsLeft: 20
        };

        function getHighScoreKey(difficulty: string, mode: string) {
            if (mode === 'exam') {
                return `dino_portal_exam_highscore_${difficulty}`;
            }
            return `${HIGH_SCORE_BASE_KEY}_${difficulty}`;
        }

        function updateDifficultyButtons() {
            const diffButtons = document.querySelectorAll('.diff-btn');
            const advancedHighScore = parseInt(localStorage.getItem('dino_portal_quiz_highscore_advanced') || '0');
            const isMasterUnlocked = advancedHighScore >= 80;
            const unlockNotice = document.getElementById('master-unlock-notice');

            diffButtons.forEach(btn => {
                const diff = btn.getAttribute('data-difficulty');
                const subText = btn.querySelector('.diff-subtext') || btn.querySelector('span');

                if (quizState.selectedMode === 'exam') {
                    if (diff === 'advanced' || diff === 'master') {
                        (btn as HTMLButtonElement).style.display = 'none';
                    } else {
                        (btn as HTMLButtonElement).style.display = 'flex';
                    }
                    if (unlockNotice) unlockNotice.style.display = 'none';
                } else {
                    (btn as HTMLButtonElement).style.display = 'flex';
                    if (unlockNotice) unlockNotice.style.display = 'block';

                    if (diff === 'advanced') {
                        btn.classList.remove('locked');
                        (btn as HTMLButtonElement).disabled = false;
                        if (subText) subText.innerText = 'ADVANCED';
                    } else if (diff === 'master') {
                        if (isMasterUnlocked) {
                            btn.classList.remove('locked');
                            (btn as HTMLButtonElement).disabled = false;
                            if (subText) {
                                subText.innerText = 'MASTER';
                                subText.style.color = 'var(--secondary-neon)';
                            }
                            if (unlockNotice) unlockNotice.innerHTML = '<span style="color: var(--secondary-neon);">★ 恐竜博士モード アンロック済み！全10問のタイムアタックに挑めます。</span>';
                        } else {
                            btn.classList.add('locked');
                            (btn as HTMLButtonElement).disabled = true;
                            if (subText) {
                                subText.innerText = '🔒 LOCKED';
                                subText.style.color = 'var(--text-dim)';
                            }
                            if (unlockNotice) unlockNotice.innerHTML = '※「恐竜博士」は上級で80%以上正解するとアンロックされます';
                        }
                    }
                }
            });
        }

        function initQuizProgram() {
            const bridge = document.getElementById('quiz-data-bridge');
            if (!bridge) return;

            // Load data from bridge
            quizState.dinosaurs = JSON.parse(bridge.getAttribute('data-dinosaurs') || '[]');
            quizState.top10Dinosaurs = JSON.parse(bridge.getAttribute('data-top10-dinosaurs') || '[]');
            quizState.beginnerQuestions = JSON.parse(bridge.getAttribute('data-beginner-questions') || '[]');
            quizState.intermediateQuestions = JSON.parse(bridge.getAttribute('data-intermediate-questions') || '[]');
            quizState.advancedQuestions = JSON.parse(bridge.getAttribute('data-advanced-questions') || '[]');
            quizState.masterQuestions = JSON.parse(bridge.getAttribute('data-master-questions') || '[]');
            quizState.examQuestions = JSON.parse(bridge.getAttribute('data-exam-questions') || '[]');

            // Bind start and retry buttons
            const startBtn = document.getElementById('start-test-btn');
            const retryBtn = document.getElementById('retry-test-btn');
            const backStartBtn = document.getElementById('back-to-start-btn');

            if (startBtn) startBtn.addEventListener('click', startTest);
            if (retryBtn) retryBtn.addEventListener('click', startTest);
            if (backStartBtn) {
                backStartBtn.addEventListener('click', () => {
                    document.getElementById('quiz-result-panel')!.style.display = 'none';
                    document.getElementById('quiz-main-panel')!.style.display = 'none';
                    document.getElementById('quiz-start-panel')!.style.display = 'block';
                    displayHighScore();
                    updateDifficultyButtons();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // Bind mode selector tabs
            const modeTabs = document.querySelectorAll('.mode-tab');
            const modeDesc = document.getElementById('mode-description-text');
            const diffButtons = document.querySelectorAll('.diff-btn');
            
            modeTabs.forEach(tab => {
                tab.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    modeTabs.forEach(t => {
                        t.classList.remove('active');
                        const titleEl = t.querySelector('div');
                        if (titleEl) titleEl.style.color = 'var(--text-main)';
                    });
                    
                    target.classList.add('active');
                    const activeTitle = target.querySelector('div');
                    if (activeTitle) activeTitle.style.color = 'var(--primary-neon)';
                    
                    const mode = target.getAttribute('data-mode') || 'aptitude';
                    quizState.selectedMode = mode;
                    
                    if (mode === 'exam') {
                        modeDesc!.innerHTML = `
                            恐竜学検定の仮想試験です。分類・生態・歴史・地質の4分野から出題されます。<br>
                            <strong>全10問の4択テスト</strong>を行い、<strong>正解率70%以上（7問以上正解）で合格</strong>となります。
                        `;
                        
                        if (quizState.selectedDifficulty === 'advanced' || quizState.selectedDifficulty === 'master') {
                            quizState.selectedDifficulty = 'intermediate';
                            diffButtons.forEach(btn => {
                                const diff = btn.getAttribute('data-difficulty');
                                if (diff === 'intermediate') btn.classList.add('active');
                                else btn.classList.remove('active');
                            });
                            const diffLabel = document.getElementById('difficulty-label-display');
                            if (diffLabel) diffLabel.innerText = '中級';
                        }
                    } else {
                        modeDesc!.innerHTML = `
                            美麗イラスト、シルエット、3大ヒント、骨格スキャン、最新学説から恐竜の謎を解き明かすクイズです。<br>
                            難易度を選んで挑戦してください。
                        `;
                    }
                    
                    updateDifficultyButtons();
                    displayHighScore();
                });
            });

            // Bind difficulty selector buttons
            diffButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const target = e.currentTarget as HTMLButtonElement;
                    if (target.classList.contains('locked')) return;
                    
                    diffButtons.forEach(b => b.classList.remove('active'));
                    target.classList.add('active');
                    
                    quizState.selectedDifficulty = target.getAttribute('data-difficulty') || 'beginner';
                    
                    const diffLabel = document.getElementById('difficulty-label-display');
                    if (diffLabel) {
                        diffLabel.innerText = target.firstChild ? target.firstChild.textContent!.trim() : '初級';
                    }
                    
                    displayHighScore();
                });
            });

            displayHighScore();
            updateDifficultyButtons();
        }

        function displayHighScore() {
            const hsSpan = document.getElementById('start-high-score');
            if (hsSpan) {
                const key = getHighScoreKey(quizState.selectedDifficulty, quizState.selectedMode);
                const hs = localStorage.getItem(key) || '0';
                hsSpan.innerText = `${hs}%`;
            }
        }

        // Fisher-Yates array shuffle
        function shuffleArray<T>(array: T[]): T[] {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        // Generate Quiz Session
        function startTest() {
            if (quizState.timerInterval) {
                clearInterval(quizState.timerInterval);
                quizState.timerInterval = null;
            }

            document.getElementById('quiz-start-panel')!.style.display = 'none';
            document.getElementById('quiz-result-panel')!.style.display = 'none';
            
            if (quizState.selectedMode === 'exam') {
                // Exam Mode: 10 random questions
                const filtered = quizState.examQuestions.filter((q: any) => q.level === quizState.selectedDifficulty);
                const questionsToUse = filtered.length > 0 ? filtered : quizState.examQuestions;
                const shuffled = shuffleArray(questionsToUse).slice(0, 10);
                
                quizState.questions = shuffled.map((q: any) => {
                    const correctText = q.choices[q.correctIndex];
                    const shuffledChoices = shuffleArray(q.choices);
                    const newCorrectIndex = shuffledChoices.indexOf(correctText);
                    return {
                        mode: 'exam',
                        questionObj: {
                            ...q,
                            choices: shuffledChoices,
                            correctIndex: newCorrectIndex
                        },
                        choices: shuffledChoices,
                        correctAnswer: correctText
                    };
                });
            } else {
                // Aptitude Mode (New Cyber Quiz)
                if (quizState.selectedDifficulty === 'beginner') {
                    // 初級: 10種から5種を重複なしで選択し、各恐竜について3パターン(visual, silhouette, hints)からランダム出題
                    const top10 = shuffleArray(quizState.top10Dinosaurs);
                    const selectedDinos = top10.slice(0, 5);
                    const modes: ('visual' | 'silhouette' | 'hints')[] = ['visual', 'silhouette', 'hints'];

                    quizState.questions = selectedDinos.map(dino => {
                        const chosenMode = modes[Math.floor(Math.random() * modes.length)];
                        const qItem = quizState.beginnerQuestions.find(
                            (q: any) => q.dinoId === dino.id && q.type === chosenMode
                        );
                        // 選択肢のシャッフル
                        const otherNames = quizState.top10Dinosaurs.filter((d: any) => d.id !== dino.id).map((d: any) => d.name);
                        const incorrectChoices = shuffleArray(otherNames).slice(0, 3);
                        const allChoices = shuffleArray([dino.name, ...incorrectChoices]);

                        return {
                            ...qItem,
                            choices: allChoices,
                            correctAnswer: dino.name
                        };
                    });
                } else if (quizState.selectedDifficulty === 'intermediate') {
                    // 中級: 恐竜重複なしで5問選出
                    const shuffledPool = shuffleArray(quizState.intermediateQuestions);
                    const selected: any[] = [];
                    const usedDinoIds = new Set<string>();

                    for (const q of shuffledPool) {
                        if (q.dinoId) {
                            if (!usedDinoIds.has(q.dinoId)) {
                                usedDinoIds.add(q.dinoId);
                                selected.push(q);
                            }
                        } else {
                            selected.push(q);
                        }
                        if (selected.length >= 5) break;
                    }

                    quizState.questions = selected.map(q => ({
                        ...q,
                        choices: shuffleArray(q.choices)
                    }));
                } else if (quizState.selectedDifficulty === 'advanced') {
                    // 上級: 骨格、ヒント、雑学、アカデミックから恐竜重複なしで5問選出
                    const shuffledPool = shuffleArray(quizState.advancedQuestions);
                    const selected: any[] = [];
                    const usedDinoIds = new Set<string>();

                    for (const q of shuffledPool) {
                        if (q.dinoId) {
                            if (!usedDinoIds.has(q.dinoId)) {
                                usedDinoIds.add(q.dinoId);
                                selected.push(q);
                            }
                        } else {
                            selected.push(q);
                        }
                        if (selected.length >= 5) break;
                    }

                    quizState.questions = selected.map(q => ({
                        ...q,
                        choices: shuffleArray(q.choices)
                    }));
                } else {
                    // 恐竜博士 (MASTER): 全10問、ヒント・雑学・アカデミックから厳選
                    const shuffledPool = shuffleArray(quizState.masterQuestions);
                    const selected = shuffledPool.slice(0, 10);

                    quizState.questions = selected.map(q => ({
                        ...q,
                        choices: shuffleArray(q.choices)
                    }));
                }
            }

            quizState.currentStep = 0;
            quizState.score = 0;
            quizState.answersRecorded = [];

            loadQuestion();
        }

        function loadQuestion() {
            if (quizState.timerInterval) {
                clearInterval(quizState.timerInterval);
                quizState.timerInterval = null;
            }

            const currentQ = quizState.questions[quizState.currentStep];
            const maxSteps = quizState.selectedMode === 'exam' || quizState.selectedDifficulty === 'master' ? 10 : 5;
            
            // UI Indicators
            const stepIndicator = document.querySelector('.quiz-step-indicator');
            const scoreIndicator = document.querySelector('.quiz-score-indicator');
            const categoryTag = document.getElementById('quiz-category-tag');
            
            if (stepIndicator) {
                const stepNum = quizState.currentStep + 1;
                const formattedStep = stepNum < 10 ? `0${stepNum}` : `${stepNum}`;
                const formattedMax = maxSteps < 10 ? `0${maxSteps}` : `${maxSteps}`;
                stepIndicator.innerHTML = `[ QUESTION: ${formattedStep} / ${formattedMax} ]`;
            }
            if (scoreIndicator) {
                scoreIndicator.innerHTML = `正解数: ${quizState.score}`;
            }
            if (categoryTag) {
                if (quizState.selectedMode === 'exam') {
                    categoryTag.innerText = `分野: ${currentQ.questionObj.category}`;
                } else if (currentQ.type === 'visual') {
                    categoryTag.innerText = 'FULL VISUAL';
                } else if (currentQ.type === 'silhouette') {
                    categoryTag.innerText = 'SILHOUETTE SCAN';
                } else if (currentQ.type === 'skeletal') {
                    categoryTag.innerText = 'SKELETAL SCAN';
                } else if (currentQ.type === 'hints') {
                    categoryTag.innerText = '3-HINTS TELEMETRY';
                } else if (currentQ.type === 'trivia') {
                    categoryTag.innerText = 'DINO TRIVIA';
                } else if (currentQ.type === 'academic') {
                    categoryTag.innerText = 'ACADEMIC SCIENCE';
                } else {
                    categoryTag.innerText = 'STANDARD';
                }
            }

            // Hide/Reset all visual containers
            const visualFrame = document.querySelector('.quiz-visual-frame') as HTMLElement;
            const visMain = document.getElementById('visual-main-container');
            const visSil = document.getElementById('visual-silhouette-container');
            const visSkl = document.getElementById('visual-skeletal-container');
            const visHnt = document.getElementById('visual-hints-container');
            const silReveal = document.getElementById('silhouette-reveal-image') as HTMLImageElement;
            const silImg = document.getElementById('silhouette-image') as HTMLImageElement;

            visMain!.style.display = 'none';
            visSil!.style.display = 'none';
            visSkl!.style.display = 'none';
            visHnt!.style.display = 'none';
            if (silReveal) silReveal.style.opacity = '0';
            if (silImg) silImg.style.opacity = '1';

            document.getElementById('answer-explanation-panel')!.style.display = 'none';

            // Master Timer Handling
            const timerContainer = document.getElementById('quiz-timer-container');
            const timerFill = document.getElementById('quiz-timer-fill');
            const timerText = document.getElementById('quiz-timer-text');

            if (quizState.selectedMode === 'aptitude' && quizState.selectedDifficulty === 'master') {
                timerContainer!.style.display = 'block';
                quizState.timerSecondsLeft = 30;
                timerText!.innerText = '30s';
                timerFill!.style.width = '100%';

                const startTime = Date.now();
                const totalDuration = 30000;

                quizState.timerInterval = setInterval(() => {
                    const elapsed = Date.now() - startTime;
                    const remaining = Math.max(0, totalDuration - elapsed);
                    const pct = (remaining / totalDuration) * 100;
                    const secs = Math.ceil(remaining / 1000);

                    timerFill!.style.width = `${pct}%`;
                    timerText!.innerText = `${secs}s`;

                    if (remaining <= 0) {
                        clearInterval(quizState.timerInterval);
                        quizState.timerInterval = null;
                        handleTimeOut();
                    }
                }, 100);
            } else {
                timerContainer!.style.display = 'none';
            }

            // Render Prompt and Layout
            const promptText = document.getElementById('question-prompt-text');
            const leftArea = document.querySelector('.quiz-question-visual-area') as HTMLElement;
            const rightArea = document.querySelector('.quiz-answers-area') as HTMLElement;
            const contentLayout = document.querySelector('.quiz-content-layout') as HTMLElement;

            if (currentQ.type === 'hints') {
                // 3大ヒント問題：全幅レイアウトでヒントを折り返さずスッキリ表示！
                promptText!.innerText = currentQ.question;
                visualFrame.style.display = 'block';
                visualFrame.style.aspectRatio = 'auto';
                visualFrame.style.background = 'transparent';
                visualFrame.style.border = 'none';

                leftArea.style.display = 'block';
                leftArea.style.flex = 'none';
                leftArea.style.width = '100%';

                rightArea.style.flex = 'none';
                rightArea.style.width = '100%';
                rightArea.style.maxWidth = '';
                rightArea.style.margin = '10px 0 0 0';
                contentLayout.style.flexDirection = 'column';

                visHnt!.style.display = 'flex';
                document.getElementById('hint-text-1')!.innerText = currentQ.hints[0];
                document.getElementById('hint-text-2')!.innerText = currentQ.hints[1];
                document.getElementById('hint-text-3')!.innerText = currentQ.hints[2];
            } else if (quizState.selectedMode === 'exam' || currentQ.type === 'trivia' || currentQ.type === 'academic') {
                // テキスト・雑学・アカデミック問題
                const qText = quizState.selectedMode === 'exam' ? currentQ.questionObj.question : currentQ.question;
                promptText!.innerText = qText;
                visualFrame.style.display = 'none';
                leftArea.style.display = 'none';
                rightArea.style.flex = 'none';
                rightArea.style.width = '100%';
                rightArea.style.maxWidth = '850px';
                rightArea.style.margin = '0 auto';
                contentLayout.style.flexDirection = 'column';
            } else {
                // 画像問題 (visual, silhouette, skeletal)
                visualFrame.style.display = 'flex';
                visualFrame.style.aspectRatio = '16 / 9';
                visualFrame.style.background = '#000';
                visualFrame.style.border = '1px solid var(--panel-border)';

                leftArea.style.display = 'block';
                leftArea.style.flex = '1.2';
                leftArea.style.width = '';
                rightArea.style.flex = '1';
                rightArea.style.width = '';
                rightArea.style.maxWidth = '';
                rightArea.style.margin = '0';
                contentLayout.style.flexDirection = 'row';

                promptText!.innerText = currentQ.question;

                if (currentQ.type === 'visual') {
                    visMain!.style.display = 'flex';
                    const mainImg = document.getElementById('main-art-image') as HTMLImageElement;
                    mainImg.src = `/images/${currentQ.dinoId}.webp`;
                } else if (currentQ.type === 'silhouette') {
                    visSil!.style.display = 'flex';
                    silImg.src = `/images/silhouette/${currentQ.dinoId}.webp`;
                    silReveal.src = `/images/${currentQ.dinoId}.webp`;
                } else if (currentQ.type === 'skeletal') {
                    visSkl!.style.display = 'flex';
                    const sklImg = document.getElementById('skeletal-image') as HTMLImageElement;
                    sklImg.src = `/images/cyber/${currentQ.dinoId}.webp`;
                }
            }

            // Populate Choices
            const choicesBox = document.getElementById('quiz-choices-box');
            choicesBox!.innerHTML = '';

            currentQ.choices.forEach((choiceText: string, index: number) => {
                const btn = document.createElement('button');
                btn.className = 'nav-link';
                btn.style.width = '100%';
                btn.style.textAlign = 'left';
                btn.style.padding = '12px 18px';
                btn.style.fontSize = '14px';
                btn.style.background = 'var(--panel-bg)';
                btn.style.border = '1px solid var(--panel-border)';
                btn.style.display = 'flex';
                btn.style.justifyContent = 'space-between';
                btn.style.alignItems = 'center';
                btn.style.cursor = 'pointer';
                btn.style.borderRadius = '4px';
                btn.style.transition = 'all 0.2s ease';
                
                btn.innerHTML = `
                    <span style="font-family: sans-serif; font-weight: 500;">[ 0${index + 1} ] &nbsp; ${choiceText}</span>
                    <span class="choice-indicator" style="font-family: var(--font-mono); color: var(--primary-neon); font-size: 11px;"></span>
                `;
                
                btn.addEventListener('click', () => submitAnswer(choiceText, btn));
                choicesBox!.appendChild(btn);
            });

            document.getElementById('quiz-main-panel')!.style.display = 'block';
        }

        // Handle Master Mode Timeout
        function handleTimeOut() {
            const choicesBox = document.getElementById('quiz-choices-box');
            const buttons = Array.from(choicesBox!.getElementsByTagName('button'));
            buttons.forEach(btn => btn.disabled = true);
            
            submitAnswer("__TIMEOUT__", null);
        }

        function submitAnswer(chosenText: string, clickedBtn: HTMLElement | null) {
            if (quizState.timerInterval) {
                clearInterval(quizState.timerInterval);
                quizState.timerInterval = null;
            }

            const currentQ = quizState.questions[quizState.currentStep];
            const isTimeout = chosenText === "__TIMEOUT__";
            const isCorrect = !isTimeout && chosenText === currentQ.correctAnswer;

            if (isCorrect) {
                quizState.score++;
            }

            // Record answer for review
            quizState.answersRecorded.push({
                questionObj: currentQ,
                chosenText: isTimeout ? '時間切れ (TIMEOUT)' : chosenText,
                correctAnswer: currentQ.correctAnswer,
                isCorrect: isCorrect,
                dinoId: currentQ.dinoId
            });

            // If silhouette mode, trigger reveal animation!
            if (currentQ.type === 'silhouette') {
                const silReveal = document.getElementById('silhouette-reveal-image') as HTMLImageElement;
                const silImg = document.getElementById('silhouette-image') as HTMLImageElement;
                if (silReveal) silReveal.style.opacity = '1';
                if (silImg) silImg.style.opacity = '0.1';
            }

            // Style buttons
            const choicesBox = document.getElementById('quiz-choices-box');
            const buttons = Array.from(choicesBox!.getElementsByTagName('button'));

            buttons.forEach((btn: any) => {
                btn.disabled = true;
                const btnText = btn.innerText;
                const indicator = btn.querySelector('.choice-indicator');

                if (btnText.includes(currentQ.correctAnswer)) {
                    btn.style.borderColor = 'var(--secondary-neon)';
                    btn.style.background = 'rgba(0, 255, 102, 0.08)';
                    if (indicator) {
                        indicator.innerText = '正解 (CORRECT)';
                        indicator.style.color = 'var(--secondary-neon)';
                    }
                } else if (!isTimeout && btnText.includes(chosenText) && !isCorrect) {
                    btn.style.borderColor = 'var(--alert-neon)';
                    btn.style.background = 'rgba(255, 0, 90, 0.08)';
                    if (indicator) {
                        indicator.innerText = '不正解 (WRONG)';
                        indicator.style.color = 'var(--alert-neon)';
                    }
                } else {
                    btn.style.opacity = '0.45';
                    if (indicator) {
                        indicator.innerText = '----';
                        indicator.style.color = 'var(--text-dim)';
                    }
                }
            });

            // Show explanation panel
            const expPanel = document.getElementById('answer-explanation-panel');
            const correctnessInd = document.getElementById('correctness-indicator');
            const expDetail = document.getElementById('explanation-detail-text');
            const nextBtn = document.getElementById('next-question-btn');
            const dictLinkContainer = document.getElementById('dictionary-link-container');
            const dictBtn = document.getElementById('dino-dictionary-btn') as HTMLAnchorElement;
            const dictBtnLabel = document.getElementById('dict-btn-label');
            const otherNotesBox = document.getElementById('other-choices-notes');
            const otherNotesList = document.getElementById('other-choices-list');

            if (isTimeout) {
                correctnessInd!.innerText = "▼ 時間切れ (TIME OUT)";
                correctnessInd!.style.color = "var(--alert-neon)";
            } else if (isCorrect) {
                correctnessInd!.innerText = "▲ 正解 (CORRECT)";
                correctnessInd!.style.color = "var(--secondary-neon)";
            } else {
                correctnessInd!.innerText = "▼ 不正解 (WRONG)";
                correctnessInd!.style.color = "var(--alert-neon)";
            }

            // Explanation Text
            if (quizState.selectedMode === 'exam') {
                const q = currentQ.questionObj;
                expDetail!.innerHTML = `
                    <div style="margin-bottom: 6px;"><strong>正解: ${q.choices[q.correctIndex]}</strong></div>
                    <p style="margin: 0; color: var(--text-dim);">${q.explanation}</p>
                `;
                dictLinkContainer!.style.display = 'none';
                otherNotesBox!.style.display = 'none';
            } else {
                expDetail!.innerHTML = `
                    <div style="font-weight: bold; color: var(--primary-neon); margin-bottom: 6px;">正解: ${currentQ.correctAnswer}</div>
                    <p style="margin: 0; color: var(--text-dim);">${currentQ.explanation}</p>
                `;

                // Dictionary link button if dinoId exists
                if (currentQ.dinoId) {
                    dictLinkContainer!.style.display = 'block';
                    dictBtn.href = `/dictionary/${currentQ.dinoId}/`;
                    dictBtnLabel!.innerText = `${currentQ.correctAnswer} の図鑑データを見る >`;
                } else {
                    dictLinkContainer!.style.display = 'none';
                }

                // Render Other Choices Notes (Hybrid Smart Notes)
                if (currentQ.choiceNotes) {
                    otherNotesList!.innerHTML = '';
                    let hasOtherNotes = false;

                    Object.keys(currentQ.choiceNotes).forEach((name: string) => {
                        if (name !== currentQ.correctAnswer && currentQ.choices.includes(name)) {
                            hasOtherNotes = true;
                            const noteLine = document.createElement('div');
                            noteLine.style.background = 'rgba(255, 255, 255, 0.02)';
                            noteLine.style.border = '1px solid rgba(255, 255, 255, 0.05)';
                            noteLine.style.padding = '8px 12px';
                            noteLine.style.borderRadius = '3px';
                            noteLine.innerHTML = `<strong style="color: var(--primary-neon);">&bull; ${name}:</strong> ${currentQ.choiceNotes[name]}`;
                            otherNotesList!.appendChild(noteLine);
                        }
                    });

                    otherNotesBox!.style.display = hasOtherNotes ? 'block' : 'none';
                } else {
                    otherNotesBox!.style.display = 'none';
                }
            }

            const maxSteps = quizState.selectedMode === 'exam' || quizState.selectedDifficulty === 'master' ? 10 : 5;
            if (quizState.currentStep < maxSteps - 1) {
                nextBtn!.innerText = "次の問題へ >";
            } else {
                nextBtn!.innerText = "テスト結果へ >";
            }

            // Bind next question action
            const newNextBtn = nextBtn!.cloneNode(true) as HTMLButtonElement;
            nextBtn!.parentNode!.replaceChild(newNextBtn, nextBtn!);
            newNextBtn.addEventListener('click', proceedToNext);

            expPanel!.style.display = 'block';
            expPanel!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function proceedToNext() {
            quizState.currentStep++;
            const maxSteps = quizState.selectedMode === 'exam' || quizState.selectedDifficulty === 'master' ? 10 : 5;
            
            if (quizState.currentStep < maxSteps) {
                showScanningScreen(() => {
                    loadQuestion();
                });
            } else {
                showScanningScreen(() => {
                    showResults();
                });
            }
        }

        function showScanningScreen(callback: () => void) {
            document.getElementById('quiz-main-panel')!.style.display = 'none';
            
            const loadingPanel = document.getElementById('quiz-scan-loading');
            const progressBar = document.getElementById('scan-progress-fill');
            
            loadingPanel!.style.display = 'block';
            progressBar!.style.width = '0%';
            
            let val = 0;
            const interval = setInterval(() => {
                val += 20;
                if (progressBar) progressBar.style.width = `${Math.min(100, val)}%`;
                
                if (val >= 100) {
                    clearInterval(interval);
                    setTimeout(() => {
                        loadingPanel!.style.display = 'none';
                        callback();
                    }, 150);
                }
            }, 60);
        }

        function showResults() {
            const maxSteps = quizState.selectedMode === 'exam' || quizState.selectedDifficulty === 'master' ? 10 : 5;
            const finalScorePercent = Math.round((quizState.score / maxSteps) * 100);
            
            // Record High Score in localStorage per difficulty
            const hsKey = getHighScoreKey(quizState.selectedDifficulty, quizState.selectedMode);
            const previousHighScore = parseInt(localStorage.getItem(hsKey) || '0');
            let isNewHighScore = false;
            
            if (finalScorePercent > previousHighScore) {
                localStorage.setItem(hsKey, finalScorePercent.toString());
                isNewHighScore = true;
                displayHighScore();
                updateDifficultyButtons();
            }

            // Circle SVG score animation
            const meterCircle = document.getElementById('sync-meter-circle');
            const scoreText = document.getElementById('result-score-percent');
            
            if (meterCircle) {
                const circumference = 440;
                const offset = circumference - (circumference * finalScorePercent) / 100;
                meterCircle.style.strokeDashoffset = offset.toString();
            }
            if (scoreText) {
                scoreText.innerText = `${finalScorePercent}%`;
            }

            const hsAlert = document.getElementById('high-score-announcement');
            hsAlert!.style.display = (isNewHighScore && finalScorePercent > 0) ? 'block' : 'none';

            const rankBadge = document.getElementById('result-rank-badge');
            const rankDesc = document.getElementById('result-rank-desc');
            const certArea = document.getElementById('master-certificate-area');
            const isExam = quizState.selectedMode === 'exam';

            certArea!.style.display = 'none';

            if (isExam) {
                const isPass = finalScorePercent >= 70;
                const resultTitle = document.querySelector('.result-title');
                if (resultTitle) {
                    resultTitle.innerHTML = isPass 
                        ? `<span style="color: var(--secondary-neon); font-weight: bold; border: 1px solid var(--secondary-neon); padding: 2px 8px; border-radius: 3px;">★ PASS (合格) ★</span>`
                        : `<span style="color: var(--alert-neon); font-weight: bold; border: 1px solid var(--alert-neon); padding: 2px 8px; border-radius: 3px;">▲ FAIL (不合格) ▲</span>`;
                }

                if (isPass) {
                    rankBadge!.innerText = `【合格】恐竜学検定 ${quizState.selectedDifficulty === 'beginner' ? '初級' : '中級'} 模擬試験`;
                    rankBadge!.style.color = "var(--secondary-neon)";
                    rankDesc!.innerHTML = `合格おめでとうございます！基準（70%以上）をクリアしました。実際の検定本番でも実力を発揮できる素晴らしい知識量です。`;
                } else {
                    rankBadge!.innerText = `【不合格】恐竜学検定 ${quizState.selectedDifficulty === 'beginner' ? '初級' : '中級'} 模擬試験`;
                    rankBadge!.style.color = "var(--alert-neon)";
                    rankDesc!.innerHTML = `合格ラインである正解率70%（10問中7問正解）に届きませんでした。復習レポートを確認してリベンジしましょう。`;
                }
            } else if (quizState.selectedDifficulty === 'master') {
                // Master Mode Results
                if (finalScorePercent >= 80) {
                    certArea!.style.display = 'block';
                    const isPerfect = finalScorePercent === 100;
                    const certRank = document.getElementById('cert-rank-title');
                    const certSerial = document.getElementById('cert-serial-id');
                    const certDate = document.getElementById('cert-issue-date');
                    const userNameInput = document.getElementById('cert-user-name') as HTMLInputElement;
                    const shareXBtn = document.getElementById('share-x-btn') as HTMLAnchorElement;

                    const rankStr = isPerfect ? "S級・主席 恐竜博士" : "A級・公認 恐竜博士";
                    certRank!.innerText = `[ ${rankStr} ]`;
                    certRank!.style.color = isPerfect ? "var(--secondary-neon)" : "var(--primary-neon)";

                    const serial = `DP-MST-${Date.now().toString().slice(-6)}`;
                    certSerial!.innerText = serial;

                    const now = new Date();
                    const dateStr = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`;
                    certDate!.innerText = dateStr;

                    // Save Master achievement
                    localStorage.setItem('dino_portal_master_certified', rankStr);

                    // Setup X Share Link
                    const updateShareUrl = () => {
                        const name = userNameInput.value.trim() || '恐竜ファン';
                        const text = `恐竜ポータルの最高難易度【恐竜博士認定試験】に合格し、『${rankStr}』に認定されました！\n正解率: ${finalScorePercent}% (10問中${quizState.score}問正解)\nシリアル番号: ${serial}\n#DinoPortal #恐竜クイズ #恐竜博士`;
                        const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(window.location.origin + '/quiz/')}`;
                        shareXBtn.href = shareUrl;
                    };

                    updateShareUrl();
                    userNameInput.addEventListener('input', updateShareUrl);

                    rankBadge!.innerText = `【認定】${rankStr} 誕生！`;
                    rankBadge!.style.color = isPerfect ? "var(--secondary-neon)" : "var(--primary-neon)";
                    rankDesc!.innerHTML = `難攻不落の博士モード（10問・20秒タイムアタック）を見事に突破しました！下記の認定デジタル証を発行します。`;
                } else {
                    rankBadge!.innerText = "【認定ならず】再挑戦をお待ちしています";
                    rankBadge!.style.color = "var(--alert-neon)";
                    rankDesc!.innerHTML = `恐竜博士認定には正解率80%以上（10問中8問以上正解）が必要です。復習レビューを確認し、次こそは博士の栄冠を勝ち取りましょう！`;
                }
            } else {
                // Beginner / Intermediate / Advanced Results
                const isAdvancedUnlock = quizState.selectedDifficulty === 'advanced' && finalScorePercent >= 80;
                
                if (finalScorePercent === 100) {
                    rankBadge!.innerText = "Sランク: 恐竜マスター (全問正解！)";
                    rankBadge!.style.color = "var(--secondary-neon)";
                    let descHtml = "素晴らしい知識量です！全問正解おめでとうございます。";
                    if (isAdvancedUnlock && previousHighScore < 80) {
                        descHtml += `
                            <div style="margin-top: 15px; padding: 14px; border: 2px solid var(--secondary-neon); background: rgba(0, 255, 102, 0.08); color: var(--secondary-neon); font-family: var(--font-mono); font-size: 13px; border-radius: 4px; text-align: center; box-shadow: 0 0 15px rgba(0, 255, 102, 0.2); animation: glitch 0.5s ease-in-out;">
                                ★【SYSTEM UNLOCK】最高難易度「恐竜博士 (MASTER)」への挑戦権が解放されました！
                            </div>
                        `;
                    }
                    rankDesc!.innerHTML = descHtml;
                } else if (finalScorePercent >= 80) {
                    rankBadge!.innerText = "Aランク: 恐竜ファン上級 (優秀！)";
                    rankBadge!.style.color = "var(--primary-neon)";
                    let descHtml = "非常に優秀な成績です！あと一歩で満点でした。";
                    if (isAdvancedUnlock && previousHighScore < 80) {
                        descHtml += `
                            <div style="margin-top: 15px; padding: 14px; border: 2px solid var(--secondary-neon); background: rgba(0, 255, 102, 0.08); color: var(--secondary-neon); font-family: var(--font-mono); font-size: 13px; border-radius: 4px; text-align: center; box-shadow: 0 0 15px rgba(0, 255, 102, 0.2); animation: glitch 0.5s ease-in-out;">
                                ★【SYSTEM UNLOCK】最高難易度「恐竜博士 (MASTER)」への挑戦権が解放されました！
                            </div>
                        `;
                    }
                    rankDesc!.innerHTML = descHtml;
                } else if (finalScorePercent >= 60) {
                    rankBadge!.innerText = "Bランク: 恐竜ファン級 (普通)";
                    rankBadge!.style.color = "var(--text-main)";
                    rankDesc!.innerHTML = "恐竜の知識をしっかり持っていますね。図鑑を学習すれば、さらに高得点が狙えます！";
                } else {
                    rankBadge!.innerText = "Cランク: 恐竜見習い級 (もっと学ぼう)";
                    rankBadge!.style.color = "var(--alert-neon)";
                    rankDesc!.innerHTML = "少し難しかったかもしれません。図鑑アーカイブや3Dスキャンで恐竜の特徴をチェックして再挑戦してみましょう！";
                }
            }

            // Render Review Cards
            const reviewBox = document.getElementById('result-review-box');
            reviewBox!.innerHTML = '';

            quizState.answersRecorded.forEach((record: any, index: number) => {
                const card = document.createElement(record.dinoId ? 'a' : 'div');
                if (record.dinoId) {
                    (card as HTMLAnchorElement).href = `/dictionary/${record.dinoId}/`;
                }
                card.style.textDecoration = 'none';
                card.style.color = 'inherit';
                
                const borderColor = record.isCorrect ? 'var(--secondary-neon)' : 'var(--alert-neon)';
                const badgeText = record.isCorrect ? '正解' : '不正解';
                const badgeColor = record.isCorrect ? 'var(--secondary-neon)' : 'var(--alert-neon)';

                const imgHtml = record.dinoId 
                    ? `<div class="related-img-wrap" style="width: 100%; aspect-ratio: 16 / 9; overflow: hidden; position: relative; background: #000;">
                         <img src="/images/${record.dinoId}.webp" alt="${record.correctAnswer}" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: contain;">
                         <span style="position: absolute; top: 5px; right: 5px; font-family: var(--font-mono); font-size: 8px; background: rgba(0,0,0,0.85); color: ${badgeColor}; border: 1px solid ${badgeColor}; padding: 1px 4px; border-radius: 2px;">
                             ${badgeText}
                         </span>
                       </div>`
                    : `<div style="width: 100%; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; background: rgba(0, 242, 255, 0.05); font-size: 24px;">
                         💡
                       </div>`;

                card.innerHTML = `
                    <div class="related-card hud-panel" style="cursor: pointer; height: 100%; border-color: ${borderColor}; padding: 8px;">
                        ${imgHtml}
                        <h4 style="font-size: 12px; margin: 8px 0 4px 0; color: var(--text-main); font-weight: bold;">
                            Q${index + 1}: ${record.correctAnswer}
                        </h4>
                        <div style="font-size: 10px; color: var(--text-dim); line-height: 1.4;">
                            回答: <span style="color: ${record.isCorrect ? 'var(--secondary-neon)' : 'var(--alert-neon)'};">${record.chosenText}</span>
                        </div>
                    </div>
                `;
                
                reviewBox!.appendChild(card);
            });

            document.getElementById('quiz-result-panel')!.style.display = 'block';
        }

        document.addEventListener('astro:page-load', initQuizProgram);
    </script>
</Layout>

<style>
