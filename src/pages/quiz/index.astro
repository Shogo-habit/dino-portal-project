    }
    .panel-icon {
        font-size: 48px;
        color: var(--primary-neon);
        margin-bottom: 20px;
        text-shadow: 0 0 15px rgba(0, 242, 255, 0.4);
    }
    .start-panel h3 {
        font-size: 24px;
        margin-bottom: 15px;
        letter-spacing: 2px;
        color: var(--text-main);
    }
    .action-btn {
        background: rgba(0, 242, 255, 0.08);
        border: 1px solid var(--primary-neon);
        color: var(--primary-neon);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 15px;
        padding: 12px 36px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 2px;
        border-radius: 4px;
        box-shadow: 0 0 15px rgba(0, 242, 255, 0.15);
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .action-btn:hover {
        background: var(--primary-neon);
        color: #000;
        box-shadow: 0 0 25px var(--primary-neon);
    }
    .quiz-panel {
        padding: 30px;
    }
    @keyframes quiz-beam {
        0% { top: -100%; }
        100% { top: 100%; }
    }
    
    /* 難易度選択ボタン */
    .diff-btn {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--panel-border);
        color: var(--text-dim);
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
