---
import Layout from '../../layouts/Layout.astro';
import PillarNav from '../../components/PillarNav.astro';
import { getCollection } from 'astro:content';

const allDinosaurs = await getCollection('dinosaurs');
// 白亜紀の恐竜・古生物を動的抽出
const cretaceousDinosaurs = allDinosaurs
  .filter(entry => entry.data.era.includes('白亜'))
  .map(entry => entry.data);

// 50音順にデフォルトソート
cretaceousDinosaurs.sort((a, b) => a.kana.localeCompare(b.kana, 'ja'));

// パンくずリスト & 構造化データ (Schema.org)
const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://dino-portal.com/" },
  { "@type": "ListItem", "position": 2, "name": "恐竜図鑑", "item": "https://dino-portal.com/dictionary/" },
  { "@type": "ListItem", "position": 3, "name": "白亜紀の恐竜完全ガイド", "item": "https://dino-portal.com/period/cretaceous/" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "白亜紀の恐竜完全ガイド - 多様性の頂点とK-Pg大量絶滅",
    "description": "白亜紀（約1億4500万年前〜6600万年前）を徹底網羅。ティラノサウルス、トリケラトプス、スピノサウルス等の生態と特徴、羽毛恐竜の開花、小惑星衝突による絶滅の真相。",
    "url": "https://dino-portal.com/period/cretaceous/",
    "hasPart": cretaceousDinosaurs.map(d => ({
      "@type": "Thing",
      "name": d.name,
      "url": `https://dino-portal.com/dictionary/${d.id}/`,
      "description": d.description
    }))
  }
];
---

<Layout 
  title="白亜紀の恐竜完全ガイド - 多様性の頂点とK-Pg大量絶滅 | Dino-Portal" 
  description="約1億4500万年〜6600万年前の白亜紀を徹底網羅。ティラノサウルス、トリケラトプス、スピノサウルス等の生態と特徴、被子植物の出現による生態系の劇変、羽毛恐竜の爆発的多様化、そして小惑星衝突によるK-Pg絶滅の全真相。"
  activeTab="dictionary"
  schema={schema}
>
  <div class="pillar-container" style="max-width: 1400px; margin: 0 auto; padding: 20px 20px 80px;">
    
    <!-- Breadcrumb bar -->
    <nav aria-label="パンくずリスト" style="margin-bottom: 25px; font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <a href="/" style="color: var(--primary-neon); text-decoration: none;">HOME</a>
      <span>/</span>
      <a href="/dictionary/" style="color: var(--primary-neon); text-decoration: none;">DICTIONARY</a>
      <span>/</span>
      <span style="color: var(--text-main);">PERIOD: CRETACEOUS</span>
    </nav>

    <!-- Hero Banner Header -->
    <header class="pillar-hero hud-panel" style="padding: 40px; margin-bottom: 40px; position: relative; overflow: hidden; border-color: rgba(255, 0, 85, 0.4); background: linear-gradient(135deg, rgba(255, 0, 85, 0.08) 0%, rgba(3, 6, 8, 0.8) 100%);">
      <div class="hero-tag" style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: rgba(255, 0, 85, 0.15); border: 1px solid var(--alert-neon); border-radius: 2px; font-family: var(--font-mono); font-size: 11px; color: var(--alert-neon); margin-bottom: 15px; letter-spacing: 1.5px;">
        <span>// GEOLOGICAL ERA ARCHIVE</span>
        <span>|</span>
        <span>145.0 MA – 66.0 MA</span>
      </div>
      
      <h1 style="font-size: clamp(26px, 4vw, 42px); font-weight: 800; color: var(--text-main); line-height: 1.3; margin-bottom: 15px; letter-spacing: -0.5px;">
        白亜紀の恐竜完全ガイド<br>
        <span style="font-size: clamp(16px, 2.5vw, 24px); color: var(--alert-neon); font-weight: 600;">生物多様性の極致とK-Pg大量絶滅</span>
      </h1>

      <p style="font-size: 15px; line-height: 1.8; color: var(--text-dim); max-width: 900px; margin-bottom: 25px;">
        中生代最後の時代である白亜紀は、恐竜進化の頂点（クライマックス）であり、現代の地球環境の礎が築かれた時代です。大陸分裂が生んだ孤立環境によって角竜、鎧竜、ハドロサウルス類、羽毛恐竜が爆発的な多様化を遂げ、ティラノサウルスやスピノサウルスといった究極の大型獣脚類が君臨しました。そして約6600万年前、巨大小惑星の衝突によって迎えた壮絶な終焉。白亜紀7,900万年の進化史を網羅します。
      </p>

      <div class="hero-stats" style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center; border-top: 1px solid rgba(255, 0, 85, 0.2); padding-top: 20px;">
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">REGISTERED SPECIMENS</span>
          <span style="font-size: 24px; font-weight: 700; color: var(--alert-neon);">{cretaceousDinosaurs.length} <span style="font-size: 14px; color: var(--text-dim);">種掲載中</span></span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 0, 85, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">TIME SPAN</span>
          <span style="font-size: 18px; font-weight: 600; color: var(--text-main);">約7,900万年間</span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 0, 85, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">KEY MILESTONES</span>
          <span style="font-size: 14px; font-weight: 600; color: var(--text-main);">被子植物の開花 / 羽毛の進化 / K-Pg小惑星衝突</span>
        </div>
      </div>
    </header>

    <!-- Academic Guide Article Section -->
    <article class="academic-guide hud-panel" style="padding: 40px; margin-bottom: 50px; background: rgba(3, 6, 8, 0.6); border-color: rgba(255, 0, 85, 0.25);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px; border-bottom: 2px solid var(--alert-neon); padding-bottom: 15px;">
        <span style="font-size: 24px;">🌋</span>
        <h2 style="font-size: 22px; color: var(--alert-neon); font-weight: 700; margin: 0; letter-spacing: 0.5px;">
          白亜紀の古生物学：群雄割拠の進化、被子植物革命、そして終焉のメカニズム
        </h2>
      </div>

      <div class="article-content" style="color: var(--text-main); font-size: 15px; line-height: 1.9;">
        
        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid var(--alert-neon); padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            1. 大陸分裂と「被子植物革命」が生んだ生態系の多様性爆発
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            白亜紀（Cretaceous Period）に入ると、パンゲア大陸の解体はさらに加速し、大西洋が大きく開き、北米大陸、ユーラシア大陸、南米大陸、アフリカ大陸、インド亜大陸、南極・豪州大陸が海によって隔絶されました。地理的な孤立は「地域固有の進化（適応放散）」を促し、各地域で独自の恐竜相が爆発的に発達しました。
          </p>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            また、白亜紀前期に誕生した<strong style="color: var(--text-main); font-weight: 700;">被子植物（顕花植物：花を咲かせ果実をつける植物）</strong>は、昆虫との共進化を通じて瞬く間に地球全土へ拡大しました。成長が早く栄養価の高い被子植物の台頭は、恐竜たちの咀嚼装置や消化器系に根本的な進化圧（セレクション）をもたらしたのです。
          </p>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid var(--alert-neon); padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            2. 角竜・鎧竜・カモノハシ竜：武装と「デンタルバッテリー」の奇跡
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            白亜紀の植物食恐竜は、捕食者に対する防御武装と摂食効率の両面で驚くべき進化を遂げました。
          </p>
          
          <div style="background: rgba(255, 0, 85, 0.04); border-left: 3px solid var(--alert-neon); padding: 15px 20px; margin: 15px 0; border-radius: 0 4px 4px 0;">
            <h4 style="font-size: 14px; color: var(--alert-neon); margin-bottom: 8px; font-weight: 700;">🛡 白亜紀植物食恐竜の三大進化戦略</h4>
            <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--text-dim); line-height: 1.7;">
              <li><strong>角竜下目（Ceratopsia）:</strong> トリケラトプスやカスモサウルス。頸部を防御し強大な顎筋の付着点となった骨質フリル、鋭い角、ハサミのように硬い植物を切り刻む強靭な嘴と歯列。</li>
              <li><strong>曲竜下目（Ankylosauria）:</strong> アンキロサウルスやノドサウルス。背中全面を覆う骨質装甲板（皮骨板）とトゲ、尾端の骨塊ハンマーによる絶対防御。</li>
              <li><strong>ハドロサウルス科（Hadrosauridae）:</strong> エドモントサウルスやパラサウロロフス。数百本から千本以上の歯が幾重にも重なり合う「デンタルバッテリー構造」により、あらゆる植物をすり潰す極限の咀嚼能力を獲得。頭部の空洞トサカによる発声コミュニケーション。</li>
            </ul>
          </div>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid var(--alert-neon); padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            3. 超大型肉食恐竜の群雄割拠と羽毛恐竜の開花
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            白亜紀は肉食恐竜（獣脚類）の進化においても頂点を極めました。北米の頂点捕食者<strong style="color: var(--text-main); font-weight: 700;">ティラノサウルス・レックス</strong>は、約3〜6トンという生物史上屈指の咬合力を誇り、太いバナナ型の歯で獲物の骨ごと粉砕して捕食しました。一方、北アフリカの湿地帯には全長14mを超える半水生プレデター<strong style="color: var(--text-main); font-weight: 700;">スピノサウルス</strong>が君臨し、南米では肉裂き特化の巨刃を持つ<strong style="color: var(--text-main); font-weight: 700;">ギガノトサウルス</strong>や<strong style="color: var(--text-main); font-weight: 700;">ティラノティタン</strong>が繁栄しました。
          </p>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            さらに中国・遼寧省の熱河生物群（Jehol Biota）などから発見された無数の羽毛恐竜化石（シノサウロプテリクス、ミクロラプトル、デイノニクス等）は、羽毛が飛行以前に「体温保持（恒温性）」や「ディスプレイ」として進化し、小型獣脚類の一部が現代の鳥類へと直結する系統樹を確立したことを決定づけました。
          </p>
        </section>

        <section>
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid var(--alert-neon); padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            4. K-Pg境界の破局：小惑星衝突と恐竜絶滅の真相
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            約6,600万年前、白亜紀末期（マーストリヒチアン期末）。現在のメキシコ・ユカタン半島付近に、直径約10〜15キロメートルの巨大小惑星が衝突しました（チクシュルーブ衝突体）。衝突エネルギーは広島型原爆の数十億倍に達し、世界規模の大津波、マグニチュード11以上の超巨大地震、そして舞い上がった岩石蒸気が地球全土へ降り注ぐ「赤外線放射パルス」によって全地球的な大森林火災が発生しました。
          </p>
          <p style="margin-bottom: 0; color: var(--text-dim);">
            大気中に巻き上げられた硫黄エアロゾルと煤（すす）は太陽光を遮断し、地球規模の急激な寒冷化「衝突の冬」と光合成の停止を引き起こしました。植物プランクトンや陸上植物が壊滅したことで食物連鎖は根底から崩壊し、非鳥類型恐竜、翼竜、海生爬虫類、アンモナイトを含む全生物種の約75%が地球上から永遠に姿を消しました。しかし、小型で高い適応力を持っていた鳥類恐竜のみがこの大絶滅の試練を生き延び、現代の大空に1万種以上の鳥類として今なお羽ばたき続けています。
          </p>
        </section>

      </div>
    </article>

    <!-- Specimen List & Interactive Filter Section -->
    <section class="specimen-section" style="margin-bottom: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 0, 85, 0.2); padding-bottom: 15px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 11px; color: var(--alert-neon); letter-spacing: 2px;">// CRETACEOUS SPECIMEN DATABASE</span>
          <h2 style="font-size: 24px; color: var(--text-main); margin-top: 5px; font-weight: 700;">白亜紀の登録標本一覧</h2>
        </div>

        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input 
            type="text" 
            id="specimen-search" 
            placeholder="白亜紀恐竜を検索..." 
            aria-label="白亜紀恐竜の名前で検索"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 0, 85, 0.05); border: 1px solid var(--alert-neon); color: var(--text-main); border-radius: 4px; width: 220px;"
          >
          <select 
            id="specimen-sort" 
            aria-label="並び替え順"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 0, 85, 0.05); border: 1px solid var(--alert-neon); color: var(--text-main); border-radius: 4px;"
          >
            <option value="kana">かな順（あいうえお）</option>
            <option value="size-desc">全長順（大きい順）</option>
            <option value="size-asc">全長順（小さい順）</option>
          </select>
        </div>
      </div>

      <!-- Dinosaur Card Grid -->
      <div class="dino-grid" id="specimen-grid">
        {cretaceousDinosaurs.map(d => (
          <div class="dino-card hud-panel" data-name={d.name} data-kana={d.kana} data-length={d.length} data-diet={d.diet} data-group={d.group}>
            <a href={`/dictionary/${d.id}/`} style="text-decoration: none; color: inherit; display: block; height: 100%;">
              <div class="card-img-wrap" style="position: relative; overflow: hidden; aspect-ratio: 1 / 1; background: #000;">
                <img src={`/${d.image}`} alt={d.name} loading="lazy" decoding="async" width="400" height="400" style="width: 100%; height: 100%; object-fit: contain;">
                <div style="position: absolute; top: 8px; left: 8px; background: rgba(0, 0, 0, 0.7); padding: 2px 8px; border-radius: 2px; font-family: var(--font-mono); font-size: 10px; color: var(--alert-neon); border: 1px solid rgba(255, 0, 85, 0.3);">
                  {d.era}
                </div>
              </div>
              <div class="card-info" style="padding: 15px;">
                <h3 class="card-title" style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 4px;">{d.name}</h3>
                <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-bottom: 10px; font-style: italic;">{d.scientificName}</div>
                <div class="card-tags" style="display: flex; gap: 6px; flex-wrap: wrap;">
                  <span class="card-tag group-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 0, 85, 0.1); border: 1px solid rgba(255, 0, 85, 0.3); border-radius: 2px; color: var(--alert-neon);">{d.group || '恐竜'}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: var(--text-dim);">{d.length}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: var(--text-dim);">{d.diet}</span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Topic Cluster Cross-Nav -->
    <PillarNav currentPillar="cretaceous" />

  </div>

  <script>
    function initPillarSpecimens() {
      const search = document.getElementById('specimen-search') as HTMLInputElement;
      const sort = document.getElementById('specimen-sort') as HTMLSelectElement;
      const grid = document.getElementById('specimen-grid');
      if (!search || !sort || !grid) return;

      const cards = Array.from(grid.getElementsByClassName('dino-card')) as HTMLElement[];

      const parseLen = (str: string) => {
        const m = str.match(/[0-9.]+/);
        return m ? parseFloat(m[0]) : 0;
      };

      function updateGrid() {
        const query = search.value.trim().toLowerCase();
        const sortVal = sort.value;

        cards.forEach(card => {
          const name = (card.dataset.name || '').toLowerCase();
          const kana = (card.dataset.kana || '').toLowerCase();
          const match = !query || name.includes(query) || kana.includes(query);
          card.style.display = match ? 'block' : 'none';
        });

        const sorted = cards.slice().sort((a, b) => {
          if (sortVal === 'kana') {
            return (a.dataset.kana || '').localeCompare(b.dataset.kana || '', 'ja');
          } else if (sortVal === 'size-desc') {
            return parseLen(b.dataset.length || '0') - parseLen(a.dataset.length || '0');
          } else if (sortVal === 'size-asc') {
            return parseLen(a.dataset.length || '0') - parseLen(b.dataset.length || '0');
          }
          return 0;
        });

        sorted.forEach(c => grid.appendChild(c));
      }

      search.addEventListener('input', updateGrid);
      sort.addEventListener('change', updateGrid);
    }

    document.addEventListener('astro:page-load', initPillarSpecimens);
    initPillarSpecimens();
  </script>
</Layout>
