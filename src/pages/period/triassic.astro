---
import Layout from '../../layouts/Layout.astro';
import PillarNav from '../../components/PillarNav.astro';
import { getCollection } from 'astro:content';

const allDinosaurs = await getCollection('dinosaurs');
// 三畳紀の恐竜・古生物を動的抽出
const triassicDinosaurs = allDinosaurs
  .filter(entry => entry.data.era.includes('三畳'))
  .map(entry => entry.data);

// 50音順にデフォルトソート
triassicDinosaurs.sort((a, b) => a.kana.localeCompare(b.kana, 'ja'));

// パンくずリスト & 構造化データ (Schema.org)
const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://dino-portal.com/" },
  { "@type": "ListItem", "position": 2, "name": "恐竜図鑑", "item": "https://dino-portal.com/dictionary/" },
  { "@type": "ListItem", "position": 3, "name": "三畳紀の古生物完全ガイド", "item": "https://dino-portal.com/period/triassic/" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "三畳紀の古生物完全ガイド - 恐竜誕生と最古のハンターたち",
    "description": "三畳紀（約2億5190万年前〜2億130万年前）に登場した最古の恐竜と古生物を徹底解説。エオラプトル、ヘレラサウルス、コエロフィシス、プラテオサウルスなどの代表種一覧と最新進化論。",
    "url": "https://dino-portal.com/period/triassic/",
    "hasPart": triassicDinosaurs.map(d => ({
      "@type": "Thing",
      "name": d.name,
      "url": `https://dino-portal.com/dictionary/${d.id}/`,
      "description": d.description
    }))
  }
];
---

<Layout 
  title="三畳紀の古生物完全ガイド - 恐竜誕生と最古のハンターたち | Dino-Portal" 
  description="約2億5190万年〜2億130万年前の三畳紀に誕生した恐竜と古生物を徹底解説。エオラプトル、ヘレラサウルス、コエロフィシス、プラテオサウルス等の代表種一覧、二足歩行イノベーション、超大陸パンゲアの覇権争いを学術的に網羅。"
  activeTab="dictionary"
  schema={schema}
>
  <div class="pillar-container" style="max-width: 1400px; margin: 0 auto; padding: 20px 20px 80px;">
    
    <!-- Breadcrumb bar -->
    <nav aria-label="パンくずリスト" style="margin-bottom: 25px; font-family: var(--font-mono); font-size: 12px; color: #d8edf2; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <a href="/" style="color: var(--primary-neon); text-decoration: none;">HOME</a>
      <span>/</span>
      <a href="/dictionary/" style="color: var(--primary-neon); text-decoration: none;">DICTIONARY</a>
      <span>/</span>
      <span style="color: var(--text-main);">PERIOD: TRIASSIC</span>
    </nav>

    <!-- Hero Banner Header -->
    <header class="pillar-hero hud-panel" style="padding: 40px; margin-bottom: 40px; position: relative; overflow: hidden; border-color: rgba(255, 183, 0, 0.4); background: linear-gradient(135deg, rgba(255, 183, 0, 0.08) 0%, rgba(3, 6, 8, 0.8) 100%);">
      <div class="hero-tag" style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: rgba(255, 183, 0, 0.15); border: 1px solid #ffb700; border-radius: 2px; font-family: var(--font-mono); font-size: 11px; color: #ffb700; margin-bottom: 15px; letter-spacing: 1.5px;">
        <span>GEOLOGICAL ERA ARCHIVE</span>
        <span>|</span>
        <span>251.9 MA – 201.3 MA</span>
      </div>
      
      <h1 style="font-size: clamp(26px, 4vw, 42px); font-weight: 800; color: var(--text-main); line-height: 1.3; margin-bottom: 15px; letter-spacing: -0.5px;">
        三畳紀の古生物完全ガイド<br>
        <span style="font-size: clamp(16px, 2.5vw, 24px); color: #ffb700; font-weight: 600;">恐竜誕生と太古の覇権争い</span>
      </h1>

      <p style="font-size: 15px; line-height: 1.8; color: #d8edf2; max-width: 900px; margin-bottom: 25px;">
        地球史上最大の大量絶滅（P-T境界）を乗り越えた生命は、超大陸パンゲアが広がる過酷な乾燥環境下で新たな進化の扉を開きました。エオラプトルやヘレラサウルスといった最古の俊敏な恐竜たち、巨大草食恐竜の先駆けとなったプラテオサウルス、そしてポストスクスをはじめとする強大な偽鰐類（クルロタルシ類）。恐竜が世界を制覇する前夜のドラマチックな生態系を、最新の古生物学的知見とともに徹底解剖します。
      </p>

      <div class="hero-stats" style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center; border-top: 1px solid rgba(255, 183, 0, 0.2); padding-top: 20px;">
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: #d8edf2; display: block;">REGISTERED SPECIMENS</span>
          <span style="font-size: 24px; font-weight: 700; color: #ffb700;">{triassicDinosaurs.length} <span style="font-size: 14px; color: #d8edf2;">種掲載中</span></span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 183, 0, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: #d8edf2; display: block;">TIME SPAN</span>
          <span style="font-size: 18px; font-weight: 600; color: var(--text-main);">約5,060万年間</span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 183, 0, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: #d8edf2; display: block;">REPRESENTATIVE FORMATIONS</span>
          <span style="font-size: 14px; font-weight: 600; color: var(--text-main);">イスキグアラスト層（南米）/ チンスル層（北米）/ サンタマリア層（南米）</span>
        </div>
      </div>
    </header>

    <!-- Academic Guide Article Section -->
    <article class="academic-guide hud-panel" style="padding: 40px; margin-bottom: 50px; background: rgba(3, 6, 8, 0.6); border-color: rgba(255, 183, 0, 0.25);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px; border-bottom: 2px solid #ffb700; padding-bottom: 15px;">
        <span style="font-size: 24px;">📚</span>
        <h2 style="font-size: 22px; color: #ffb700; font-weight: 700; margin: 0; letter-spacing: 0.5px;">
          三畳紀の古生物学：生態系・骨格進化・地球環境の徹底解説
        </h2>
      </div>

      <div class="article-content" style="color: var(--text-main); font-size: 15px; line-height: 1.9;">
        
        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ffb700; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            1. P-T境界大絶滅からの夜明けと超大陸パンゲアの乾燥環境
          </h3>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            三畳紀（Triassic Period）は、古生代ペルム紀末に起きた地球史上最大の大量絶滅「P-T境界イベント」の直後に始まりました。全生物種の90％以上が死滅した壊滅的な荒野において、陸上生態系の空白地帯（空席となったニッチ）をめぐる激しい適応放散が幕を開けました。
          </p>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            当時の地球は、すべての陸塊が1つに融合した<strong style="color: var(--text-main); font-weight: 700;">超大陸パンゲア（Pangea）</strong>を形成していました。巨大な単一陸塊の内陸部は海洋性気候の恩恵を受けにくく、極端な乾燥帯や広大な砂漠が広がっていました。雨季と乾季が激しく入れ替わる過酷なメガモンスーン気候の中で、乾燥に耐えうる強靭な爬虫類（主竜形類）が急速に勢力を拡大していったのです。
          </p>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ffb700; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            2. 恐竜の誕生と二足歩行イノベーション：直立歩行がもたらした革命
          </h3>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            三畳紀中期（約2億3300万年前）、南米ゴンドワナ大陸（現在のアルゼンチン・イスキグアラスト層など）において、最初の真正恐竜たちが誕生しました。<strong style="color: var(--text-main); font-weight: 700;">エオラプトル（Eoraptor）</strong>や<strong style="color: var(--text-main); font-weight: 700;">ヘレラサウルス（Herrerasaurus）</strong>、<strong style="color: var(--text-main); font-weight: 700;">スタウリコサウルス（Staurikosaurus）</strong>です。彼らは全長1〜3メートルほどの小柄で俊敏な捕食者・雑食者でした。
          </p>
          
          <div style="background: rgba(255, 183, 0, 0.04); border-left: 3px solid #ffb700; padding: 15px 20px; margin: 15px 0; border-radius: 0 4px 4px 0;">
            <h4 style="font-size: 14px; color: #ffb700; margin-bottom: 8px; font-weight: 700;">🔬 恐竜を「勝者」たらしめた3大骨格イノベーション</h4>
            <ul style="margin: 0; padding-left: 20px; font-size: 14.5px; color: #cfe6eb; line-height: 1.8;">
              <li style="margin-bottom: 12px;">
                <strong style="color: #fff;">寛骨臼の貫通と完全直立姿勢:</strong><br>
                トカゲのように横に這い出る四肢（側方型）から、骨盤の穴（寛骨臼）に大腿骨頭が垂直にはまり込む完全直立歩行を獲得。体を揺らさずに呼吸しながら高速走行できる驚異の持久力を手に入れた。
              </li>
              <li style="margin-bottom: 12px;">
                <strong style="color: #fff;">前肢の解放と捕食マニピュレーター化:</strong><br>
                後肢のみで体重を支える二足歩行化により、自由になった前肢で獲物を掴み、木の実をむしり取る高度な器用さを獲得。
              </li>
              <li style="margin-bottom: 0;">
                <strong style="color: #fff;">原始的気嚢システム（高効率換気）の萌芽:</strong><br>
                酸素濃度の低かった三畳紀の大気環境において、一方向性の呼吸システムを発達させ、他の爬虫類を凌駕する高い代謝率と運動性能を維持した。
              </li>
            </ul>
          </div>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ffb700; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            3. 強力なライバル「偽鰐類（クルロタルシ類）」との熾烈な覇権争い
          </h3>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            「三畳紀＝恐竜の時代」と想像されがちですが、当時の生態系の主役は恐竜ではなく、現代のワニへと連なる<strong style="color: var(--text-main); font-weight: 700;">偽鰐類（Pseudosuchia）</strong>でした。彼らは恐竜を圧倒する体格と多様性を誇り、陸上生態系の頂点捕食者および大型草食動物の座を完全に独占していました。
          </p>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            大型四足歩行ハンターの<strong style="color: var(--text-main); font-weight: 700;">ポストスクス（Postosuchus）</strong>やサウロスクスは、ティラノサウルスに先駆けて頭骨の強力な粉砕咬合力を発達させ、初期の小型恐竜たちを容易に捕食していました。また、トゲ付きの鎧をまとった草食性のアエトサウルス類（デスマトスクス等）や、哺乳類の祖先である単弓類（プラケリアスなど）が大地を闊歩しており、恐竜は彼らの足元をすり抜ける新参の下位グループに過ぎなかったのです。
          </p>
        </section>

        <section>
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ffb700; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            4. カーニアン多雨事象とT-J大量絶滅：恐竜の世紀への決定打
          </h3>
          <p style="margin-bottom: 12px; color: #d8edf2;">
            形勢を大きく変えたのが、三畳紀後期（約2億3400万〜2億3200万年前）に起きた地球規模の気候変動「<strong style="color: var(--text-main); font-weight: 700;">カーニアン多雨事象（CPE: Carnian Pluvial Episode）</strong>」です。大西洋中央部での大規模な火山活動により地球が急速に温暖湿潤化し、乾燥適応型の植物が衰退して針葉樹林が拡大。この植物相の激変に適応した基盤的竜脚形類（<strong style="color: var(--text-main); font-weight: 700;">プラテオサウルス</strong>やリオハサウルス）が全長8〜10メートルに巨大化し、恐竜の草食革命が起きました。
          </p>
          <p style="margin-bottom: 0; color: #d8edf2;">
            そして三畳紀末（約2億130万年前）、パンゲア大陸分裂に伴う巨大火山噴火によって<strong style="color: var(--text-main); font-weight: 700;">T-J大量絶滅（三畳紀末絶滅）</strong>が発生。繁栄を誇った偽鰐類の大半が死滅する中、省エネ歩行と高効率な呼吸系、体温保持の原羽毛を備えていた恐竜たち（コエロフィシス等）は見事に生き残り、続くジュラ紀・白亜紀における1億4000万年間の絶対的黄金時代へと躍り出たのです。
          </p>
        </section>

      </div>
    </article>

    <!-- Specimen List & Interactive Filter Section -->
    <section class="specimen-section" style="margin-bottom: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 183, 0, 0.2); padding-bottom: 15px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 11px; color: #ffb700; letter-spacing: 2px;">TRIASSIC SPECIMEN DATABASE</span>
          <h2 style="font-size: 24px; color: var(--text-main); margin-top: 5px; font-weight: 700;">三畳紀の登録標本一覧</h2>
        </div>

        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input 
            type="text" 
            id="specimen-search" 
            placeholder="三畳紀の古生物を検索..." 
            aria-label="三畳紀古生物の名前で検索"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 183, 0, 0.05); border: 1px solid #ffb700; color: var(--text-main); border-radius: 4px; width: 220px;"
          >
          <select 
            id="specimen-sort" 
            aria-label="並び替え順"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 183, 0, 0.05); border: 1px solid #ffb700; color: var(--text-main); border-radius: 4px;"
          >
            <option value="kana">かな順（あいうえお）</option>
            <option value="size-desc">全長順（大きい順）</option>
            <option value="size-asc">全長順（小さい順）</option>
          </select>
        </div>
      </div>

      <!-- Dinosaur Card Grid -->
      <div class="dino-grid" id="specimen-grid">
        {triassicDinosaurs.map(d => (
          <div class="dino-card hud-panel" data-id={d.id} data-name={d.name} data-kana={d.kana} data-aliases={(d.aliases || []).join(',')} data-scientific={d.scientificName} data-length={d.length} data-diet={d.diet} data-group={d.group}>
            <a href={`/dictionary/${d.id}/`} style="text-decoration: none; color: inherit; display: block; height: 100%;">
              <div class="card-img-wrap" style="position: relative; overflow: hidden; aspect-ratio: 1 / 1; background: #000;">
                <img src={`/${d.image}`} alt={d.name} loading="lazy" decoding="async" width="400" height="400" style="width: 100%; height: 100%; object-fit: contain;">
                <div style="position: absolute; top: 8px; left: 8px; background: rgba(0, 0, 0, 0.7); padding: 2px 8px; border-radius: 2px; font-family: var(--font-mono); font-size: 10px; color: #ffb700; border: 1px solid rgba(255, 183, 0, 0.3);">
                  {d.era}
                </div>
              </div>
              <div class="card-info" style="padding: 15px;">
                <h3 class="card-title" style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 4px;">{d.name}</h3>
                <div style="font-family: var(--font-mono); font-size: 11px; color: #d8edf2; margin-bottom: 10px; font-style: italic;">{d.scientificName}</div>
                <div class="card-tags" style="display: flex; gap: 6px; flex-wrap: wrap;">
                  <span class="card-tag group-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 183, 0, 0.1); border: 1px solid rgba(255, 183, 0, 0.3); border-radius: 2px; color: #ffb700;">{d.group || '古生物'}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: #d8edf2;">{d.length}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: #d8edf2;">{d.diet}</span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Topic Cluster Navigation component -->
    <PillarNav currentPillar="triassic" />

  </div>
</Layout>

<style>
  .dino-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .dino-card {
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    border-color: rgba(255, 183, 0, 0.2);
  }

  .dino-card:hover {
    transform: translateY(-4px);
    border-color: #ffb700;
    box-shadow: 0 8px 25px rgba(255, 183, 0, 0.25);
  }

  .card-img-wrap img {
    transition: transform 0.5s ease;
  }

  .dino-card:hover .card-img-wrap img {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .dino-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .pillar-hero {
      padding: 25px 20px !important;
    }
    .academic-guide {
      padding: 25px 20px !important;
    }
  }

  @media (max-width: 480px) {
    .dino-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupSearchAndSort() {
    const searchInput = document.getElementById('specimen-search') as HTMLInputElement;
    const sortSelect = document.getElementById('specimen-sort') as HTMLSelectElement;
    const grid = document.getElementById('specimen-grid');
    if (!grid) return;

    const cards = Array.from(grid.getElementsByClassName('dino-card')) as HTMLElement[];

    function parseLength(lenStr: string): number {
      if (!lenStr) return 0;
      const m = lenStr.match(/([0-9.]+)\s*m/i);
      return m ? parseFloat(m[1]) : 0;
    }

    function applyFilters() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const sortMode = sortSelect?.value || 'kana';

      // 1. Filter
      cards.forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const kana = (card.dataset.kana || '').toLowerCase();
        const aliases = (card.dataset.aliases || '').toLowerCase();
        const scientific = (card.dataset.scientific || '').toLowerCase();
        const group = (card.dataset.group || '').toLowerCase();

        const match = !q || 
          name.includes(q) || 
          kana.includes(q) || 
          aliases.includes(q) || 
          scientific.includes(q) ||
          group.includes(q);

        card.style.display = match ? 'block' : 'none';
      });

      // 2. Sort
      const sortedCards = cards.slice().sort((a, b) => {
        if (sortMode === 'size-desc') {
          return parseLength(b.dataset.length || '') - parseLength(a.dataset.length || '');
        } else if (sortMode === 'size-asc') {
          return parseLength(a.dataset.length || '') - parseLength(b.dataset.length || '');
        } else {
          const kanaA = a.dataset.kana || a.dataset.name || '';
          const kanaB = b.dataset.kana || b.dataset.name || '';
          return kanaA.localeCompare(kanaB, 'ja');
        }
      });

      sortedCards.forEach(c => grid.appendChild(c));
    }

    searchInput?.addEventListener('input', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);
  }

  // Setup on page load and client navigations
  setupSearchAndSort();
  document.addEventListener('astro:page-load', setupSearchAndSort);
</script>
