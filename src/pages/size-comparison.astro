---
import Layout from '../layouts/Layout.astro';
import { REFERENCE_ASSETS } from '../data/cyberAssets';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const dinosaurs = await getCollection('dinosaurs');

// Filter only dinos that have cyberMetadata and image exists
const comparisonDinos = dinosaurs.filter(dino => {
    if (!dino.data.cyberMetadata) return false;
    const imagePath = path.join(process.cwd(), 'public', 'images', 'cyber', `${dino.id}.webp`);
    return fs.existsSync(imagePath);
}).sort((a, b) => {
    return a.data.kana.localeCompare(b.data.kana, 'ja');
});

// Use tyrannosaurus as default starting specimen
const defaultDino = comparisonDinos.find(d => d.id === 'tyrannosaurus') || comparisonDinos[0];
if (!defaultDino) {
    throw new Error("No dinosaurs available for size comparison.");
}
---

<Layout title="恐竜サイズ比較シミュレータ｜人間・動物・クジラ・旅客機と実寸1:1比較 | Dino-Portal" activeTab="comparison" description="340種以上の恐竜・古生物を人間（1.7m）やアフリカゾウ、シロナガスクジラ（30m）、大型ジェット旅客機（70m）と実寸1:1スケールで自由に並べて大きさ比較できる体験型シミュレータ。ティラノサウルスや超巨大竜脚類の真のスケールをブラウザ上で体感！">
    <section class="page-header">
        <h2 class="page-title">サイズ比較シミュレータ</h2>
        <p class="page-subtitle">恐竜と現代の様々なオブジェクトのサイズを視覚的に比較できるシミュレーションツールです。</p>
    </section>

    <div class="sandbox-container" style="display: grid; grid-template-columns: 1fr; gap: 30px;">
        <!-- CONTROL PANEL -->
        <div class="hud-panel control-hud">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            
            <!-- Mode Selector HUD -->
            <div class="control-group mode-control-group">
                <label class="control-label">[ 表示モード切替 ]</label>
                <div class="hud-mode-toggle" id="hud-mode-toggle">
                    <button type="button" class="mode-btn active" id="btn-mode-bone" data-mode="bone">
                        <span class="mode-icon">💀</span> 骨格実寸モード
                    </button>
                    <button type="button" class="mode-btn" id="btn-mode-battle" data-mode="battle">
                        <span class="mode-icon">⚡</span> リアル威嚇対決モード
                    </button>
                </div>
            </div>

            <!-- Dino Selector -->
            <div class="control-group">
                <label class="control-label">[ 基準恐竜 (左側) ]</label>
                <select id="dino-selector" class="hud-select">
                    {comparisonDinos.map(dino => (
                        <option 
                            value={dino.id} 
                            data-dino={JSON.stringify(dino.data)}
                            selected={dino.id === defaultDino.id}
                        >
                            {dino.data.name} ({dino.data.cyberMetadata?.realHeight}m)
                        </option>
                    ))}
                </select>
            </div>

            <!-- Target Selector -->
            <div class="control-group">
                <label class="control-label">[ 比較・対決対象 (右側) ]</label>
                <select id="asset-selector" class="hud-select">
                    <optgroup label="現代の比較対象（人間・動物・乗り物）">
                        {Object.values(REFERENCE_ASSETS).map(asset => (
                            <option value={asset.id} data-asset={JSON.stringify(asset)} data-type="reference">{asset.label}</option>
                        ))}
                    </optgroup>
                    <optgroup label="恐竜・古生物と直接対決（実寸VS）">
                        {comparisonDinos.map(dino => {
                            const assetData = {
                                id: dino.id,
                                name: dino.data.name,
                                label: `【恐竜】${dino.data.name}（${dino.data.cyberMetadata?.realHeight}m）`,
                                icon: `images/cyber/${dino.id}.webp`,
                                realHeight: dino.data.cyberMetadata?.realHeight || 2.0,
                                realLength: dino.data.cyberMetadata?.realLength || parseFloat(dino.data.length),
                                bottomGap: dino.data.cyberMetadata?.bottomGap || 280,
                                contentHeightPx: dino.data.cyberMetadata?.contentHeightPx || 450,
                                sourceRes: dino.data.cyberMetadata?.sourceRes || 1024,
                                isDino: true
                            };
                            return (
                                <option value={dino.id} data-asset={JSON.stringify(assetData)} data-type="dinosaur">
                                    【恐竜】{dino.data.name} (全長{dino.data.length} / 高{dino.data.cyberMetadata?.realHeight}m)
                                </option>
                            );
                        })}
                    </optgroup>
                </select>
            </div>

            <!-- Stats display -->
            <div class="control-group stats-group">
                <div class="stats-label-wrap">
                    <span class="stats-label">[ 基準高/長 ]</span><br/>
                    <span id="dino-hud-specs" class="stats-value">--</span>
                </div>
                <div class="detail-link-wrap">
                    <a id="dino-detail-link" href="" class="dino-detail-link">
                        図鑑アーカイブ ➔
                    </a>
                </div>
            </div>
        </div>

        <!-- STAGE AREA (Pure visualization canvas) -->
        <div class="hud-panel stage-hud" id="comparison-stage-container" style="height: 405px; position: relative; overflow: hidden; background: rgba(3, 6, 8, 0.4); border-color: var(--panel-border); user-select: none;">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            
            <!-- Dynamic Grid overlay background controlled by zoom -->
            <div id="dynamic-grid" style="position: absolute; inset: 0; background-image: linear-gradient(rgba(0, 242, 255, 0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 242, 255, 0.15) 1px, transparent 1px); background-size: 50px 50px; pointer-events: none; opacity: 0.25; z-index: 1;"></div>
 
            <!-- Dynamic Scale Ruler (Y-axis Helper) -->
            <div class="ruler-y" style="position: absolute; left: 8px; top: 0; bottom: 25px; width: 44px; border-right: 1px dashed rgba(0, 242, 255, 0.3); z-index: 5; display: flex; flex-direction: column; justify-content: flex-end; font-family: var(--font-mono); font-size: 14px; color: var(--primary-neon);">
                <!-- Dynamic markers will be rendered here by script -->
            </div>
 
            <!-- Baseline Ground Indicator -->
            <div class="baseline-line" style="position: absolute; left: 0; right: 0; bottom: 25px; border-bottom: 2px solid var(--primary-neon); box-shadow: 0 0 10px rgba(0, 242, 255, 0.5); z-index: 2;">
            </div>
 
            <!-- Stage Content -->
            <div class="stage-viewport" style="position: absolute; inset: 0; z-index: 3; cursor: grab;">
                <!-- Dino Specimen -->
                <div class="specimen-container dino-specimen" id="dino-element" 
                     style="position: absolute; left: 360px; bottom: 25px; height: 380px; width: 300px; transition: transform 0.1s ease-out; overflow: visible; z-index: 4;">
                    <img id="dino-img" src="" alt="DINOSAUR" class="cyber-hud-specimen" 
                          style="position: absolute; left: 50%; transform: translateX(-50%) !important; width: auto; mix-blend-mode: screen !important; max-width: none !important; max-height: none !important;" />
                    <div id="dino-tag" class="vis-tag dino-tag" style="white-space: nowrap; position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; color: var(--text-main); background: transparent !important; border: none !important; padding: 0; z-index: 10; clip-path: none !important; width: auto !important;">
                        --
                    </div>
                </div>
 
                <!-- Reference Target -->
                <div class="specimen-container reference-specimen" id="ref-element" 
                     style="position: absolute; right: 80px; bottom: 25px; height: 380px; width: 200px; transition: transform 0.1s ease-out; overflow: visible; z-index: 5;">
                    <img id="ref-img" src="" alt="REFERENCE" class="cyber-hud-specimen" 
                          style="position: absolute; left: 50%; transform: translateX(-50%) !important; width: auto; max-width: none !important; max-height: none !important;" />
                    <div id="ref-tag" class="vis-tag ref-tag" style="white-space: nowrap; position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; color: var(--secondary-neon); background: transparent !important; border: none !important; padding: 0; z-index: 10; clip-path: none !important;">
                        --
                    </div>
                </div>
            </div>
        </div>

        <!-- HUB NAVIGATION: ACTIVE SPECIMEN SMART CARD -->
        <div class="hud-panel specimen-card-hud" id="active-specimen-card">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            <div class="specimen-card-inner">
                <div class="specimen-thumb-wrap">
                    <img id="card-dino-img" src="" alt="Dinosaur" class="specimen-card-thumb" />
                    <span id="card-dino-diet" class="specimen-card-badge">--</span>
                </div>
                <div class="specimen-card-body">
                    <div class="specimen-card-header">
                        <div class="specimen-name-group">
                            <h3 id="card-dino-name" class="specimen-card-name">--</h3>
                            <span id="card-dino-scientific" class="specimen-card-scientific">--</span>
                        </div>
                        <div class="specimen-meta-tags">
                            <span class="meta-tag"><strong style="color:var(--primary-neon);">時代:</strong> <span id="card-dino-era">--</span></span>
                            <span class="meta-tag"><strong style="color:var(--primary-neon);">生息地:</strong> <span id="card-dino-region">--</span></span>
                            <span class="meta-tag"><strong style="color:var(--secondary-neon);">全長:</strong> <span id="card-dino-length">--</span></span>
                            <span class="meta-tag"><strong style="color:var(--secondary-neon);">体重:</strong> <span id="card-dino-weight">--</span></span>
                        </div>
                    </div>
                    <p id="card-dino-desc" class="specimen-card-desc">--</p>
                    <div class="specimen-card-actions">
                        <a id="card-dino-detail-btn" href="" class="card-detail-cta-btn">
                            <span class="cta-arrow">▶</span> この恐竜の個別図鑑アーカイブを見る（全生態・化石解説へ）
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- HUB NAVIGATION: RELATED SPECIAL TOPICS -->
        <div class="hud-panel related-topics-hud" id="related-topic-container" style="display: none;">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            <div class="related-topic-content">
                <div class="related-topic-icon" id="related-topic-icon">🏆</div>
                <div class="related-topic-info">
                    <div class="related-topic-label">[ 関連特集記事 RECOMMENDATION ]</div>
                    <a id="related-topic-link" href="" class="related-topic-title">--</a>
                </div>
                <a id="related-topic-btn" href="" class="related-topic-btn">記事を読む ➔</a>
            </div>
        </div>

        <!-- HUB NAVIGATION: QUICK PRESETS -->
        <div class="hud-panel preset-hud">
            <div class="hud-corner top-left"></div>
            <div class="hud-corner bottom-right"></div>
            <div class="preset-header">
                <span class="preset-title">[ クイック比較プリセット - 代表的な恐竜を即座にシミュレート ]</span>
                <span class="preset-subtitle">ワンタップで選択恐竜を瞬時に切り替えられます</span>
            </div>
            
            <div class="preset-groups-container">
                <!-- Group 1: 超巨大恐竜 -->
                <div class="preset-group">
                    <div class="preset-group-label">👑 超巨大恐竜 (20m超)</div>
                    <div class="preset-buttons">
                        <button type="button" class="preset-btn" data-dino-id="argentinosaurus">アルゼンチノサウルス (35m)</button>
                        <button type="button" class="preset-btn" data-dino-id="supersaurus">スーパーサウルス (40m)</button>
                        <button type="button" class="preset-btn" data-dino-id="brachiosaurus">ブラキオサウルス (25m)</button>
                        <button type="button" class="preset-btn" data-dino-id="patagotitan">パタゴティタン (37m)</button>
                    </div>
                </div>

                <!-- Group 2: 最強大型肉食恐竜 -->
                <div class="preset-group">
                    <div class="preset-group-label">⚔ 大型肉食恐竜 (頂点捕食者)</div>
                    <div class="preset-buttons">
                        <button type="button" class="preset-btn" data-dino-id="tyrannosaurus">ティラノサウルス (12m)</button>
                        <button type="button" class="preset-btn" data-dino-id="spinosaurus">スピノサウルス (15m)</button>
                        <button type="button" class="preset-btn" data-dino-id="giganotosaurus">ギガノトサウルス (13m)</button>
                        <button type="button" class="preset-btn" data-dino-id="carcharodontosaurus">カルカロドントサウルス (12.5m)</button>
                    </div>
                </div>

                <!-- Group 3: 人気草食・装甲・角竜 -->
                <div class="preset-group">
                    <div class="preset-group-label">🛡 人気草食・角竜・よろい竜</div>
                    <div class="preset-buttons">
                        <button type="button" class="preset-btn" data-dino-id="triceratops">トリケラトプス (9m)</button>
                        <button type="button" class="preset-btn" data-dino-id="stegosaurus">ステゴサウルス (9m)</button>
                        <button type="button" class="preset-btn" data-dino-id="ankylosaurus">アンキロサウルス (8m)</button>
                        <button type="button" class="preset-btn" data-dino-id="parasaurolophus">パラサウロロフス (10m)</button>
                    </div>
                </div>

                <!-- Group 4: 小型・俊敏・羽毛恐竜 -->
                <div class="preset-group">
                    <div class="preset-group-label">🪶 小型・俊敏・羽毛恐竜</div>
                    <div class="preset-buttons">
                        <button type="button" class="preset-btn" data-dino-id="velociraptor">ヴェロキラプトル (2m)</button>
                        <button type="button" class="preset-btn" data-dino-id="microraptor">ミクロラプトル (0.8m)</button>
                        <button type="button" class="preset-btn" data-dino-id="compsognathus">コンプソグナトゥス (1m)</button>
                        <button type="button" class="preset-btn" data-dino-id="deinonychus">デイノニクス (3.4m)</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
 
    <!-- CLIENT SCRIPT FOR INTERACTIVE LOGIC -->
    <script>
        const PANEL_HEIGHT = 405;
        const BASELINE_PX = 25;
        const SAFE_ZONE_H = PANEL_HEIGHT - BASELINE_PX; // 380px
        const SAFE_ZONE_W = 700; // 推定描画域

        let currentZoom = 1.0;
        let targetZoom = 1.0;
        let activeAsset: any = null;
        let activeDino: any = null;
        let animationFrameId: number | null = null;

        // Dom Elements (re-assigned dynamically on page-load for view transitions)
        let selector: HTMLSelectElement | null = null;
        let dinoSelector: HTMLSelectElement | null = null;
        let stageContainer: HTMLElement | null = null;
        let grid: HTMLElement | null = null;
        let ruler: HTMLElement | null = null;

        // Specimens Elements
        let dinoEl: HTMLElement | null = null;
        let dinoImg: HTMLImageElement | null = null;
        let dinoTag: HTMLElement | null = null;
        let refEl: HTMLElement | null = null;
        let refImg: HTMLImageElement | null = null;
        let refTag: HTMLElement | null = null;

        // Mode: 'bone' (cyber skeleton) or 'battle' (photorealistic threat battle)
        let currentMode: 'bone' | 'battle' = 'bone';

        // Battle Assets Registry (Calibrated for strict length & posture proportion)
        const BATTLE_ASSETS: Record<string, { image: string; contentHeightPx: number; bottomGap: number }> = {
            tyrannosaurus: {
                image: '/images/cyber/tyrannosaurus_battle.webp',
                // Calibrated to hip height 4.0m (realHeight 4.5m * 351px / 4.0m = 395px)
                contentHeightPx: 395,
                bottomGap: 306
            },
            triceratops: {
                image: '/images/cyber/triceratops_battle.webp',
                contentHeightPx: 322,
                bottomGap: 305
            },
            spinosaurus: {
                image: '/images/cyber/spinosaurus_battle.webp',
                contentHeightPx: 319,
                bottomGap: 297
            },
            giganotosaurus: {
                image: '/images/cyber/giganotosaurus_battle.webp',
                contentHeightPx: 295,
                bottomGap: 346
            },
            brachiosaurus: {
                image: '/images/cyber/brachiosaurus_battle.webp',
                // Aspect 1.91:1, Length 25.0m, Height 13.0m
                contentHeightPx: 514,
                bottomGap: 254
            },
            ankylosaurus: {
                image: '/images/cyber/ankylosaurus_battle.webp',
                // Calibrated to hip height 1.7m / length 7.0m (realHeight 1.7m * 985px / 7.0m = 239px)
                contentHeightPx: 239,
                bottomGap: 328
            },
            mosasaurus: {
                image: '/images/cyber/mosasaurus_battle.webp',
                // Calibrated to exact length 17.0m (realHeight 3.5m * 980px / 17.0m = 202px)
                contentHeightPx: 202,
                bottomGap: 413
            },
            pteranodon: {
                image: '/images/cyber/pteranodon_battle.webp',
                // Standing height 3.0m / wings folded length ~5.0m (contentHeightPx 583 matches skeleton 579)
                contentHeightPx: 583,
                bottomGap: 221
            }
        };

        // Stats UI Elements
        let dinoHudSpecs: HTMLElement | null = null;
        let dinoDetailLink: HTMLAnchorElement | null = null;

        // Smart Specimen Card Elements
        let cardDinoImg: HTMLImageElement | null = null;
        let cardDinoDiet: HTMLElement | null = null;
        let cardDinoName: HTMLElement | null = null;
        let cardDinoScientific: HTMLElement | null = null;
        let cardDinoEra: HTMLElement | null = null;
        let cardDinoRegion: HTMLElement | null = null;
        let cardDinoLength: HTMLElement | null = null;
        let cardDinoWeight: HTMLElement | null = null;
        let cardDinoDesc: HTMLElement | null = null;
        let cardDinoDetailBtn: HTMLAnchorElement | null = null;

        // Related Topic Elements
        let relatedTopicContainer: HTMLElement | null = null;
        let relatedTopicIcon: HTMLElement | null = null;
        let relatedTopicLink: HTMLAnchorElement | null = null;
        let relatedTopicBtn: HTMLAnchorElement | null = null;

        // Dino specs from datasets
        let dinoRealH = 2.0;
        let dinoRealL = 6.0;
        let dinoContentH = 450;
        let dinoSourceRes = 1024;
        let dinoBottomGap = 280;
        let dinoName = "";
        let dinoLength = "";
        let dinoId = "";

        function handleResize() {
            recalculateAutofocus();
        }

        function initPrototype() {
            // Retrieve DOM elements dynamically for the current page state
            selector = document.getElementById('asset-selector') as HTMLSelectElement;
            dinoSelector = document.getElementById('dino-selector') as HTMLSelectElement;
            stageContainer = document.getElementById('comparison-stage-container') as HTMLElement;
            grid = document.getElementById('dynamic-grid') as HTMLElement;
            ruler = document.querySelector('.ruler-y') as HTMLElement;

            dinoEl = document.getElementById('dino-element') as HTMLElement;
            dinoImg = document.getElementById('dino-img') as HTMLImageElement;
            dinoTag = document.getElementById('dino-tag') as HTMLElement;
            refEl = document.getElementById('ref-element') as HTMLElement;
            refImg = document.getElementById('ref-img') as HTMLImageElement;
            refTag = document.getElementById('ref-tag') as HTMLElement;

            dinoHudSpecs = document.getElementById('dino-hud-specs') as HTMLElement;
            dinoDetailLink = document.getElementById('dino-detail-link') as HTMLAnchorElement;

            // Smart Card Elements
            cardDinoImg = document.getElementById('card-dino-img') as HTMLImageElement;
            cardDinoDiet = document.getElementById('card-dino-diet') as HTMLElement;
            cardDinoName = document.getElementById('card-dino-name') as HTMLElement;
            cardDinoScientific = document.getElementById('card-dino-scientific') as HTMLElement;
            cardDinoEra = document.getElementById('card-dino-era') as HTMLElement;
            cardDinoRegion = document.getElementById('card-dino-region') as HTMLElement;
            cardDinoLength = document.getElementById('card-dino-length') as HTMLElement;
            cardDinoWeight = document.getElementById('card-dino-weight') as HTMLElement;
            cardDinoDesc = document.getElementById('card-dino-desc') as HTMLElement;
            cardDinoDetailBtn = document.getElementById('card-dino-detail-btn') as HTMLAnchorElement;

            // Related Topics
            relatedTopicContainer = document.getElementById('related-topic-container') as HTMLElement;
            relatedTopicIcon = document.getElementById('related-topic-icon') as HTMLElement;
            relatedTopicLink = document.getElementById('related-topic-link') as HTMLAnchorElement;
            relatedTopicBtn = document.getElementById('related-topic-btn') as HTMLAnchorElement;

            // Guard: skip initialization if elements do not exist (when transition brings us to another page)
            if (!selector || !dinoSelector || !stageContainer) return;

            // Cancel any ongoing zoom animations to prevent memory leaks and updates on old values
            if (animationFrameId !== null) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }

            currentZoom = 1.0;
            targetZoom = 1.0;

            // Check for URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const targetDinoId = urlParams.get('dino');
            if (targetDinoId && dinoSelector) {
                const matchedOption = Array.from(dinoSelector.options).find(opt => opt.value === targetDinoId);
                if (matchedOption) {
                    dinoSelector.value = targetDinoId;
                }
            }

            const targetCompareId = urlParams.get('compare') || urlParams.get('vs');
            if (targetCompareId && selector) {
                const matchedOption = Array.from(selector.options).find(opt => opt.value === targetCompareId);
                if (matchedOption) {
                    selector.value = targetCompareId;
                }
            }

            const targetMode = urlParams.get('mode');
            if (targetMode === 'battle') {
                currentMode = 'battle';
            } else {
                currentMode = 'bone';
            }
            updateModeButtons();

            // Bind mode buttons
            const btnBone = document.getElementById('btn-mode-bone');
            const btnBattle = document.getElementById('btn-mode-battle');
            btnBone?.addEventListener('click', () => setMode('bone'));
            btnBattle?.addEventListener('click', () => setMode('battle'));

            // Bind preset buttons
            const presetButtons = document.querySelectorAll('.preset-btn');
            presetButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-dino-id');
                    if (targetId && dinoSelector) {
                        const matched = Array.from(dinoSelector.options).find(opt => opt.value === targetId);
                        if (matched) {
                            dinoSelector.value = targetId;
                            updateSelectedDino();
                            // Smooth scroll slightly towards stage if on mobile
                            if (window.innerWidth <= 768 && stageContainer) {
                                stageContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            }
                        }
                    }
                });
            });

            // Load initial dino
            updateSelectedDino();

            // Load initial asset
            updateSelectedAsset();

            // Bind UI controllers
            selector.addEventListener('change', () => {
                updateSelectedAsset();
            });

            dinoSelector.addEventListener('change', () => {
                updateSelectedDino();
            });

            // Bind window resize
            window.removeEventListener('resize', handleResize);
            window.addEventListener('resize', handleResize);

            // Initial render
            renderStage();
        }

        function formatVal(val: number): string {
            return val % 1 === 0 ? val.toFixed(1) : val.toString();
        }

        function updateRelatedTopic(dino: any) {
            if (!relatedTopicContainer || !relatedTopicIcon || !relatedTopicLink || !relatedTopicBtn) return;
            
            const id = dino.id || '';
            const group = dino.group || '';
            const realL = dino.cyberMetadata?.realLength || 0;

            let topic = {
                icon: '📚',
                title: '恐竜とは何か？爬虫類との違い・分類・進化の基礎知識ガイド',
                url: '/topics/what-is-dinosaur/'
            };

            // 巨大竜脚類 (全長20m以上、または特定の超大型種)
            const giantIds = ['argentinosaurus', 'supersaurus', 'patagotitan', 'dreadnoughtus', 'brachiosaurus', 'sauroposeidon', 'alamosaurus', 'mamenchisaurus', 'diplodocus', 'apatosaurus', 'barosaurus', 'puertasaurus'];
            if (giantIds.includes(id) || realL >= 20 || group === '竜脚類') {
                topic = {
                    icon: '🏆',
                    title: '【結論】世界最大の恐竜はアルゼンチノサウルス！太古で一番大きい恐竜ランキングTOP10｜実寸比較',
                    url: '/topics/dinosaur-size-ranking/'
                };
            }
            // 最強大型肉食恐竜
            else if (['tyrannosaurus', 'spinosaurus', 'giganotosaurus', 'carcharodontosaurus', 'tarbosaurus', 'allosaurus', 'mapusaurus', 'acrocanthosaurus'].includes(id)) {
                topic = {
                    icon: '⚔',
                    title: '史上最強の恐竜は誰だ？ティラノサウルス vs スピノサウルス・ギガノトサウルス徹底論争',
                    url: '/topics/strongest-dinosaur-debate/'
                };
            }
            // 海生爬虫類・古生物
            else if (['mosasaurus', 'plesiosaurus', 'tylosaurus', 'futabasaurus', 'kronosaurus', 'archelon', 'dunkleosteus', 'anomalocaris', 'dimetrodon', 'ichthyosaurus', 'shonisaurus'].includes(id) || ['首長竜', '魚竜', 'その他'].includes(group)) {
                topic = {
                    icon: '🌊',
                    title: 'モササウルスや首長竜は「恐竜」じゃない？恐竜の定義と古生物の真実',
                    url: '/topics/not-dinosaurs-truth/'
                };
            }
            // 角竜類
            else if (group === '角竜類' || ['triceratops', 'torosaurus', 'styracosaurus', 'pachyrhinosaurus', 'centrosaurus'].includes(id)) {
                topic = {
                    icon: '🛡',
                    title: 'トリケラトプスのフリルの謎とは？防御・威嚇・体温調節の最新学説',
                    url: '/topics/triceratops-frill-mystery/'
                };
            }
            // 羽毛恐竜・小型獣脚類
            else if (['archaeopteryx', 'velociraptor', 'microraptor', 'yutyrannus', 'anchiornis', 'caudipteryx', 'deinonychus'].includes(id)) {
                topic = {
                    icon: '🪶',
                    title: 'ティラノサウルスには本当に羽毛が生えていたのか？最新学説で迫る真実',
                    url: '/topics/trex-feathers/'
                };
            }

            relatedTopicIcon.innerText = topic.icon;
            relatedTopicLink.innerText = topic.title;
            relatedTopicLink.href = topic.url;
            relatedTopicBtn.href = topic.url;
            relatedTopicContainer.style.display = 'block';
        }

        function updatePresetButtons(currentId: string) {
            const buttons = document.querySelectorAll('.preset-btn');
            buttons.forEach(btn => {
                if (btn.getAttribute('data-dino-id') === currentId) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        function updateModeButtons() {
            const btnBone = document.getElementById('btn-mode-bone');
            const btnBattle = document.getElementById('btn-mode-battle');
            if (btnBone && btnBattle) {
                if (currentMode === 'battle') {
                    btnBattle.classList.add('active');
                    btnBone.classList.remove('active');
                } else {
                    btnBone.classList.add('active');
                    btnBattle.classList.remove('active');
                }
            }
        }

        function setMode(newMode: 'bone' | 'battle') {
            if (currentMode === newMode) return;
            currentMode = newMode;
            updateModeButtons();
            updateSelectedDino();
            updateSelectedAsset();
            updateUrlParams();
        }

        function updateUrlParams() {
            try {
                const currentUrl = new URL(window.location.href);
                if (dinoId) currentUrl.searchParams.set('dino', dinoId);
                if (activeAsset && activeAsset.id) {
                    if (activeAsset.isDino) {
                        currentUrl.searchParams.set('vs', activeAsset.id);
                        currentUrl.searchParams.delete('compare');
                    } else {
                        currentUrl.searchParams.set('compare', activeAsset.id);
                        currentUrl.searchParams.delete('vs');
                    }
                }
                if (currentMode === 'battle') {
                    currentUrl.searchParams.set('mode', 'battle');
                } else {
                    currentUrl.searchParams.delete('mode');
                }
                window.history.replaceState({}, '', currentUrl.toString());

                // Update document title dynamically
                if (activeAsset && activeAsset.isDino) {
                    document.title = `【実寸対決】${dinoName} vs ${activeAsset.name} 大きさ比較シミュレータ | Dino-Portal`;
                } else if (activeAsset) {
                    document.title = `${dinoName}と${activeAsset.name}の実寸サイズ比較シミュレータ | Dino-Portal`;
                }
            } catch (e) {
                // Ignore in non-browser
            }
        }

        function updateSelectedDino() {
            if (!dinoSelector || !dinoImg || !dinoTag) return;
            const option = dinoSelector.options[dinoSelector.selectedIndex];
            activeDino = JSON.parse(option.getAttribute('data-dino') || '{}');

            if (activeDino) {
                dinoId = activeDino.id;
                dinoName = activeDino.name;
                dinoLength = activeDino.length;
                dinoRealH = activeDino.cyberMetadata?.realHeight || 2.0;
                dinoRealL = activeDino.cyberMetadata?.realLength || 6.0;
                dinoSourceRes = activeDino.cyberMetadata?.sourceRes || 1024;

                // Mode-aware visual & scanning bounds
                if (currentMode === 'battle' && BATTLE_ASSETS[dinoId]) {
                    dinoImg.src = BATTLE_ASSETS[dinoId].image;
                    dinoContentH = BATTLE_ASSETS[dinoId].contentHeightPx;
                    dinoBottomGap = BATTLE_ASSETS[dinoId].bottomGap;
                    dinoImg.style.mixBlendMode = 'normal';
                } else {
                    dinoImg.src = `/images/cyber/${dinoId}.webp`;
                    dinoContentH = activeDino.cyberMetadata?.contentHeightPx || 450;
                    dinoBottomGap = activeDino.cyberMetadata?.bottomGap || 280;
                    dinoImg.style.mixBlendMode = 'screen';
                }

                dinoImg.alt = dinoName;
                if (currentMode === 'battle' && dinoId === 'tyrannosaurus') {
                    dinoTag.innerText = `${dinoName} / 腰高 4.0m（体高 4.5m / 全長 ${dinoLength}）`;
                } else if (dinoId === 'pteranodon') {
                    dinoTag.innerText = `${dinoName} / 直立高 3.0m（全長 ${dinoLength} / 翼開長 7.0m）`;
                } else {
                    dinoTag.innerText = `${dinoName} / 高さ ${formatVal(dinoRealH)}m（全長 ${dinoLength}）`;
                }

                // Update Stats HUD
                if (dinoHudSpecs) {
                    if (currentMode === 'battle' && dinoId === 'tyrannosaurus') {
                        dinoHudSpecs.innerText = `腰高4.0m(体高4.5m) / ${formatVal(dinoRealL)}m`;
                    } else {
                        dinoHudSpecs.innerText = `${formatVal(dinoRealH)}m / ${formatVal(dinoRealL)}m`;
                    }
                }

                // Update Detail Link
                if (dinoDetailLink) {
                    dinoDetailLink.href = `/dictionary/${dinoId}/`;
                }

                // Update Smart Card UI
                if (cardDinoImg) cardDinoImg.src = `/${activeDino.image || 'images/' + dinoId + '.webp'}`;
                if (cardDinoDiet) {
                    cardDinoDiet.innerText = activeDino.diet || '不明';
                    cardDinoDiet.setAttribute('data-diet', activeDino.diet || '');
                }
                if (cardDinoName) cardDinoName.innerText = dinoName;
                if (cardDinoScientific) cardDinoScientific.innerText = activeDino.scientificName ? `学名: ${activeDino.scientificName}` : '';
                if (cardDinoEra) cardDinoEra.innerText = activeDino.era || '--';
                if (cardDinoRegion) cardDinoRegion.innerText = activeDino.region || '--';
                if (cardDinoLength) cardDinoLength.innerText = dinoLength || '--';
                if (cardDinoWeight) cardDinoWeight.innerText = activeDino.weight || '--';
                if (cardDinoDesc) cardDinoDesc.innerText = activeDino.description || '詳細な生態や化石の発見エピソードは個別図鑑アーカイブにてご覧いただけます。';
                if (cardDinoDetailBtn) {
                    cardDinoDetailBtn.href = `/dictionary/${dinoId}/`;
                    cardDinoDetailBtn.innerHTML = `<span class="cta-arrow">▶</span> 「${dinoName}」の個別図鑑アーカイブを見る（全生態・化石写真へ）`;
                }

                // Update Related Special Topic
                updateRelatedTopic(activeDino);

                // Update Preset buttons active state
                updatePresetButtons(dinoId);

                // Sync URL query parameter & title
                updateUrlParams();

                // Recalculate zoom and trigger autofocus
                recalculateAutofocus();
            }
        }

        function updateSelectedAsset() {
            if (!selector || !refImg || !refTag) return;
            const option = selector.options[selector.selectedIndex];
            activeAsset = JSON.parse(option.getAttribute('data-asset') || '{}');
            
            if (activeAsset) {
                const isDinoTarget = !!activeAsset.isDino;

                // Orientation: face left if dinosaur target, otherwise standard translateX(-50%)
                if (isDinoTarget) {
                    refImg.style.setProperty('transform', 'translateX(-50%) scaleX(-1)', 'important');
                } else {
                    refImg.style.setProperty('transform', 'translateX(-50%)', 'important');
                }

                // Mode-aware visual & scanning bounds
                if (currentMode === 'battle' && isDinoTarget && BATTLE_ASSETS[activeAsset.id]) {
                    refImg.src = BATTLE_ASSETS[activeAsset.id].image;
                    activeAsset.contentHeightPx = BATTLE_ASSETS[activeAsset.id].contentHeightPx;
                    activeAsset.bottomGap = BATTLE_ASSETS[activeAsset.id].bottomGap;
                    refImg.style.mixBlendMode = 'normal';
                } else {
                    refImg.src = '/' + activeAsset.icon;
                    refImg.style.mixBlendMode = (activeAsset.id === 'human') ? 'normal' : 'screen';
                    if (isDinoTarget && activeAsset.rawDino?.cyberMetadata) {
                        activeAsset.contentHeightPx = activeAsset.rawDino.cyberMetadata.contentHeightPx;
                        activeAsset.bottomGap = activeAsset.rawDino.cyberMetadata.bottomGap;
                    }
                }

                refImg.alt = activeAsset.label;
                if (currentMode === 'battle' && activeAsset.id === 'tyrannosaurus') {
                    refTag.innerText = `${activeAsset.name} / 全長 ${formatVal(activeAsset.realLength)}m（腰高 4.0m / 体高 4.5m）`;
                } else if (activeAsset.id === 'pteranodon') {
                    refTag.innerText = `${activeAsset.name} / 直立高 3.0m（全長 ${formatVal(activeAsset.realLength)}m / 翼開長 7.0m）`;
                } else if (activeAsset.realLength) {
                    refTag.innerText = `${activeAsset.name} / 全長 ${formatVal(activeAsset.realLength)}m（高さ ${formatVal(activeAsset.realHeight)}m）`;
                } else {
                    refTag.innerText = `${activeAsset.name} / 高さ ${formatVal(activeAsset.realHeight)}m`;
                }

                // Sync URL query parameter & title
                updateUrlParams();

                // Recalculate zoom and trigger autofocus
                recalculateAutofocus();
            }
        }

        function recalculateAutofocus() {
            if (!stageContainer) return;
            if (activeAsset && activeDino) {
                const isMobile = window.innerWidth <= 768;

                const dinoDegenZoom = 1.0; // Enforce natural 1:1 scale ratio in simulator
                const marginFactor = 0.94;

                // 1. Calculate height-based target pxPerMeter
                // Let the tallest element (dino under zoom, or reference asset) fit vertically in the stage height (380px)
                const maxRealH = Math.max(dinoRealH * dinoDegenZoom, activeAsset.realHeight);
                const targetPxPerMeterH = (SAFE_ZONE_H * marginFactor) / maxRealH;

                // 2. Calculate width-based target pxPerMeter bounds to prevent overflow
                const ratioDino = dinoSourceRes / dinoContentH;
                const ratioRef = activeAsset.sourceRes / activeAsset.contentHeightPx;

                const C_dino = dinoRealH * dinoDegenZoom * ratioDino; // dino width per pxPerMeter unit
                const C_ref = activeAsset.realHeight * ratioRef;     // ref asset width per pxPerMeter unit

                const stageW = stageContainer.clientWidth || SAFE_ZONE_W;
                
                const gap = isMobile ? -20 : 80;
                const leftMargin = isMobile ? 45 : 60;
                const rightMargin = isMobile ? 15 : 80;
                const maxSpan = stageW - rightMargin - leftMargin;

                let targetPxPerMeter = targetPxPerMeterH;
                if (maxSpan > gap) {
                    const maxPxPerMeterW = (maxSpan - gap) / (C_dino + C_ref);
                    if (targetPxPerMeter > maxPxPerMeterW) {
                        targetPxPerMeter = maxPxPerMeterW;
                    }
                }

                // targetZoom represents the direct target pxPerMeter
                targetZoom = targetPxPerMeter;

                // If currentZoom is fresh, snap to it immediately to prevent initial jump
                if (currentZoom === 1.0 && targetZoom !== 1.0) {
                    currentZoom = targetZoom;
                }

                startZoomAnimation();
            }
        }

        function startZoomAnimation() {
            if (animationFrameId !== null) {
                cancelAnimationFrame(animationFrameId);
            }

            function step() {
                const diff = targetZoom - currentZoom;
                
                if (Math.abs(diff) < 0.001) {
                    currentZoom = targetZoom;
                    renderStage();
                    animationFrameId = null;
                } else {
                    currentZoom += diff * 0.08; // smooth lerp step
                    renderStage();
                    animationFrameId = requestAnimationFrame(step);
                }
            }

            animationFrameId = requestAnimationFrame(step);
        }

        function renderStage() {
            if (!activeAsset || !stageContainer || !dinoImg || !refImg || !dinoEl || !refEl || !grid) return;

            const isMobile = window.innerWidth <= 768;
            const baselinePx = isMobile ? 45 : 25;

            // Dynamic bottom adjustment for baseline ground line, ruler container, and specimens
            const baselineLine = document.querySelector('.baseline-line') as HTMLElement;
            const rulerY = document.querySelector('.ruler-y') as HTMLElement;
            if (baselineLine) baselineLine.style.bottom = `${baselinePx}px`;
            if (rulerY) rulerY.style.bottom = `${baselinePx}px`;
            if (dinoEl) dinoEl.style.bottom = `${baselinePx}px`;
            if (refEl) refEl.style.bottom = `${baselinePx}px`;

            // 1. pxPerMeter is directly represented by currentZoom
            const pxPerMeter = currentZoom;
            const dinoDegenZoom = 1.0; // Enforce natural 1:1 scale ratio in simulator

            // Padding lookup table (pixels of transparent margins out of 1024px canvas)
            const paddingTable: Record<string, { left: number; right: number }> = {
                compsognathus: { left: 44, right: 37 },
                brachiosaurus: { left: 54, right: 44 },
                tyrannosaurus: { left: 29, right: 31 },
                ankylosaurus: { left: 20, right: 20 },
                mosasaurus: { left: 22, right: 22 },
                pteranodon: { left: 22, right: 22 },
                sinoceratops: { left: 196, right: 162 },
                human: { left: 329, right: 328 },
                car: { left: 11, right: 8 },
                elephant: { left: 70, right: 60 },
                whale: { left: 42, right: 45 },
                airplane: { left: 55, right: 19 },
                styxosaurus: { left: 61, right: 30 },
                thalassodromeus: { left: 249, right: 147 }
            };

            // 3. Calculate Dino Specimen Size (using realHeight * zoom as height)
            const dinoTargetH = dinoRealH * dinoDegenZoom * pxPerMeter;
            const dinoScale = dinoTargetH / dinoContentH;
            const dinoTotalH = dinoSourceRes * dinoScale;
            const dinoOffset = dinoBottomGap * dinoScale;

            const dinoPads = paddingTable[dinoId] || { left: 0, right: 0 };
            const refPads = paddingTable[activeAsset.id] || { left: 0, right: 0 };

            const dino_l_pad = dinoPads.left * dinoScale;
            const dino_r_pad = dinoPads.right * dinoScale;
            const dinoVisualW = dinoTotalH - dino_l_pad - dino_r_pad;

            // 4. Calculate Reference Target Size
            const refTargetH = activeAsset.realHeight * pxPerMeter;
            const refScale = refTargetH / activeAsset.contentHeightPx;
            const refTotalH = activeAsset.sourceRes * refScale;
            const refOffset = activeAsset.bottomGap * refScale;

            const ref_l_pad = refPads.left * refScale;
            const ref_r_pad = refPads.right * refScale;
            const refVisualW = refTotalH - ref_l_pad - ref_r_pad;

            // Apply size styling
            dinoImg.style.height = `${dinoTotalH}px`;
            dinoImg.style.bottom = `-${dinoOffset}px`;
            dinoImg.style.marginBottom = '0px';

            refImg.style.height = `${refTotalH}px`;
            refImg.style.bottom = `-${refOffset}px`;
            refImg.style.marginBottom = '0px';

            // Sync ref orientation: face left when confronting dinosaur, standard translateX(-50%) for reference assets
            if (activeAsset && activeAsset.isDino) {
                refImg.style.setProperty('transform', 'translateX(-50%) scaleX(-1)', 'important');
            } else {
                refImg.style.setProperty('transform', 'translateX(-50%)', 'important');
            }

            // 5. Position elements dynamically to be centered as a pair in the stage
            const stageW = stageContainer.clientWidth || SAFE_ZONE_W;
            
            const gap = isMobile ? -20 : 80;
            const leftMargin = isMobile ? 45 : 60;
            const rightMargin = isMobile ? 15 : 80;
            
            const visualSpan = dinoVisualW + gap + refVisualW;

            // Determine left edge of dinosaur illustration (centered, but at least leftMargin to not overlap ruler)
            const dinoVisualLeft = Math.max(leftMargin + dino_l_pad, (stageW - visualSpan) / 2);

            // Compute corresponding dinoLeft style value
            const dinoLeftEdge = dinoVisualLeft - dino_l_pad;
            const dinoLeft = dinoLeftEdge - 150 + (dinoTotalH / 2);
            dinoEl.style.left = `${dinoLeft}px`;

            // Compute corresponding refLeft style value
            const refVisualLeft = dinoVisualLeft + dinoVisualW + gap;
            let refLeftEdge = refVisualLeft - ref_l_pad;

            // Clamp refLeftEdge to prevent reference illustration from overflowing the right edge of the stage
            refLeftEdge = Math.min(refLeftEdge, stageW - rightMargin - refTotalH + ref_r_pad);
            let refLeft = refLeftEdge - 100 + (refTotalH / 2);

            refEl.style.right = 'auto';
            refEl.style.left = `${refLeft}px`;

            // Dynamic panel height adjustment for mobile to prevent huge top empty spaces
            if (isMobile) {
                const maxIllustH = Math.max(dinoTargetH, refTargetH);
                const minPanelH = 200;
                const maxPanelH = PANEL_HEIGHT; // 405
                let neededPanelH = maxIllustH + baselinePx + 30; // height + baselinePx + padding
                neededPanelH = Math.max(minPanelH, Math.min(maxPanelH, neededPanelH));
                stageContainer.style.height = `${neededPanelH}px`;
            } else {
                stageContainer.style.height = `${PANEL_HEIGHT}px`;
            }

            // Offset label vertical positions on mobile to prevent overlapping
            if (isMobile && dinoTag && refTag) {
                dinoTag.style.bottom = '-18px';
                refTag.style.bottom = '-34px';
            } else {
                if (dinoTag) dinoTag.style.bottom = '-20px';
                if (refTag) refTag.style.bottom = '-20px';
            }

            // 5. Render dynamic HUD Grid (1 square = 1 meter)
            const gridPx = pxPerMeter;
            grid.style.backgroundSize = `${gridPx}px ${gridPx}px`;

            // 6. Render Y-axis ruler ticks
            renderRuler(pxPerMeter);
        }

        function renderRuler(pxPerMeter: number) {
            if (!ruler) return;
            ruler.innerHTML = '';
            
            const currentStageH = stageContainer ? stageContainer.clientHeight : PANEL_HEIGHT;
            const isMobile = window.innerWidth <= 768;
            const baselinePx = isMobile ? 45 : 25;
            const visibleSafeZoneH = currentStageH - baselinePx;

            // Calculate maximum height in meters visible on the stage based on dynamic heights
            const maxMeters = visibleSafeZoneH / pxPerMeter;

            // Determine appropriate step based on max visible meters (more granular ticks)
            let step = 1.0;
            if (maxMeters <= 1.5) {
                step = 0.2;
            } else if (maxMeters <= 3.5) {
                step = 0.5;
            } else if (maxMeters <= 8.0) {
                step = 1.0;
            } else if (maxMeters <= 16.0) {
                step = 2.0;
            } else {
                step = 5.0;
            }

            // Draw ticks using count to avoid float precision issues
            const ticksCount = Math.ceil(maxMeters / step) + 1;
            for (let i = 0; i <= ticksCount; i++) {
                const m = i * step;
                const pxVal = m * pxPerMeter;
                if (pxVal > visibleSafeZoneH + 10) break; // Don't overflow container top too much

                const tick = document.createElement('div');
                tick.style.position = 'absolute';
                tick.style.bottom = `${pxVal}px`;
                tick.style.right = '0';
                tick.style.width = '100%';
                tick.style.borderBottom = '1px solid rgba(0, 242, 255, 0.4)';
                tick.style.paddingBottom = '2px';
                tick.style.textAlign = 'right';
                
                // Show fractional digits if step has decimal
                const decimals = step % 1 === 0 ? 0 : 1;
                tick.innerHTML = `<span style="color: var(--secondary-neon); font-weight: bold;">${m.toFixed(decimals)}m</span>`;
                
                ruler.appendChild(tick);
            }
        }

        // Initialize on astro page load
        document.addEventListener('astro:page-load', initPrototype);
    </script>

