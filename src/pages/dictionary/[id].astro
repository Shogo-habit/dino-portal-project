                            <h1 class="detail-title" style="margin-bottom: 4px;">{d.name}</h1>
                            <p class="detail-scientific" style="margin-bottom: 0;">[ {d.scientificName} ]</p>
                        </div>
                        <button class="save-btn" id="observe-save-btn" aria-label="図鑑に保存" data-id={d.id}>
                            + 観測データに保存
                        </button>
                    </div>
                </header>

                {nonDinoNotice && (
                    <aside class="non-dino-notice-banner hud-panel" aria-label="生物分類情報" style="margin-bottom: 20px; padding: 14px 18px; border: 1px solid rgba(0, 242, 255, 0.35); background: rgba(0, 242, 255, 0.04); border-radius: 4px; position: relative;">
                        <div class="hud-corner top-left" style="border-top-color: var(--primary-neon); border-left-color: var(--primary-neon);"></div>
                        <div class="hud-corner bottom-right" style="border-bottom-color: var(--primary-neon); border-right-color: var(--primary-neon);"></div>
                        <div style="display: flex; gap: 12px; align-items: flex-start;">
                            <span style="font-size: 20px; line-height: 1.2; flex-shrink: 0;" aria-hidden="true">{nonDinoNotice.icon}</span>
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px; flex-wrap: wrap;">
                                    <span style="font-family: var(--font-mono); font-size: 10px; color: var(--primary-neon); background: rgba(0, 242, 255, 0.15); border: 1px solid var(--primary-neon); padding: 1px 6px; border-radius: 2px; font-weight: bold;">
                                        {nonDinoNotice.badge}
                                    </span>
                                    <strong style="font-size: 13px; color: #fff; letter-spacing: 0.5px;">{nonDinoNotice.title}</strong>
                                </div>
                                <p style="font-size: 12px; color: var(--text-dim); line-height: 1.6; margin: 0 0 8px 0;">
                                    {nonDinoNotice.desc}
                                </p>
                                <div>
                                    <a href={nonDinoNotice.linkUrl} style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; gap: 4px; transition: opacity 0.2s;">
                                        <span>{nonDinoNotice.linkText}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </aside>
                )}

                <div class="hud-panel" style="padding: 16px 20px; margin-bottom: 20px; background: rgba(0, 242, 255, 0.02); border-color: rgba(0, 242, 255, 0.2);">
                    <p style="line-height: 1.7; font-size: 14px; margin: 0; color: var(--text-main);">{d.description}</p>
                </div>

                <!-- 基本スペック表 -->
                <div class="hud-panel" style="padding: 20px; border-color: rgba(0, 242, 255, 0.2); position: relative;">
                    <div class="hud-corner top-left" style="border-top-color: rgba(0, 242, 255, 0.35); border-left-color: rgba(0, 242, 255, 0.35);"></div>
                    <div class="hud-corner bottom-right" style="border-bottom-color: rgba(0, 242, 255, 0.35); border-right-color: rgba(0, 242, 255, 0.35);"></div>
                    <h2 style="border-bottom: 1px solid var(--panel-border); padding-bottom: 8px; margin-bottom: 15px; color: var(--primary-neon); font-size: 13px; font-weight: bold; letter-spacing: 1px; font-family: var(--font-mono);">
                        [ 基本スペック・生息環境 ]
                    </h2>
                    <div class="spec-panel" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 15px 0;">
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">生息年代</span><br>
                            <a href={`/dictionary/?era=${encodeURIComponent(baseEra)}`} class="spec-link" title={`「${baseEra}」の恐竜一覧を見る`}>{d.era}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">生息地域</span><br>
                            <a href={`/dictionary/?region=${encodeURIComponent(baseRegion)}`} class="spec-link" title={`「${baseRegion}」の恐竜一覧を見る`}>{d.region}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">分類</span><br>
                            <a href={`/dictionary/?group=${encodeURIComponent(d.group)}`} class="spec-link" title={`「${d.group}」の恐竜一覧を見る`}>{d.group}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">食性</span><br>
                            <a href={`/dictionary/?diet=${encodeURIComponent(d.diet)}`} class="spec-link" title={`「${d.diet}」の恐竜一覧を見る`}>{d.diet}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;"><span class="spec-label">全長</span><br>{d.length}</div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;"><span class="spec-label">推定体重</span><br>{d.weight}</div>
                    </div>

                    <!-- 生物学的特性 -->
                    {d.bioTraits && d.bioTraits.length > 0 && (
                        <div style="border-top: 1px dashed rgba(0, 242, 255, 0.15); padding-top: 12px;">
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                {d.bioTraits.map(t => (
                                    <div style="font-size: 12.5px; line-height: 1.5; color: var(--text-main);">
                                        <strong style="color: var(--primary-neon); font-family: var(--font-mono); margin-right: 6px;">{t.trait}</strong>
                                        <span style="color: var(--text-dim); margin-right: 6px;">:</span>
                                        <span>{t.detail}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </section>

        <!-- 2. 詳細解説エリア（中央本文 ＋ 左右HUDサイドレール：実寸比較パネルは「02」直下にインライン配置） -->
        <section class={`opt1-article-section ${h3List.length === 0 ? 'no-toc' : ''}`} id="article-section">
            
            <!-- [左サイドレール: Sticky 目次ナビゲーション & 縦型スキャン目盛り] -->
            {h3List.length > 0 && (
                <aside class="opt1-side-rail left-rail">
                    <div class="rail-sticky-wrap">
                        <div class="hud-rail-panel">
                            <div class="hud-corner top-left"></div>
                            <div class="hud-corner bottom-right"></div>
                            <div class="rail-header">
                                <span class="rail-dot"></span>
                                <span>INDEX // 目次</span>
                            </div>
                            <nav class="hud-toc-list" id="hud-toc-nav">
                                {h3List.map((h, idx) => (
                                    <a href={`#${h.id}`} class={`hud-toc-item ${idx === 0 ? 'active' : ''}`} data-target={h.id}>
                                        <span class="toc-indicator"></span>
                                        <span class="toc-num">{String(idx + 1).padStart(2, '0')}</span>
                                        <span class="toc-text">{h.cleanText}</span>
                                    </a>
                                ))}
                            </nav>
                        </div>

                        <!-- 縦型サイバー読了進捗ゲージ (SCAN DEPTH) -->
                        <div class="hud-vertical-gauge">
                            <div class="gauge-label-row">
                                <span class="gauge-label">SCAN DEPTH</span>
                                <span class="gauge-val" id="scan-depth-val">00%</span>
                            </div>
                            <div class="gauge-bar-track">
                                <div class="gauge-bar-fill" id="scan-depth-bar"></div>
                            </div>
                            <div class="gauge-desc">読了進捗ステータス</div>
                        </div>
                    </div>
                </aside>
            )}

            <!-- [中央: 本文メインカラム] -->
            <div class="opt1-article-main" id="sec-body">
                <div class="hud-panel opt1-content-card">
                    <div class="hud-corner top-left"></div>
                    <div class="hud-corner bottom-right"></div>
                    
                    <h2 class="opt1-article-heading">
                        <span class="opt1-heading-icon">&#9632;</span>
                        [ 詳細解説・生態データアーカイブ ]
                    </h2>

                    <div class="archival-content opt1-typography">
                        <!-- 本文 前半パート -->
                        <Fragment set:html={contentPart1} />

                        <!-- ★ 人間との実寸サイズ比較パネル (セクション02直下に静的インライン配置) ★ -->
                        {hasComparison && (
                            <div id="opt1-inline-comparison" class="opt1-inline-comparison-box">
                                <div class="opt1-inline-header">
                                    <div class="opt1-inline-title">
                                        <span class="opt1-inline-heading-text">人間（身長1.7m）との体格差ビジュアル比較</span>
                                    </div>
                                    <a href={hasComparison ? `/size-comparison/?dino=${d.id}` : "/size-comparison/"} class="opt1-sim-link">
                                        [ サイズ比較シミュレータで人・車・ゾウと比較する ] &raquo;
                                    </a>
                                </div>

                                <div class="size-comparison-panel hud-panel opt1-comparison-frame">
                                    <svg viewBox="0 0 650 400" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="display: block; overflow: visible;" role="img" aria-labelledby={`svg-title-${d.id} svg-desc-${d.id}`}>
                                        <title id={`svg-title-${d.id}`}>{d.name}と人間（1.7m）の実寸1:1サイズ比較骨格図</title>
                                        <desc id={`svg-desc-${d.id}`}>{d.name}（全長 {d.length}、全高 {formatVal(d.cyberMetadata?.realHeight || 0)}m）と標準的な人間（身長 1.7m）の精密なスケール比較グラフィックです。</desc>
                                        <defs>
                                            <pattern id="hud-grid-minor-opt1" width="20" height="20" patternUnits="userSpaceOnUse">
                                                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0, 242, 255, 0.04)" stroke-width="1"/>
                                            </pattern>
                                            <pattern id="hud-grid-major-opt1" width="100" height="100" patternUnits="userSpaceOnUse">
                                                <path d="M 100 0 L 0 0 0 100" fill="none" stroke="rgba(0, 242, 255, 0.15)" stroke-width="1.5"/>
                                            </pattern>
                                        </defs>
                                        
                                        <rect width="650" height="400" fill="url(#hud-grid-minor-opt1)" />
                                        <rect width="650" height="400" fill="url(#hud-grid-major-opt1)" />
                                        
                                        <line x1="0" y1="315" x2="650" y2="315" stroke="rgba(0, 242, 255, 0.3)" stroke-width="1.5" stroke-dasharray="4,4" />
                                        
                                        {dinoNeedFlip ? (
                                            <g transform={`translate(${dinoX * 2 + dinoW}, 0) scale(-1, 1)`}>
                                                <image href={`/images/cyber/${d.id}.webp`} x={dinoX} y={dinoY} width={dinoW} height={dinoH} class="cyber-hud-specimen" />
                                            </g>
                                        ) : (
                                            <image href={`/images/cyber/${d.id}.webp`} x={dinoX} y={dinoY} width={dinoW} height={dinoH} class="cyber-hud-specimen" />
                                        )}
                                        <image href="/images/cyber/human_front.webp" x={refX} y={refY} width={refW} height={refH} />
                                        
                                        <g transform={`translate(${dinoTagX}, ${isLabelConflict ? 377 : 350})`}>
                                            <rect x="-105" y="-12" width="210" height="30" fill="rgba(0, 10, 20, 0.75)" stroke="rgba(0, 242, 255, 0.25)" stroke-width="1" rx="3" />
                                            <line x1="0" y1="-25" x2="0" y2="-12" stroke="rgba(0, 242, 255, 0.2)" stroke-width="1" stroke-dasharray="2,2" />
                                            <text text-anchor="middle" fill="#00f2ff" font-size="11.5" font-family="var(--font-mono)" font-weight="bold">{d.name}</text>
                                            <text text-anchor="middle" fill="#00f2ff" font-size="9" opacity="0.8" font-family="var(--font-mono)" y="13">
                                                {d.id === 'pteranodon' ? '全長 3.5m（翼開長 7.0m）' :
                                                 d.id === 'quetzalcoatlus' ? '全長 5.9m（翼開長 11.0m）' :
                                                 `全長 ${d.length}`}
                                            </text>
                                        </g>
                                        
                                        <g transform={`translate(${refX + refW/2}, 350)`}>
                                            <rect x="-55" y="-12" width="110" height="30" fill="rgba(0, 10, 20, 0.75)" stroke="rgba(0, 242, 255, 0.25)" stroke-width="1" rx="3" />
                                            <line x1="0" y1="-25" x2="0" y2="-12" stroke="rgba(0, 242, 255, 0.2)" stroke-width="1" stroke-dasharray="2,2" />
                                            <text text-anchor="middle" fill="#00f2ff" font-size="11.5" font-family="var(--font-mono)" font-weight="bold">人間</text>
                                            <text text-anchor="middle" fill="#00f2ff" font-size="9" opacity="0.8" font-family="var(--font-mono)" y="13">身長 1.7m</text>
                                        </g>
                                    </svg>
                                </div>
                                <div class="opt1-inline-caption">
                                    ※ 上記グラフィックは学術的推定値（骨格比率1:1）に基づき、人間（1.7m）と並んだ際の実際の体格差を視覚化したものです。
                                </div>
                            </div>
                        )}

                        <!-- 本文 後半パート -->
                        {contentPart2 && <Fragment set:html={contentPart2} />}
                    </div>

                    <!-- 関連特集への文脈アンカー導線（その恐竜の生態・学説特集がある場合のみ表示） -->
                    {deepDiveTopic && (
                        <div class="contextual-topic-banner hud-panel" style="margin-top: 35px; padding: 14px 18px; border-left: 3px solid var(--primary-neon); background: rgba(0, 242, 255, 0.04); border-color: rgba(0, 242, 255, 0.25);">
                            <a href={`/topics/${deepDiveTopic.id}/`} style="color: var(--text-main); text-decoration: none; font-size: 13.5px; display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; line-height: 1.6;">
                                <span>{d.name}の生態・最新学説をさらに詳しく知る：</span>
                                <strong style="color: var(--primary-neon); text-decoration: underline;">『{deepDiveTopic.title}』</strong>
                                <span style="color: var(--primary-neon); font-family: var(--font-mono); font-size: 12px;">&raquo;</span>
                            </a>
                        </div>
                    )}

                    <!-- 特集ランキングへの文脈アンカー導線（サイズ比較や最強ランキング選出種に表示） -->
                    {rankingTopic && (
                        <div class="contextual-ranking-banner hud-panel" style="margin-top: 20px; padding: 14px 18px; border-left: 3px solid #ffcc00; background: rgba(255, 204, 0, 0.04); border-color: rgba(255, 204, 0, 0.25);">
                            <a href={`/topics/${rankingTopic.id}/`} style="color: var(--text-main); text-decoration: none; font-size: 13.5px; display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; line-height: 1.6;">
                                <span style="color: #ffcc00; font-weight: bold; font-family: var(--font-mono); font-size: 11px;">[ 🏆 RANKING ENTRY ]</span>
                                <span>{d.name}が登場する特集：</span>
                                <strong style="color: #ffcc00; text-decoration: underline;">『{rankingTopic.title}』</strong>
                                <span style="color: #ffcc00; font-family: var(--font-mono); font-size: 12px;">&raquo;</span>
                            </a>
                        </div>
                    )}
                </div>

                <!-- よくある質問（FAQ） -->
                <div class="geo-faq-section" id="sec-faq" style="margin-top: 40px;" itemscope itemtype="https://schema.org/FAQPage">
                    <h2 style="color: var(--primary-neon); margin-bottom: 18px; font-size: 15px; font-family: var(--font-mono); letter-spacing: 1px; font-weight: bold;">
                        [ よくある質問（FAQ） ]
                    </h2>
                    {faqs.map((faq, idx) => (
                        <details class="faq-item hud-panel" open={idx === 0} style="margin-bottom: 12px;" itemprop="mainEntity" itemscope itemtype="https://schema.org/Question">
                            <summary class="faq-summary" style="cursor: pointer; padding: 12px 16px; color: var(--primary-neon); font-weight: bold; font-size: 14px;" itemprop="name">{faq.q}</summary>
                            <div class="faq-content" style="padding: 14px 16px; line-height: 1.7; font-size: 14px; border-top: 1px solid var(--panel-border);" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
                                <span itemprop="text">{faq.a}</span>
                            </div>
                        </details>
                    ))}
                </div>

                <!-- アーカイブに戻る ＆ 前後クイックナビ ＆ フィードバック -->
                <div class="detail-quick-nav-bar" style="margin-top: 40px; border-top: 1px solid var(--panel-border); padding-top: 20px; display: flex; flex-direction: column; gap: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <div class="quick-nav-links" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                            <a href={`/dictionary/${prevDino.id}/`} class="quick-nav-pill" title={`五十音順で前の恐竜: ${prevDino.name}（${prevDino.kana}）`}>
                                <span style="font-size: 10px; color: var(--primary-neon); opacity: 0.8;">&laquo; 前</span>
                                <span class="pill-name">{prevDino.name}</span>
                            </a>
                            <a href="/dictionary/" id="back-to-archive-link" class="nav-link" aria-label="アーカイブ一覧に戻る" style="text-decoration: none; font-size: 12px;">[ アーカイブ一覧 ]</a>
                            <a href={`/dictionary/${nextDino.id}/`} class="quick-nav-pill" title={`五十音順で次の恐竜: ${nextDino.name}（${nextDino.kana}）`}>
                                <span class="pill-name">{nextDino.name}</span>
                                <span style="font-size: 10px; color: var(--primary-neon); opacity: 0.8;">次 &raquo;</span>
                            </a>
                        </div>
                        
                        <div class="feedback-container" id="feedback-detail" style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 11px; color: var(--text-dim); font-family: var(--font-mono);">
                                期待したデータは得られましたか？
                            </span>
                            <button class="feedback-btn" id="feedback-yes" aria-label="はい">YES</button>
                            <button class="feedback-btn" id="feedback-no" aria-label="いいえ">NO</button>
                            <div class="feedback-msg" id="msg-detail" style="font-size: 11px; color: var(--secondary-neon); font-family: var(--font-mono); opacity: 0; transition: opacity 0.3s ease; position: absolute; margin-top: 25px;"></div>
                        </div>
                    </div>
                </div>

                <!-- 学術参考文献 (E-E-A-T) -->
                {d.references && d.references.length > 0 && (
                    <div class="references-panel hud-panel" id="sec-refs" style="margin-top: 40px; padding: 25px; border-color: rgba(0, 242, 255, 0.15); position: relative;">
                        <div class="hud-corner top-left"></div>
                        <div class="hud-corner bottom-right"></div>
                        <h2 style="border-bottom: 1px solid var(--panel-border); padding-bottom: 10px; margin-bottom: 15px; color: var(--primary-neon); font-size: 14px; font-family: var(--font-mono); letter-spacing: 1px; font-weight: bold;">
                            [ 学術参考文献 ]
                        </h2>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
                            {d.references.map((ref: any) => (
                                <li style="border-left: 2px solid var(--primary-neon); padding-left: 15px;">
                                    <div style="font-weight: bold; color: var(--text-main); font-size: 14px;">{ref.title}</div>
                                    <div style="font-size: 12px; color: var(--text-dim); margin-top: 4px;">
                                        <span>{ref.journal}</span> &bull; <span>{ref.year}</span>
                                    </div>
                                    <a href={ref.url} target="_blank" rel="noopener noreferrer" style="display: inline-block; font-size: 11px; color: var(--primary-neon); text-decoration: none; margin-top: 6px; font-family: var(--font-mono);">
                                        [ 論文・文献リンク ] &raquo;
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </div>

            <!-- [右サイドレール: サイバー骨格透かしアート ＆ HUDテレメトリ] -->
            <aside class="opt1-side-rail right-rail">
                <div class="rail-sticky-wrap">
                    
                    <!-- サイバー骨格透かしアートカード -->
                    <div class="hud-specimen-watermark-card">
                        <div class="watermark-graphic-wrap">
                            {hasComparison ? (
                                <img src={`/images/cyber/${d.id}.webp`} alt="" class="watermark-specimen-img" />
                            ) : (
                                <img src={`/${d.image}`} alt="" class="watermark-specimen-img" style="filter: brightness(0.7) contrast(1.2) drop-shadow(0 0 15px rgba(0,242,255,0.3));" />
                            )}
                            <div class="watermark-reticle"></div>
                        </div>
                        <div class="watermark-meta">
                            <div class="watermark-tag">[ SPECIMEN ANALYSIS ]</div>
                            <div class="watermark-name">{d.scientificName}</div>
                            <div class="watermark-status">{hasComparison ? '● 1:1 SCALE VERIFIED' : '● ARCHIVAL SPECIMEN'}</div>
                        </div>
                    </div>

                    <!-- HUD テレメトリパネル -->
                    <div class="hud-telemetry-panel">
                        <div class="hud-corner top-left"></div>
                        <div class="hud-corner bottom-right"></div>
                        <div class="telemetry-header">SYSTEM TELEMETRY</div>
                        <div class="telemetry-row">
                            <span class="t-label">SCALE RATIO</span>
                            <span class="t-val">{hasComparison ? '1:1 EXACT' : 'DATA RECORDED'}</span>
                        </div>
                        <div class="telemetry-row">
                            <span class="t-label">ERA DEPTH</span>
                            <span class="t-val">{d.era}</span>
                        </div>
                        <div class="telemetry-row">
                            <span class="t-label">GEOMATRIX</span>
                            <span class="t-val">{d.region}</span>
                        </div>
                        <div class="telemetry-row">
                            <span class="t-label">DIET CLASS</span>
                            <span class="t-val">{d.diet}</span>
                        </div>
                        <div class="telemetry-grid-canvas"></div>
