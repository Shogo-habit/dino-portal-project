---
import Layout from '../../layouts/Layout.astro';
import AffiliateSection from '../../components/AffiliateSection.astro';
import { REFERENCE_ASSETS } from '../../data/cyberAssets';
import { RIGHT_FACING_SKELETONS } from '../../data/skeletonFacing';
import { AUTHOR_DATA } from '../../data/author';
import { getCollection, render } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dinosaurEntries = await getCollection('dinosaurs');
  return dinosaurEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { data: d } = entry;
const allDinosaurs = (await getCollection('dinosaurs')).map(entry => entry.data);

// 1. FAQ Generation Logic for SEO/GEO
// 学術的最新知見・検索意図特化型FAQマスター
const ACADEMIC_FAQS: Record<string, Array<{ q: string; a: string }>> = {
    tyrannosaurus: [
        {
            q: "ティラノサウルスには本当に羽毛が生えていたのですか？",
            a: "成体のティラノサウルスの皮膚印象化石（標本「ワイレックス」など）の調査により、首、腰、尾などの大部分がウロコで覆われていたことが判明しています。幼体期には体温保持用の綿羽が生えていた可能性がありますが、成体は巨体による熱放散（慣性恒温性）の観点からも、全身が厚い羽毛で覆われていたわけではないという見解が現代古生物学の定説です。"
        },
        {
            q: "ティラノサウルスの噛む力（咬合力）はどのくらい強かったのですか？",
            a: "生体力学解析によると、ティラノサウルスの咬合力は約35,000〜57,000ニュートン（約3.5〜5.8トン以上）と算出されています。これはトリケラトプス等の分厚い骨を粉砕して骨髄ごと摂取できる破骨性の破壊力であり、地球上の陸生肉食動物として史上最強クラスです。"
        }
    ],
    spinosaurus: [
        {
            q: "スピノサウルスは水中で泳いでいたのですか？（最新の半水生適応説）",
            a: "2020年に発見されたオール状の平たく幅広な尾椎化石や、骨密度（オステオスクレローシス）の極めて高い骨格構造の研究により、スピノサウルスが遊泳して獲物を追う「半水生の捕食者」であったことが学術的に強く支持されています。水辺に依存し、巨大な魚類（オンコプリスティス等）を主食としていました。"
        },
        {
            q: "スピノサウルスの背中の大きな帆にはどのような役割がありましたか？",
            a: "かつては体温調節（熱交換ラジエーター）が主目的と考えられていましたが、帆の骨の血管網や近縁種の比較から、同種間での誇示（ディスプレイ）や威嚇、あるいは水中での横ブレを防ぐ方向安定板（キール）のような役割を果たしていた可能性が有力視されています。"
        }
    ],
    triceratops: [
        {
            q: "トリケラトプスの巨大なフリルと3本の角は何に使われていましたか？",
            a: "ティラノサウルス等の捕食者に対する防御・刺突武器としての機能に加え、フリルの骨に残る同種間の角による傷跡化石から、繁殖期におけるオス同士の儀礼的闘争やディスプレイ（求愛・個体識別）に重要な役割を果たしていたことが明らかになっています。"
        }
    ],
    velociraptor: [
        {
            q: "ヴェロキラプトルには本当に羽毛が生えていましたか？映画との違いは？",
            a: "はい。前肢（尺骨）の化石に羽軸が付着する窪み「羽柄突起（Quill knobs）」が発見されており、現生鳥類と同様の本物の風切羽が生えていたことが確証されています。また、実物は体長約2m・腰高約50cm・体重15kg前後と小型で敏捷な羽毛恐竜であり、映画等の描写（デイノニクス大）とはサイズ感も異なります。"
        }
    ],
    stegosaurus: [
        {
            q: "ステゴサウルスの背中の骨板はどのように並んでいて、何のためにありましたか？",
            a: "ステゴサウルスの骨板は骨格に癒合しておらず皮膚に埋もれており、背中に互い違い（互生）の2列で並んでいました。内部に微細な血管網が走っていることから体温調節機能を持つとともに、血管を充血させて赤くフラッシュさせ威嚇や求愛を行うディスプレイ装置として機能していたと考えられています。"
        }
    ],
    brachiosaurus: [
        {
            q: "ブラキオサウルスは首をまっすぐ垂直に持ち上げることができましたか？",
            a: "ブラキオサウルスは前肢が後肢よりも著しく長いため、自然な骨格姿勢で肩が高く首が斜め上方に伸びていました。近年の頸椎（首の骨）の可動域解析によると、真上（垂直90度）まで反らすことは困難でしたが、斜め45〜60度程度の高木の葉を効率よく摂食するのに最適化されていたとされます。"
        }
    ],
    ankylosaurus: [
        {
            q: "アンキロサウルスの尾のハンマーはティラノサウルスの骨を折ることができましたか？",
            a: "生体力学シミュレーションによると、尾の先端にある骨質の塊（テールクラブ）をフルスイングした際の衝撃力は数千ニュートンを超え、ティラノサウルスなどの大型肉食恐竜の脛骨（すねの骨）を骨折させるのに十分な破壊力を持っていたと算出されています。"
        }
    ],
    pachycephalosaurus: [
        {
            q: "パキケファロサウルスは頭同士で本当に激突（頭突き）していたのですか？",
            a: "厚さ20cm以上に達するドーム状頭頂骨のCTスキャンにより、慢性骨髄炎や激突による治癒痕（化石病理）が多数発見されています。現代のオオツノヒツジのように、頭部や胴体側面を激しくぶつけ合って群れの順位や繁殖権を争っていたことが学術的に強く支持されています。"
        }
    ],
    argentinosaurus: [
        {
            q: "アルゼンチノサウルスの超巨体（70〜100トン超）を支える仕組みはどうなっていたのですか？",
            a: "アルゼンチノサウルスは脊椎骨の内部に空気の袋（気嚢）を取り込むことで骨格を極限まで軽量化し、自重による圧壊を防いでいました。また、巨大な心臓と超高血圧によって長い首の先にある脳まで血液を循環させていたと考えられています。"
        }
    ],
    mosasaurus: [
        {
            q: "モササウルスは恐竜ですか？それとも別の生き物ですか？",
            a: "モササウルスは恐竜ではなく、現代のオオトカゲやヘビに極めて近縁な「海生有鱗類（爬虫類）」です。二重関節の顎や鋭い歯、二叉の舌を持っていた可能性が高く、白亜紀後期の海洋生態系の頂点捕食者として君臨しました。"
        }
    ],
    allosaurus: [
        {
            q: "アロサウルスはティラノサウルスと狩りの方法がどのように違いますか？",
            a: "ティラノサウルスが強力な顎圧で骨ごと噛み砕くスタイルだったのに対し、アロサウルスは発達した3本指の前肢カギ爪と、上顎を斧のように獲物に打ち下ろして肉を切り裂く「ハチェット（手斧）ストライク」と呼ばれる狩猟スタイルをとっていたと考えられています。"
        }
    ],
    quetzalcoatlus: [
        {
            q: "ケツァルコアトルスのようなキリン大の巨体で本当に空を飛べたのですか？",
            a: "翼開長10〜11mに達しますが、骨格が極限まで中空化・軽量化されており体重は約200〜250kgでした。前肢と後肢の両方を使って地面を強く蹴り上げる「四肢跳躍（クアドラペダル・ローンチ）」によって離陸し、強力な滑空能力と上昇気流を利用して長距離を飛行できました。"
        }
    ],
    giganotosaurus: [
        {
            q: "ギガノトサウルスはティラノサウルスより大きかったのですか？",
            a: "ギガノトサウルスは全長約12〜13mとティラノサウルスに匹敵あるいはわずかに上回る全長を持ちますが、体幅や骨太さ、推定体重（約7〜8トン）においてはティラノサウルス（約8〜9トン）の方が重厚であったとされています。南米大陸の白亜紀を代表する超巨大肉食恐竜です。"
        }
    ]
};

function generateDynamicFAQs(dino: any) {
    const faqs = [];
    
    // 1. 大きさ・体長（検索クエリで最も多い「〇〇 大きさ」「〇〇 全長」に対応）
    if (dino.length) {
        faqs.push({
            q: `${dino.name}の大きさ（全長・体重）はどのくらいですか？`,
            a: `${dino.name}の成体の推定全長は約${dino.length}${dino.weight ? `、推定体重は約${dino.weight}` : ''}です。本ページの実寸サイズ比較スケールにて人間との対比を確認できます。`
        });
    }

    // 学術的最新知見・特化型FAQ（該当前提）
    if (dino.id && ACADEMIC_FAQS[dino.id]) {
        for (const item of ACADEMIC_FAQS[dino.id]) {
            faqs.push(item);
        }
    }

    // 2. 特徴・生体力学的強み（不自然なAI/ゲーム的数値を排除し自然な解説に）
    if (dino.bioTraits && dino.bioTraits.length > 0) {
        const traitsDesc = dino.bioTraits.map((t: any) => `【${t.trait}】${t.detail}`).join('、');
        faqs.push({
            q: `${dino.name}の主な特徴や生態的強みは何ですか？`,
            a: `${dino.name}の特徴として、${traitsDesc}などが挙げられます。`
        });
    }

    // 3. 食性
    if (dino.diet) {
        faqs.push({
            q: `${dino.name}は何を食べていましたか？（食性）`,
            a: `${dino.name}は「${dino.diet}」の古生物でした。`
        });
    }

    // 4. 生息年代と地域
    if (dino.era && dino.region) {
        faqs.push({
            q: `${dino.name}はいつの時代、どこに生息していましたか？`,
            a: `中生代${dino.era}に、現在の${dino.region}周辺に生息していました。`
        });
    }

    // 5. サイズ比較シミュレータ導線（cyberMetadata保有種）
    if (dino.cyberMetadata) {
        faqs.push({
            q: `${dino.name}のサイズを人間や他の恐竜と比較することはできますか？`,
            a: `はい。当サイトの「恐竜サイズ比較シミュレータ」にて、${dino.name}を人間（1.7m）や現代の動物（ゾウ・クジラ）、超巨大恐竜と実寸1:1スケールで自由に並べて比較可能です。骨格実寸モードおよびリアル対決モードに対応しています。`
        });
    }
    
    return faqs;
}

const faqs = generateDynamicFAQs(d);

// 2. Title & Meta Description for SEO
const primaryAlias = (d.aliases || []).find((a: string) => !a.match(/^[\u3041-\u3096]+$/) && a !== d.name);
const nameWithAlias = primaryAlias ? `${d.name}（${primaryAlias}）` : d.name;
const categoryLabel = d.group === '翼竜' ? '翼竜' : d.group === '首長竜' ? '首長竜' : d.group === '魚竜' ? '魚竜' : (d.era.includes('古生代') || d.group === 'その他') ? '古生物' : '恐竜';

// 施策5: 恐竜以外の古生物に対する生物学的解説判定
const isDinosaur = ['獣脚類', '竜脚類', '鳥脚類', '剣竜類', '堅頭竜類', 'よろい竜類', '角竜類'].includes(d.group);
const isPterosaur = d.group === '翼竜';
const isMarineReptile = ['首長竜', '魚竜', '海棲爬虫類', '魚竜・首長竜'].includes(d.group);
const isPaleozoicOrOther = !isDinosaur && !isPterosaur && !isMarineReptile;

let nonDinoNotice: {
    badge: string;
    icon: string;
    title: string;
    desc: string;
    linkUrl: string;
    linkText: string;
} | null = null;

if (isPterosaur) {
    nonDinoNotice = {
        badge: '飛行爬虫類',
        icon: '🦇',
        title: '生物学的ワンポイント：本種は「翼竜」です',
        desc: '本種は分類上「恐竜」ではなく、中生代の空を自力飛行した「翼竜（Pterosauria）」に分類されます。恐竜と同じ主竜類ですが、翼膜で大空を羽ばたいた独自の飛翔爬虫類グループです。',
        linkUrl: '/topics/not-dinosaurs-truth/',
        linkText: '【特集】恐竜と間違えやすい古生物の真実 ➔'
    };
} else if (isMarineReptile) {
    nonDinoNotice = {
        badge: '海洋爬虫類',
        icon: '🌊',
        title: '生物学的ワンポイント：本種は「海生爬虫類」です',
        desc: '本種は陸生動物である「恐竜」ではなく、中生代の海へ進出し生態系の頂点に君臨した「海生爬虫類」に分類されます（モササウルス類・首長竜類・魚竜類など）。',
        linkUrl: '/marine-reptiles/',
        linkText: '中生代の海生爬虫類完全ガイドを見る ➔'
    };
} else if (isPaleozoicOrOther) {
    const isPaleozoic = d.era.includes('古生代') || d.era.includes('カンブリア') || d.era.includes('ペルム') || d.era.includes('デボン') || d.era.includes('石炭');
    nonDinoNotice = {
        badge: isPaleozoic ? '古生代生物' : 'その他の古生物',
        icon: '💡',
        title: isPaleozoic ? '生物学的ワンポイント：恐竜誕生以前（古生代）の生物です' : '生物学的ワンポイント：恐竜以外の古生物です',
        desc: isPaleozoic
            ? '本種は恐竜が誕生する前の中生代以前（古生代）に繁栄した生物です（ディメトロドンなどの単弓類は哺乳類の祖先に近い系統、アノマロカリスは節足動物系統に位置します）。'
            : '本種は分類学上「恐竜」ではなく、中生代〜太古の地球に生息した独自の古生物グループに分類されます。',
        linkUrl: '/topics/not-dinosaurs-truth/',
        linkText: '【特集】恐竜と間違えやすい古生物の真実 ➔'
    };
}

const pageTitle = `【${nameWithAlias}】実寸サイズ比較・生息年代・生態 | Dino-Portal ${categoryLabel}図鑑`;
const cleanDesc = d.description ? d.description.replace(/\r?\n/g, ' ').trim() : '';
const pageDescription = `【${nameWithAlias}（${d.scientificName}）】全長${d.length}・体重${d.weight}。人間（170cm）との実寸サイズ比較スケールを搭載。${cleanDesc}`;

// 3. JSON-LD Schema (Taxon, Breadcrumb, Article, FAQ)
const taxonSchema = {
    "@context": "https://schema.org",
    "@type": "Taxon",
    "@id": `https://dino-portal.com/dictionary/${entry.id}/#taxon`,
    "name": d.name,
    "scientificName": d.scientificName,
    "taxonRank": d.group === "翼竜" ? "Order" : d.group === "首長竜" ? "Clade" : d.group === "魚竜" ? "Order" : "Genus",
    "description": d.description,
    "image": `https://dino-portal.com/${d.image}`
};

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "ホーム",
            "item": "https://dino-portal.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "恐竜図鑑",
            "item": "https://dino-portal.com/dictionary/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": d.group,
            "item": `https://dino-portal.com/dictionary/?group=${encodeURIComponent(d.group)}`
        },
        {
            "@type": "ListItem",
            "position": 4,
            "name": d.name,
            "item": `https://dino-portal.com/dictionary/${entry.id}/`
        }
    ]
};

// 4. Size comparison rendering details
const PANEL_HEIGHT = 400;
const BASELINE_PX = 100;
const SAFE_ZONE_H = PANEL_HEIGHT - BASELINE_PX; // 300px
const SAFE_ZONE_W = 600;

const imagePath = path.join(process.cwd(), 'public', 'images', 'cyber', `${entry.id}.webp`);
const hasComparison = !!d.cyberMetadata && fs.existsSync(imagePath);

const battleImagePath = path.join(process.cwd(), 'public', 'images', 'cyber', `${entry.id}_battle.webp`);
const hasBattleImage = fs.existsSync(battleImagePath);

// Image SEO (Alt texts & ImageObject Schema)
const mainImageAlt = `${d.name}（${d.nameEn || d.name}）の生体復元イラスト・姿｜中生代${d.era} ${categoryLabel}（全長${d.length}）`;

const imageSchemaList: any[] = [
    {
        "@type": "ImageObject",
        "@id": `https://dino-portal.com/${d.image}#primaryimage`,
        "url": `https://dino-portal.com/${d.image}`,
        "contentUrl": `https://dino-portal.com/${d.image}`,
        "caption": `${d.name}（${d.nameEn || d.name}）の生体復元イラスト`,
        "description": `中生代${d.era}の${categoryLabel}「${d.name}」のリアルな復元想像図・外見特徴。推定全長約${d.length}、推定体重約${d.weight}。`,
        "name": `${d.name}の復元イラスト`,
        "representativeOfPage": true,
        "creator": {
            "@type": "Organization",
            "name": "Dino-Portal Lab",
            "url": "https://dino-portal.com/"
        },
        "creditText": "Dino-Portal",
        "copyrightNotice": "© Dino-Portal"
    }
];

if (hasComparison) {
    imageSchemaList.push({
        "@type": "ImageObject",
        "@id": `https://dino-portal.com/images/cyber/${d.id}.webp#cyber`,
        "url": `https://dino-portal.com/images/cyber/${d.id}.webp`,
        "contentUrl": `https://dino-portal.com/images/cyber/${d.id}.webp`,
        "caption": `${d.name}と人間（1.7m）の実寸1:1サイズ比較骨格図`,
        "description": `${d.name}（全長${d.length}）の骨格側面図と人間（1.7m）の実寸比率スケール比較。`,
        "name": `${d.name}の骨格図・実寸サイズ比較図`,
        "creator": {
            "@type": "Organization",
            "name": "Dino-Portal Lab",
            "url": "https://dino-portal.com/"
        },
        "creditText": "Dino-Portal",
        "copyrightNotice": "© Dino-Portal"
    });
}

if (hasBattleImage) {
    imageSchemaList.push({
        "@type": "ImageObject",
        "@id": `https://dino-portal.com/images/cyber/${d.id}_battle.webp#battle`,
        "url": `https://dino-portal.com/images/cyber/${d.id}_battle.webp`,
        "contentUrl": `https://dino-portal.com/images/cyber/${d.id}_battle.webp`,
        "caption": `${d.name}（${d.nameEn || d.name}）のリアル対決・威嚇戦闘復元図`,
        "description": `${d.name}（中生代${d.era}）の臨場感あふれる咆哮・威嚇戦闘ポーズのリアル復元グラフィック。実寸サイズ比較シミュレータのリアル対決モード対応アセット。`,
        "name": `${d.name}のリアル対決イラスト・復元図`,
        "creator": {
            "@type": "Organization",
            "name": "Dino-Portal Lab",
            "url": "https://dino-portal.com/"
        },
        "creditText": "Dino-Portal",
        "copyrightNotice": "© Dino-Portal"
    });
}

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Article",
            "headline": pageTitle,
            "description": pageDescription,
            "image": [
                `https://dino-portal.com/${d.image}`,
                ...(hasComparison ? [`https://dino-portal.com/images/cyber/${d.id}.webp`] : []),
                ...(hasBattleImage ? [`https://dino-portal.com/images/cyber/${d.id}_battle.webp`] : [])
            ],
            "author": {
                "@type": "Person",
                "name": AUTHOR_DATA.name,
                "jobTitle": AUTHOR_DATA.role,
                "description": AUTHOR_DATA.bio,
                "url": "https://dino-portal.com/"
            },
            "about": {
                "@id": `https://dino-portal.com/dictionary/${entry.id}/#taxon`
            }
        },
        ...imageSchemaList,
        taxonSchema,
        breadcrumbSchema,
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map(f => ({
                "@type": "Question",
                "name": f.q,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": f.a
                }
            }))
        }
    ]
};

let dinoLeft = '15%';
let refRight = '15%';
let isLabelConflict = false;

// SVG座標系用 (viewBox 0 0 650 400)
let dinoW = 0;
let dinoH = 0;
let dinoX = 0;
let dinoY = 0;
let refW = 0;
let refH = 0;
let refX = 0;
let refY = 0;
let dinoTagX = 0;
let dinoNeedFlip = false;

const BASELINE_Y = 315; // SVG内でのベースラインのY座標 (400 - 85)

if (hasComparison) {
    const isSkelRight = RIGHT_FACING_SKELETONS.has(d.id.toLowerCase());
    // 人間（右側）に向かい合うよう、原画が左向きの骨格図は左右反転して右向きにする
    dinoNeedFlip = !isSkelRight;

    const meta = d.cyberMetadata!;
    const realH = meta.realHeight || (parseFloat(d.length) * 0.35);
    const realL = meta.realLength || parseFloat(d.length);
    const ref = REFERENCE_ASSETS.HUMAN;

    // 1. セーフゾーンの高さ90%、幅85%以内に収まる比率
    const maxPxPerMeterH = (SAFE_ZONE_H * 0.9) / realH;
    const maxPxPerMeterL = (SAFE_ZONE_W * 0.85) / realL;
    let pxPerMeter = Math.min(maxPxPerMeterH, maxPxPerMeterL);
    
    // zoomがある場合は乗算
    const zoom = meta.zoom || 1.0;
    pxPerMeter = pxPerMeter * zoom;
    
    // 【見切れ防止クランプ】 高さ上限クランプを常に適用
    const absoluteMaxH = (BASELINE_Y - 20) / realH;
    pxPerMeter = Math.min(pxPerMeter, absoluteMaxH);

    // 幅方向（左右）: zoom未指定時のみ安全クランプ
    if (!meta.zoom) {
        const absoluteMaxL = (650 - 80) / realL;
        pxPerMeter = Math.min(pxPerMeter, absoluteMaxL);
    }

    // 小さい生物用の最小縮尺調整
    if (realH < ref.realHeight) {
        const humanTargetH = SAFE_ZONE_H * 0.85;
        pxPerMeter = Math.min(pxPerMeter, humanTargetH / ref.realHeight);
    }
    
    // 2. 配置位置の決定
    const dinoDrawW = realL * pxPerMeter;
    let leftPercent = 15;
    let rightPercent = 15;
    
    if (dinoDrawW > 350) {
        leftPercent = 5;
        rightPercent = 5;
    } else if (dinoDrawW > 250) {
        leftPercent = 10;
        rightPercent = 10;
    }
    
    const finalLeftPercent = meta.dinoLeft ? parseFloat(meta.dinoLeft) : leftPercent;
    const finalRightPercent = meta.refRight ? parseFloat(meta.refRight) : rightPercent;
    
    dinoLeft = `${finalLeftPercent}%`;
    refRight = `${finalRightPercent}%`;

    // 3. SVG用の絶対座標の精密計算
    const dinoScale = (pxPerMeter * realH) / meta.contentHeightPx;
    dinoW = meta.sourceRes * dinoScale;
    dinoH = meta.sourceRes * dinoScale;
    const dinoBottomGapPx = meta.bottomGap * dinoScale;
    
    dinoX = (650 * finalLeftPercent / 100);
    const dinoOffsetYPx = meta.dinoOffsetY ? parseFloat(meta.dinoOffsetY as string) : 0;
    dinoY = BASELINE_Y - dinoH + dinoBottomGapPx + dinoOffsetYPx;

    const refScaleMultiplier = meta.refScale ?? 1.0;
    const refTargetH = ref.realHeight * pxPerMeter * refScaleMultiplier;
    const refScale = refTargetH / ref.contentHeightPx;
    refW = ref.sourceRes * refScale;
    refH = ref.sourceRes * refScale;
    const refBottomGapPx = ref.bottomGap * refScale;

    refX = 650 - (650 * finalRightPercent / 100) - refW;
    refY = BASELINE_Y - refH + refBottomGapPx;

    // 4. 実座標ベースの衝突判定
    const dinoTagOffsetX = meta.dinoTagOffsetX ? parseFloat(meta.dinoTagOffsetX as string) : 0;
    dinoTagX = dinoX + dinoW / 2 + dinoTagOffsetX;
    const refTagX = refX + refW / 2;
    if (Math.abs(dinoTagX - refTagX) < 180) {
        isLabelConflict = true;
    }
}

const formatVal = (val: number) => val % 1 === 0 ? val.toFixed(1) : val.toString();

// 5. 関連恐竜・トピック・フィルタ用カテゴリの算出
const ERAS_LIST = ["白亜紀", "ジュラ紀", "三畳紀", "古生代"];
const baseEra = ERAS_LIST.find(e => d.era.includes(e)) || d.era;

const REGIONS_LIST = ["北アメリカ", "南アメリカ", "アジア", "ロシア", "アフリカ", "ヨーロッパ", "日本", "海洋", "オセアニア"];
const baseRegion = REGIONS_LIST.find(r => d.region.includes(r)) || d.region;

// 代表的ライバル・対決・共存ペアマップ
const iconicPairs: Record<string, string[]> = {
    'tyrannosaurus': ['triceratops', 'ankylosaurus', 'spinosaurus', 'giganotosaurus', 'albertosaurus', 'dakotaraptor'],
    'triceratops': ['tyrannosaurus', 'torosaurus', 'ankylosaurus', 'edmontosaurus', 'styracosaurus'],
    'spinosaurus': ['carcharodontosaurus', 'tyrannosaurus', 'baryonyx', 'suchomimus', 'sarcosuchus'],
    'brachiosaurus': ['argentinosaurus', 'apatosaurus', 'allosaurus', 'diplodocus', 'camarasaurus', 'giraffatitan'],
    'allosaurus': ['stegosaurus', 'ceratosaurus', 'brachiosaurus', 'apatosaurus', 'camptosaurus'],
    'stegosaurus': ['allosaurus', 'ceratosaurus', 'kentrosaurus', 'camptosaurus'],
    'ankylosaurus': ['tyrannosaurus', 'triceratops', 'borealopelta', 'euoplocephalus', 'zuul'],
    'velociraptor': ['protoceratops', 'deinonychus', 'utahraptor', 'oviraptor'],
    'mosasaurus': ['tylosaurus', 'plesiosaurus', 'elasmosaurus', 'megalodon', 'archelon', 'kronosaurus'],
    'elasmosaurus': ['styxosaurus', 'plesiosaurus', 'futabasaurus', 'mosasaurus', 'tylosaurus', 'kronosaurus', 'archelon'],
    'argentinosaurus': ['brachiosaurus', 'patagotitan', 'mapusaurus', 'giganotosaurus']
};

// 生態ニッチ・生物大分類判定（首長竜・海棲爬虫類、翼竜、恐竜の棲み分け）
function getBioCategory(item: any): 'marine' | 'pterosaur' | 'dinosaur' | 'other' {
    const g = item.group || '';
    const r = item.region || '';
    const n = item.name || '';
    const id = item.id || '';
    const marineGroups = ['首長竜', '魚竜', '魚竜・首長竜', '海棲爬虫類', '魚類'];
    const marineKeywords = [
        'モササウルス', 'ティロサウルス', 'クロノサウルス', 'プレシオサウルス', 
        'エラスモサウルス', 'リオプレウロドン', 'アーケロン', 'ダンクルオステウス', 
        'メガロドン', 'イクチオサウルス', 'ショニサウルス', 'フタバサウルス', 
        'スティクソサウルス', 'プロトステガ'
    ];
    if (marineGroups.includes(g) || r.includes('海') || marineKeywords.some(k => n.includes(k) || id.includes(k))) {
        return 'marine';
    }
    if (g === '翼竜') return 'pterosaur';
    if (['獣脚類', '竜脚類', '角竜類', 'よろい竜類', '鳥脚類', '剣竜類', '堅頭竜類'].includes(g)) return 'dinosaur';
    return 'other';
}

const currentBioCat = getBioCategory(d);

interface RelatedDinoItem {
    dino: any;
    score: number;
    relationBadge: string;
    relationNote: string;
}

const scoredDinosaurs: RelatedDinoItem[] = allDinosaurs
    .filter(item => item.id !== d.id)
    .map(item => {
        let score = 0;
        let badges: string[] = [];
        let note = '';

        const itemBioCat = getBioCategory(item);
        const isIconicPair = Boolean(iconicPairs[d.id] && iconicPairs[d.id].includes(item.id));

        // 1. 生態ニッチマッチ（海棲生物同士、翼竜同士、恐竜同士の棲み分け）
        if (currentBioCat === itemBioCat) {
            if (currentBioCat === 'marine') score += 25;
            else if (currentBioCat === 'pterosaur') score += 25;
            else score += 10;
        } else if (!isIconicPair) {
            // ニッチ不一致ペナルティ（例: 首長竜の枠に陸上恐竜が乱入するのを防止）
            score -= 25;
        }

        // 2. 系統・グループマッチ（同系統最優先）
        const exactSameGroup = d.group && item.group === d.group;
        const marineAffinity = currentBioCat === 'marine' && itemBioCat === 'marine';
        
        if (exactSameGroup) {
            score += 25;
        } else if (marineAffinity) {
            score += 12; // 首長竜とモササウルス類・魚竜等の海洋上位互換親和
        }

        // 3. 時代・地域の加算スコアリング
        const sameEra = baseEra && item.era.includes(baseEra);
        const sameRegion = (baseRegion && item.region.includes(baseRegion)) || (d.region === item.region);

        if (sameEra && sameRegion) {
            score += 15;
            if (d.diet.includes('肉食') && item.diet.includes('草食')) {
                score += 5;
            } else if (d.diet.includes('肉食') && item.diet.includes('肉食')) {
                score += 5;
            }
        } else if (sameEra) {
            score += 6;
        } else if (sameRegion) {
            score += 4;
        }

        // 4. 代表的ライバル・対決関係の直接指定ボーナス
        if (isIconicPair) {
            score += 40;
        }

        // 5. 最適なリレーションバッジと解説ノートの選定
        if (isIconicPair) {
            badges.push('🔥 代表的ライバル');
            note = `学術・メディアで広く対比・研究される代表的古生物`;
        } else if (exactSameGroup && sameEra && sameRegion) {
            badges.push(`⚡ 共存近縁種（${d.group}）`);
            note = `${baseEra}の${baseRegion}で同時期に繁栄した近縁種`;
        } else if (exactSameGroup) {
            badges.push(`⚡ 近縁種（${d.group}）`);
            note = `系統進化学的に近縁な関係にある${d.group}`;
        } else if (marineAffinity) {
            if (sameEra) {
                badges.push(`🌊 共存海生生物（${baseEra}）`);
                note = `${baseEra}の海洋生態系を共に支配した大型海生生物`;
            } else {
                badges.push(`🌊 海生古生物`);
                note = `中生代の海洋生態系を構成した大型海生生物`;
            }
        } else if (currentBioCat === 'pterosaur' && itemBioCat === 'pterosaur') {
            if (sameEra) {
                badges.push(`🪶 同時代の翼竜（${baseEra}）`);
                note = `${baseEra}の大空で同時期に繁栄した翼竜`;
            } else {
                badges.push(`🪶 翼竜`);
                note = `中生代の大空を支配した翼竜類`;
            }
        } else if (sameEra && sameRegion) {
            if (d.diet.includes('肉食') && item.diet.includes('草食')) {
                badges.push('🦕 獲物・共存種');
                note = `${baseEra}の${baseRegion}で共存した獲物・大型草食種`;
            } else if (d.diet.includes('肉食') && item.diet.includes('肉食')) {
                badges.push('⚔️ 生態系のライバル');
                note = `${baseEra}の${baseRegion}で頂点捕食者の座を争った肉食種`;
            } else {
                badges.push('🌍 同時代・同地域');
                note = `${baseEra}の${baseRegion}の生態系を構成した共存古生物`;
            }
        } else if (sameEra) {
            badges.push(`⏳ 同時代（${baseEra}）`);
            note = `${baseEra}の地球上で同時期に繁栄した生物`;
        } else if (sameRegion) {
            badges.push(`📍 同地域（${baseRegion}）`);
            note = `同じ${baseRegion}の大地・地層から発見された生物`;
        }

        return {
            dino: item,
            score,
            relationBadge: badges[0] || `[ ${item.group || '古生物'} ]`,
            relationNote: note || `${item.era} / ${item.region}`
        };
    })
    .sort((a, b) => b.score - a.score)
    .slice(0, 6);

// 五十音順ソート＆前後ナビゲーション用データの算出
const sortedDinosaurs = [...allDinosaurs].sort((a, b) => {
    return (a.kana || a.name).localeCompare(b.kana || b.name, 'ja');
});

const currentDinoIdx = sortedDinosaurs.findIndex(item => item.id === d.id);
const prevDino = currentDinoIdx > 0 
    ? sortedDinosaurs[currentDinoIdx - 1] 
    : sortedDinosaurs[sortedDinosaurs.length - 1];
const nextDino = (currentDinoIdx >= 0 && currentDinoIdx < sortedDinosaurs.length - 1) 
    ? sortedDinosaurs[currentDinoIdx + 1] 
    : sortedDinosaurs[0];

const topics = await getCollection('topics');

// 本文直下の文脈アンカー導線用（その恐竜の生態・最新学説に直結する専門特集）
const deepDiveTopic = topics
    .map(entry => entry.data)
    .find(t => {
        if (t.category !== 'theory' && t.category !== 'introduction') return false;
        if (!t.relatedSpecimens || !t.relatedSpecimens.includes(d.id)) return false;
        const titleMatch = t.title.includes(d.name) || (d.id === 'tyrannosaurus' && (t.title.includes('T-レックス') || t.title.includes('ティラノ')));
        const idMatch = t.id.includes(d.id) || (d.id === 'tyrannosaurus' && t.id.startsWith('trex-'));
        return titleMatch || idMatch;
    });

// ランキング・特集への文脈アンカー導線（サイズランキングや最強ランキング等のピラー記事への導線）
const rankingTopic = topics
    .map(entry => entry.data)
    .find(t => {
        if (t.category !== 'ranking') return false;
        return t.relatedSpecimens && t.relatedSpecimens.includes(d.id);
    });

// フッター用関連特集（レジャー・グッズ等を除外し、恐竜に関連する記事を優先）
const relatedTopics = topics
    .map(entry => entry.data)
    .filter(t => {
        if (!t.relatedSpecimens || !t.relatedSpecimens.includes(d.id)) return false;
        if (t.category === 'museum_goods') {
            const isDirect = t.title.includes(d.name) || t.id.includes(d.id);
            if (!isDirect) return false;
        }
        return true;
    })
    .sort((a, b) => {
        const aDirect = a.title.includes(d.name) || a.id.includes(d.id) || (d.id === 'tyrannosaurus' && a.id.startsWith('trex-'));
        const bDirect = b.title.includes(d.name) || b.id.includes(d.id) || (d.id === 'tyrannosaurus' && b.id.startsWith('trex-'));
        if (aDirect && !bDirect) return -1;
        if (!aDirect && bDirect) return 1;
        return b.date.localeCompare(a.date);
    })
    .slice(0, 3);

// 6. Markdown本文のSSRレンダリングと実寸比較パネル挿入位置の自動分割
const mdPath = path.join(process.cwd(), 'src', 'content', 'dinosaurs', `${entry.id}.md`);
const rawMd = (entry as any).body ?? (fs.existsSync(mdPath) ? fs.readFileSync(mdPath, 'utf-8').replace(/^---[\s\S]*?---\n*/, '') : '');

const processor = await createMarkdownProcessor();
const { code: rawHtml } = await processor.render(rawMd);

// 各見出しに固有IDをSSR段階で付与
let secIdx = 0;
const processedHtml = rawHtml.replace(/<h3([^>]*)>/g, (match, attrs) => {
    const id = `dino-sec-${secIdx++}`;
    const cleanAttrs = attrs.replace(/\s*id="[^"]*"/, '');
    return `<h3 id="${id}"${cleanAttrs}>`;
});

// 見出し一覧（目次生成用）
const h3Regex = /<h3 id="([^"]+)">([\s\S]*?)<\/h3>/g;
const h3List: { id: string; text: string; cleanText: string; index: number }[] = [];
let match;
while ((match = h3Regex.exec(processedHtml)) !== null) {
    const rawText = match[2].replace(/<[^>]+>/g, '').trim();
    const cleanText = rawText.split('・')[0].trim();
    h3List.push({ id: match[1], text: rawText, cleanText, index: match.index });
}

// 実寸比較パネルの挿入位置分割（実寸セクションの次の見出しの手前で分割）
let contentPart1 = processedHtml;
let contentPart2 = '';

if (hasComparison && h3List.length > 0) {
    let sizeSecIdx = h3List.findIndex(h => h.text.includes('実寸') || h.text.includes('サイズ') || h.text.includes('スケール'));
    if (sizeSecIdx === -1 && h3List.length >= 2) {
        sizeSecIdx = 1; // 2番目をデフォルト
    }
    
    if (sizeSecIdx !== -1) {
        const nextSecIdx = sizeSecIdx + 1;
        if (nextSecIdx < h3List.length) {
            const splitPoint = h3List[nextSecIdx].index;
            contentPart1 = processedHtml.slice(0, splitPoint);
            contentPart2 = processedHtml.slice(splitPoint);
        } else {
            contentPart1 = processedHtml;
            contentPart2 = '';
        }
    }
}
