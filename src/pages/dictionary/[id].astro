---
import Layout from '../../layouts/Layout.astro';
import AffiliateSection from '../../components/AffiliateSection.astro';
import { REFERENCE_ASSETS } from '../../data/cyberAssets';
import { AUTHOR_DATA } from '../../data/author';
import { getCollection, render } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dinosaurEntries = await getCollection('dinosaurs');
  return dinosaurEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { data: d } = entry;
const allDinosaurs = (await getCollection('dinosaurs')).map(entry => entry.data);

// 1. FAQ Generation Logic for SEO/GEO
function generateDynamicFAQs(dino: any) {
    const faqs = [];
    if (dino.bioTraits && dino.bioTraits.length > 0) {
        const primaryTrait = dino.bioTraits[0];
        faqs.push({
            q: `${dino.name}の持つ「${primaryTrait.trait}」とはどのような能力ですか？`,
            a: `${primaryTrait.trait}は解析値で「${primaryTrait.value}」と評価されています。詳細は：${primaryTrait.detail}`
        });
    }
    faqs.push({
        q: `${dino.name}はどのような食性を持っていましたか？`,
        a: `${dino.name}は「${dino.diet}」でした。`
    });
    faqs.push({
        q: `${dino.name}はどこで、いつ頃生息していましたか？`,
        a: `${dino.era}の${dino.region}に生息していました。`
    });
    return faqs;
}

const faqs = generateDynamicFAQs(d);

// 2. Title & Meta Description for SEO
const pageTitle = `【${d.name}】大きさ・生態・特徴を人間と比較解説 | Dino-Portal 恐竜図鑑`;
const pageDescription = `【${d.name}（${d.scientificName}）の完全図鑑】全長${d.length}・体重${d.weight}。人間との実寸サイズ比較スケール、生息年代（${d.era}）、食性、化石・生物学的特徴を詳しく解説。`;

// 3. JSON-LD Schema (Taxon, Breadcrumb, Article, FAQ)
const taxonSchema = {
    "@context": "https://schema.org",
    "@type": "Taxon",
    "@id": `https://dino-portal.com/dictionary/${entry.id}/#taxon`,
    "name": d.name,
    "scientificName": d.scientificName,
    "taxonRank": d.group === "翼竜" ? "Order" : d.group === "首長竜" ? "Clade" : d.group === "魚竜" ? "Order" : "Genus",
    "description": d.description,
    "image": `https://dino-portal.com/${d.image}`
};

const breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "ホーム",
            "item": "https://dino-portal.com/"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "恐竜図鑑",
            "item": "https://dino-portal.com/dictionary/"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": d.group,
            "item": `https://dino-portal.com/dictionary/?group=${encodeURIComponent(d.group)}`
        },
        {
            "@type": "ListItem",
            "position": 4,
            "name": d.name,
            "item": `https://dino-portal.com/dictionary/${entry.id}/`
        }
    ]
};

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Article",
            "headline": pageTitle,
            "description": pageDescription,
            "image": `https://dino-portal.com/${d.image}`,
            "author": {
                "@type": "Person",
                "name": AUTHOR_DATA.name,
                "jobTitle": AUTHOR_DATA.role,
                "description": AUTHOR_DATA.bio,
                "url": "https://dino-portal.com/"
            },
            "about": {
                "@id": `https://dino-portal.com/dictionary/${entry.id}/#taxon`
            }
        },
        taxonSchema,
        breadcrumbSchema,
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map(f => ({
                "@type": "Question",
                "name": f.q,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": f.a
                }
            }))
        }
    ]
};

// 4. Size comparison rendering details
const PANEL_HEIGHT = 400;
const BASELINE_PX = 100;
const SAFE_ZONE_H = PANEL_HEIGHT - BASELINE_PX; // 300px
const SAFE_ZONE_W = 600;

const imagePath = path.join(process.cwd(), 'public', 'images', 'cyber', `${entry.id}.webp`);
const hasComparison = !!d.cyberMetadata && fs.existsSync(imagePath);
let dinoLeft = '15%';
let refRight = '15%';
let isLabelConflict = false;

// SVG座標系用 (viewBox 0 0 650 400)
let dinoW = 0;
let dinoH = 0;
let dinoX = 0;
let dinoY = 0;
let refW = 0;
let refH = 0;
let refX = 0;
let refY = 0;
let dinoTagX = 0;

const BASELINE_Y = 315; // SVG内でのベースラインのY座標 (400 - 85)

if (hasComparison) {
    const meta = d.cyberMetadata!;
    const realH = meta.realHeight || (parseFloat(d.length) * 0.35);
    const realL = meta.realLength || parseFloat(d.length);
    const ref = REFERENCE_ASSETS.HUMAN;

    // 1. セーフゾーンの高さ90%、幅85%以内に収まる比率
    const maxPxPerMeterH = (SAFE_ZONE_H * 0.9) / realH;
    const maxPxPerMeterL = (SAFE_ZONE_W * 0.85) / realL;
    let pxPerMeter = Math.min(maxPxPerMeterH, maxPxPerMeterL);
    
    // zoomがある場合は乗算
    const zoom = meta.zoom || 1.0;
    pxPerMeter = pxPerMeter * zoom;
    
    // 【見切れ防止クランプ】 高さ上限クランプを常に適用
    const absoluteMaxH = (BASELINE_Y - 20) / realH;
    pxPerMeter = Math.min(pxPerMeter, absoluteMaxH);

    // 幅方向（左右）: zoom未指定時のみ安全クランプ
    if (!meta.zoom) {
        const absoluteMaxL = (650 - 80) / realL;
        pxPerMeter = Math.min(pxPerMeter, absoluteMaxL);
    }

    // 小さい生物用の最小縮尺調整
    if (realH < ref.realHeight) {
        const humanTargetH = SAFE_ZONE_H * 0.85;
        pxPerMeter = Math.min(pxPerMeter, humanTargetH / ref.realHeight);
    }
    
    // 2. 配置位置の決定
    const dinoDrawW = realL * pxPerMeter;
    let leftPercent = 15;
    let rightPercent = 15;
    
    if (dinoDrawW > 350) {
        leftPercent = 5;
        rightPercent = 5;
    } else if (dinoDrawW > 250) {
        leftPercent = 10;
        rightPercent = 10;
    }
    
    const finalLeftPercent = meta.dinoLeft ? parseFloat(meta.dinoLeft) : leftPercent;
    const finalRightPercent = meta.refRight ? parseFloat(meta.refRight) : rightPercent;
    
    dinoLeft = `${finalLeftPercent}%`;
    refRight = `${finalRightPercent}%`;

    // 3. SVG用の絶対座標の精密計算
    const dinoScale = (pxPerMeter * realH) / meta.contentHeightPx;
    dinoW = meta.sourceRes * dinoScale;
    dinoH = meta.sourceRes * dinoScale;
    const dinoBottomGapPx = meta.bottomGap * dinoScale;
    
    dinoX = (650 * finalLeftPercent / 100);
    const dinoOffsetYPx = meta.dinoOffsetY ? parseFloat(meta.dinoOffsetY as string) : 0;
    dinoY = BASELINE_Y - dinoH + dinoBottomGapPx + dinoOffsetYPx;

    const refTargetH = ref.realHeight * pxPerMeter;
    const refScale = refTargetH / ref.contentHeightPx;
    refW = ref.sourceRes * refScale;
    refH = ref.sourceRes * refScale;
    const refBottomGapPx = ref.bottomGap * refScale;

    refX = 650 - (650 * finalRightPercent / 100) - refW;
    refY = BASELINE_Y - refH + refBottomGapPx;

    // 4. 実座標ベースの衝突判定
    const dinoTagOffsetX = meta.dinoTagOffsetX ? parseFloat(meta.dinoTagOffsetX as string) : 0;
    dinoTagX = dinoX + dinoW / 2 + dinoTagOffsetX;
    const refTagX = refX + refW / 2;
    if (Math.abs(dinoTagX - refTagX) < 180) {
        isLabelConflict = true;
    }
}

const formatVal = (val: number) => val % 1 === 0 ? val.toFixed(1) : val.toString();

// 5. 関連恐竜・トピック・フィルタ用カテゴリの算出
const ERAS_LIST = ["白亜紀", "ジュラ紀", "三畳紀", "古生代"];
const baseEra = ERAS_LIST.find(e => d.era.includes(e)) || d.era;

const REGIONS_LIST = ["北アメリカ", "南アメリカ", "アジア", "ロシア", "アフリカ", "ヨーロッパ", "日本", "海洋", "オセアニア"];
const baseRegion = REGIONS_LIST.find(r => d.region.includes(r)) || d.region;

const relatedSpecimens = allDinosaurs.filter(item => {
    if (item.id === d.id) return false;
    const matchesGroup = item.group === d.group;
    const matchesEra = baseEra && item.era.includes(baseEra);
    const matchesRegion = item.region === d.region;
    return matchesGroup || matchesEra || matchesRegion;
}).slice(0, 4);

const topics = await getCollection('topics');

// 本文直下の文脈アンカー導線用（その恐竜の生態・最新学説に直結する専門特集）
const deepDiveTopic = topics
    .map(entry => entry.data)
    .find(t => {
        if (t.category !== 'theory' && t.category !== 'introduction') return false;
        if (!t.relatedSpecimens || !t.relatedSpecimens.includes(d.id)) return false;
        const titleMatch = t.title.includes(d.name) || (d.id === 'tyrannosaurus' && (t.title.includes('T-レックス') || t.title.includes('ティラノ')));
        const idMatch = t.id.includes(d.id) || (d.id === 'tyrannosaurus' && t.id.startsWith('trex-'));
        return titleMatch || idMatch;
    });

// フッター用関連特集（レジャー・グッズ等を除外し、恐竜に関連する記事を優先）
const relatedTopics = topics
    .map(entry => entry.data)
    .filter(t => {
        if (!t.relatedSpecimens || !t.relatedSpecimens.includes(d.id)) return false;
        if (t.category === 'museum_goods') {
            const isDirect = t.title.includes(d.name) || t.id.includes(d.id);
            if (!isDirect) return false;
        }
        return true;
    })
    .sort((a, b) => {
        const aDirect = a.title.includes(d.name) || a.id.includes(d.id) || (d.id === 'tyrannosaurus' && a.id.startsWith('trex-'));
        const bDirect = b.title.includes(d.name) || b.id.includes(d.id) || (d.id === 'tyrannosaurus' && b.id.startsWith('trex-'));
        if (aDirect && !bDirect) return -1;
        if (!aDirect && bDirect) return 1;
        return b.date.localeCompare(a.date);
    })
    .slice(0, 3);

// 6. Markdown本文のSSRレンダリングと実寸比較パネル挿入位置の自動分割
const mdPath = path.join(process.cwd(), 'src', 'content', 'dinosaurs', `${entry.id}.md`);
const rawMd = (entry as any).body ?? (fs.existsSync(mdPath) ? fs.readFileSync(mdPath, 'utf-8').replace(/^---[\s\S]*?---\n*/, '') : '');

const processor = await createMarkdownProcessor();
const { code: rawHtml } = await processor.render(rawMd);

// 各見出しに固有IDをSSR段階で付与
let secIdx = 0;
const processedHtml = rawHtml.replace(/<h3([^>]*)>/g, (match, attrs) => {
    const id = `dino-sec-${secIdx++}`;
    const cleanAttrs = attrs.replace(/\s*id="[^"]*"/, '');
    return `<h3 id="${id}"${cleanAttrs}>`;
});

// 見出し一覧（目次生成用）
const h3Regex = /<h3 id="([^"]+)">([\s\S]*?)<\/h3>/g;
const h3List: { id: string; text: string; cleanText: string; index: number }[] = [];
let match;
while ((match = h3Regex.exec(processedHtml)) !== null) {
    const rawText = match[2].replace(/<[^>]+>/g, '').trim();
    const cleanText = rawText.split('・')[0].trim();
    h3List.push({ id: match[1], text: rawText, cleanText, index: match.index });
}

// 実寸比較パネルの挿入位置分割（実寸セクションの次の見出しの手前で分割）
let contentPart1 = processedHtml;
let contentPart2 = '';

if (hasComparison && h3List.length > 0) {
    let sizeSecIdx = h3List.findIndex(h => h.text.includes('実寸') || h.text.includes('サイズ') || h.text.includes('スケール'));
    if (sizeSecIdx === -1 && h3List.length >= 2) {
        sizeSecIdx = 1; // 2番目をデフォルト
    }
    
    if (sizeSecIdx !== -1) {
        const nextSecIdx = sizeSecIdx + 1;
        if (nextSecIdx < h3List.length) {
            const splitPoint = h3List[nextSecIdx].index;
            contentPart1 = processedHtml.slice(0, splitPoint);
            contentPart2 = processedHtml.slice(splitPoint);
        } else {
            contentPart1 = processedHtml;
            contentPart2 = '';
        }
    }
}
---

<Layout title={pageTitle} activeTab="dictionary" description={pageDescription} ogImage={`/${d.image}`} schema={schema}>
    <!-- パンくずナビゲーション -->
    <nav class="breadcrumb-nav" aria-label="パンくずリスト">
        <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="/" itemprop="item" class="breadcrumb-link">
                    <span itemprop="name">ホーム</span>
                </a>
                <meta itemprop="position" content="1" />
                <span class="breadcrumb-separator" aria-hidden="true">&rsaquo;</span>
            </li>
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="/dictionary/" itemprop="item" class="breadcrumb-link">
                    <span itemprop="name">恐竜図鑑</span>
                </a>
                <meta itemprop="position" content="2" />
                <span class="breadcrumb-separator" aria-hidden="true">&rsaquo;</span>
            </li>
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href={`/dictionary/?group=${encodeURIComponent(d.group)}`} itemprop="item" class="breadcrumb-link">
                    <span itemprop="name">{d.group}</span>
                </a>
                <meta itemprop="position" content="3" />
                <span class="breadcrumb-separator" aria-hidden="true">&rsaquo;</span>
            </li>
            <li class="breadcrumb-item current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
                <span itemprop="name">{d.name}</span>
                <meta itemprop="position" content="4" />
            </li>
        </ol>
    </nav>

    <!-- ===== 新レイアウトコンテナ ===== -->
    <article class="layout-opt1-wrap">

        <!-- 1. トップヒーローセクション (左: イラスト / 右: タイトル・基本スペック) -->
        <section class="opt1-hero-grid">
            <!-- 左側: メインイラスト（ギャラリースライダー対応） -->
            <div class="opt1-visual-box">
                {d.gallery && d.gallery.length > 0 ? (
                    <div class="detail-img-viewer hud-panel slider-panel">
                        <div class="hud-corner top-left"></div>
                        <div class="hud-corner bottom-right"></div>
                        <div class="scan-line-ani" style="pointer-events: none;"></div>
                        
                        <div class="slider-container" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden;">
                            <div class="slider-track" id="dino-slider" style="display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; width: 100%; height: 100%;">
                                <div class="slider-slide" style="flex: 0 0 100%; width: 100%; min-width: 100%; max-width: 100%; height: 100%; scroll-snap-align: start; display: flex; justify-content: center; align-items: center;">
                                    <img src={`/${d.image}`} alt={d.name} fetchpriority="high" decoding="async" width="800" height="533" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 30px rgba(0,242,255,0.3));">
                                </div>
                                {d.gallery.map((imgUrl, idx) => (
                                    <div class="slider-slide" style="flex: 0 0 100%; width: 100%; min-width: 100%; max-width: 100%; height: 100%; scroll-snap-align: start; display: flex; justify-content: center; align-items: center;">
                                        <img src={`/${imgUrl}`} alt={`${d.name} イラスト ${idx + 2}`} loading="lazy" decoding="async" width="800" height="533" style="width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 30px rgba(0,242,255,0.3));">
                                    </div>
                                ))}
                            </div>
                        </div>

                        <!-- スライダーページネーション -->
                        <div class="slider-dots" style="position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 10;">
                            <span class="slider-dot active" data-index="0" style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary-neon); border: 1px solid var(--primary-neon); cursor: pointer; transition: all 0.3s ease; box-shadow: 0 0 8px var(--primary-neon);"></span>
                            {d.gallery.map((_, idx) => (
                                <span class="slider-dot" data-index={idx + 1} style="width: 8px; height: 8px; border-radius: 50%; background: rgba(0, 242, 255, 0.25); border: 1px solid var(--primary-neon); cursor: pointer; transition: all 0.3s ease;"></span>
                            ))}
                        </div>
                    </div>
                ) : (
                    <div class="detail-img-viewer hud-panel">
                        <div class="hud-corner top-left"></div>
                        <div class="hud-corner bottom-right"></div>
                        <div class="scan-line-ani"></div>
                        <img src={`/${d.image}`} alt={d.name} fetchpriority="high" decoding="async" width="800" height="533" style="width: 100%; height: 100%; object-fit: contain;">
                    </div>
                )}
            </div>

            <!-- 右側: タイトル ＆ 基本スペック ＆ 短い概要 -->
            <div class="opt1-meta-box">
                <header class="detail-header" style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; flex-wrap: wrap;">
                        <div>
                            <h1 class="detail-title" style="margin-bottom: 4px;">{d.name}</h1>
                            <p class="detail-scientific" style="margin-bottom: 0;">[ {d.scientificName} ]</p>
                        </div>
                        <button class="save-btn" id="observe-save-btn" aria-label="図鑑に保存" data-id={d.id}>
                            + 観測データに保存
                        </button>
                    </div>
                </header>

                <div class="hud-panel" style="padding: 16px 20px; margin-bottom: 20px; background: rgba(0, 242, 255, 0.02); border-color: rgba(0, 242, 255, 0.2);">
                    <p style="line-height: 1.7; font-size: 14px; margin: 0; color: var(--text-main);">{d.description}</p>
                </div>

                <!-- 基本スペック表 -->
                <div class="hud-panel" style="padding: 20px; border-color: rgba(0, 242, 255, 0.2); position: relative;">
                    <div class="hud-corner top-left" style="border-top-color: rgba(0, 242, 255, 0.35); border-left-color: rgba(0, 242, 255, 0.35);"></div>
                    <div class="hud-corner bottom-right" style="border-bottom-color: rgba(0, 242, 255, 0.35); border-right-color: rgba(0, 242, 255, 0.35);"></div>
                    <h2 style="border-bottom: 1px solid var(--panel-border); padding-bottom: 8px; margin-bottom: 15px; color: var(--primary-neon); font-size: 13px; font-weight: bold; letter-spacing: 1px; font-family: var(--font-mono);">
                        [ 基本スペック・生息環境 ]
                    </h2>
                    <div class="spec-panel" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 15px 0;">
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">生息年代</span><br>
                            <a href={`/dictionary/?era=${encodeURIComponent(baseEra)}`} class="spec-link" title={`「${baseEra}」の恐竜一覧を見る`}>{d.era}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">生息地域</span><br>
                            <a href={`/dictionary/?region=${encodeURIComponent(baseRegion)}`} class="spec-link" title={`「${baseRegion}」の恐竜一覧を見る`}>{d.region}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">分類</span><br>
                            <a href={`/dictionary/?group=${encodeURIComponent(d.group)}`} class="spec-link" title={`「${d.group}」の恐竜一覧を見る`}>{d.group}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;">
                            <span class="spec-label">食性</span><br>
                            <a href={`/dictionary/?diet=${encodeURIComponent(d.diet)}`} class="spec-link" title={`「${d.diet}」の恐竜一覧を見る`}>{d.diet}</a>
                        </div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;"><span class="spec-label">全長</span><br>{d.length}</div>
                        <div class="spec-item" style="border-color: rgba(0, 242, 255, 0.1); background: rgba(1, 10, 18, 0.6); padding: 8px 10px;"><span class="spec-label">推定体重</span><br>{d.weight}</div>
                    </div>

                    <!-- 生物学的特性 -->
                    {d.bioTraits && d.bioTraits.length > 0 && (
                        <div style="border-top: 1px dashed rgba(0, 242, 255, 0.15); padding-top: 12px;">
                            <div style="display: flex; flex-direction: column; gap: 8px;">
                                {d.bioTraits.map(t => (
                                    <div style="font-size: 12.5px; line-height: 1.5; color: var(--text-main);">
                                        <strong style="color: var(--primary-neon); font-family: var(--font-mono); margin-right: 6px;">{t.trait}</strong>
                                        <span style="color: var(--text-dim); margin-right: 6px;">:</span>
                                        <span>{t.detail}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </section>

        <!-- 2. 詳細解説エリア（中央本文 ＋ 左右HUDサイドレール：実寸比較パネルは「02」直下にインライン配置） -->
        <section class={`opt1-article-section ${h3List.length === 0 ? 'no-toc' : ''}`} id="article-section">
            
