    <!-- Client-side logic for Observed Save, Slider, ScrollSpy & Progress -->
    <script>
        const COLLECTION_KEY = 'dino_portal_saved_observations';

        function initSpecimenDetail() {
            const saveBtn = document.getElementById('observe-save-btn');
            if (!saveBtn) return;

            const dinoId = saveBtn.getAttribute('data-id');
            if (!dinoId) return;

            const getCollection = () => {
                const saved = localStorage.getItem(COLLECTION_KEY);
                return saved ? JSON.parse(saved) : [];
            };

            const toggleCollection = (id: string) => {
                let current = getCollection();
                if (current.includes(id)) {
                    current = current.filter((item: string) => item !== id);
                } else {
                    current.push(id);
                }
                localStorage.setItem(COLLECTION_KEY, JSON.stringify(current));
                return current.includes(id);
            };

            const updateButtonState = (isSaved: boolean) => {
                saveBtn.classList.toggle('saved', isSaved);
                saveBtn.innerHTML = isSaved ? '✓ 観測データ保存済み' : '+ 観測データに保存';
            };

            const initialList = getCollection();
            updateButtonState(initialList.includes(dinoId));

            saveBtn.addEventListener('click', () => {
                const isSaved = toggleCollection(dinoId);
                updateButtonState(isSaved);
            });

            // Feedback controls logic
            const yesBtn = document.getElementById('feedback-yes');
            const noBtn = document.getElementById('feedback-no');
            const msgEl = document.getElementById('msg-detail');

            if (yesBtn && noBtn && msgEl) {
                const showFeedbackMessage = (isPositive: boolean) => {
                    msgEl.innerText = isPositive 
                        ? "> フィードバック受理: 期待値との完全な同期を確認。" 
                        : "> フィードバック受理: 解析精度の再調整を要求中。";
                    msgEl.style.opacity = '1';
                    setTimeout(() => {
                        msgEl.style.opacity = '0';
                    }, 3000);
                };

                yesBtn.addEventListener('click', () => showFeedbackMessage(true));
                noBtn.addEventListener('click', () => showFeedbackMessage(false));
            }
        }

        function initSpecimenSlider() {
            const track = document.getElementById('dino-slider');
            const dots = document.querySelectorAll('.slider-dot');
            if (!track || dots.length === 0) return;

            const updateActiveDot = () => {
                const scrollLeft = track.scrollLeft;
                const width = track.clientWidth;
                const activeIndex = Math.round(scrollLeft / width);

                dots.forEach((dot, idx) => {
                    if (dot instanceof HTMLElement) {
                        if (idx === activeIndex) {
                            dot.classList.add('active');
                            dot.style.background = 'var(--primary-neon)';
                            dot.style.boxShadow = '0 0 8px var(--primary-neon)';
                        } else {
                            dot.classList.remove('active');
                            dot.style.background = 'rgba(0, 242, 255, 0.25)';
                            dot.style.boxShadow = 'none';
                        }
                    }
                });
            };

            track.addEventListener('scroll', updateActiveDot);

            dots.forEach((dot) => {
                dot.addEventListener('click', (e) => {
                    const target = e.target;
                    if (target instanceof HTMLElement) {
                        const index = parseInt(target.getAttribute('data-index') || '0', 10);
                        const width = track.clientWidth;
                        track.scrollTo({
                            left: index * width,
                            behavior: 'smooth'
                        });
                    }
                });
            });

            window.addEventListener('resize', updateActiveDot);
            updateActiveDot();
        }

        function initArticleScrollSpy() {
            const headings = document.querySelectorAll('.opt1-typography h3');
            const tocItems = document.querySelectorAll('.hud-toc-item');
            const depthVal = document.getElementById('scan-depth-val');
            const depthBar = document.getElementById('scan-depth-bar');
            const articleSection = document.getElementById('article-section');

            if (!headings || headings.length === 0) return;

            headings.forEach((h) => {
                (h as HTMLElement).style.scrollMarginTop = '90px';
            });

            const faqSec = document.getElementById('sec-faq');
            if (faqSec) (faqSec as HTMLElement).style.scrollMarginTop = '90px';
            const refSec = document.getElementById('sec-refs');
            if (refSec) (refSec as HTMLElement).style.scrollMarginTop = '90px';

            const targets = [
                ...Array.from(headings).map(h => ({ el: h as HTMLElement, id: h.id })),
                ...(faqSec ? [{ el: faqSec as HTMLElement, id: 'sec-faq' }] : []),
                ...(refSec ? [{ el: refSec as HTMLElement, id: 'sec-refs' }] : [])
            ];

            tocItems.forEach(item => {
                item.addEventListener('click', (e) => {
                    e.preventDefault();
                    const targetId = item.getAttribute('data-target');
                    if (!targetId) return;
                    const targetEl = document.getElementById(targetId);
                    if (!targetEl) return;

                    const appContainer = document.getElementById('app-container');
                    if (appContainer && appContainer.scrollHeight > window.innerHeight) {
                        const targetRect = targetEl.getBoundingClientRect();
                        const containerRect = appContainer.getBoundingClientRect();
                        const scrollOffset = targetRect.top - containerRect.top + appContainer.scrollTop - 70;
                        appContainer.scrollTo({ top: scrollOffset, behavior: 'smooth' });
                    } else {
                        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            const onScroll = () => {
                const windowHeight = window.innerHeight;

                let currentActiveId = targets[0]?.id;
                for (const t of targets) {
                    const rect = t.el.getBoundingClientRect();
                    if (rect.top <= 240) {
                        currentActiveId = t.id;
                    }
                }

                tocItems.forEach(item => {
                    const tid = item.getAttribute('data-target');
                    if (tid === currentActiveId) {
                        item.classList.add('active');
                    } else {
                        item.classList.remove('active');
                    }
                });

                if (articleSection && depthBar && depthVal) {
                    const rect = articleSection.getBoundingClientRect();
                    const totalHeight = rect.height;
                    const scrolledInto = -rect.top + 80;
                    const scrollableRange = totalHeight - windowHeight * 0.5;
                    let progress = Math.round((scrolledInto / scrollableRange) * 100);
                    progress = Math.max(0, Math.min(100, progress));

                    depthBar.style.width = `${progress}%`;
                    depthVal.innerText = `${progress.toString().padStart(2, '0')}%`;
                }
            };

            const appContainer = document.getElementById('app-container');
            if (appContainer) {
                appContainer.addEventListener('scroll', onScroll, { passive: true });
            }
            window.addEventListener('scroll', onScroll, { passive: true });
            document.addEventListener('scroll', onScroll, { passive: true });

            onScroll();
        }

        // [ アーカイブに戻る ] スマートリンク（直前の一覧ページがあれば履歴を戻りスクロール位置を復元）
        function initBackToArchiveLink() {
            const backLink = document.getElementById('back-to-archive-link');
            if (!backLink) return;

            backLink.addEventListener('click', (e) => {
                sessionStorage.setItem('dino_force_back_navigation', 'true');
                if (window.history.length > 1) {
                    if (document.referrer) {
                        try {
                            const refUrl = new URL(document.referrer);
                            if (refUrl.origin !== window.location.origin) {
                                return; // 外部サイトから直接開いた場合は通常のhref="/dictionary/"へ遷移
                            }
                        } catch (_) {}
                    }
                    e.preventDefault();
                    window.history.back();
                }
            });
        }

        // 初期化トリガー
        function initAll() {
            initSpecimenDetail();
            initSpecimenSlider();
            initArticleScrollSpy();
            initBackToArchiveLink();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAll);
        } else {
            initAll();
        }
        document.addEventListener('astro:page-load', initAll);
    </script>
</Layout>

