---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import AffiliateSection from '../../components/AffiliateSection.astro';
import { DINO_AFFILIATE_MAP } from '../../data/affiliate';
import { AUTHOR_DATA } from '../../data/author';

export async function getStaticPaths() {
  const topicEntries = await getCollection('topics');
  return topicEntries.map(entry => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { data: topic } = entry;
const { Content } = await render(entry);

// Fetch related specimens data
const dinosaurEntries = await getCollection('dinosaurs');
const relatedDinos = (topic.relatedSpecimens || []).map(specimenId => {
    const dEntry = dinosaurEntries.find(d => d.id === specimenId);
    return dEntry ? dEntry.data : null;
}).filter(Boolean);

// Determine affiliate target ID (use topic ID if custom map exists, otherwise fallback to related specimen)
const affiliateId = DINO_AFFILIATE_MAP[topic.id] ? topic.id : (topic.relatedSpecimens && topic.relatedSpecimens.length > 0 ? topic.relatedSpecimens[0] : null);

// Create structured data (JSON-LD) for Article SEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": topic.title,
  "description": topic.summary,
  "image": [
    `https://dino-portal.com/${topic.image}`
  ],
  "datePublished": topic.date.replace(/\./g, '-'),
  "author": {
    "@type": "Person",
    "name": AUTHOR_DATA.name
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dino-Portal Lab",
    "logo": {
      "@type": "ImageObject",
      "url": "https://dino-portal.com/favicon.png"
    }
  }
};
---

<Layout title={`${topic.title} | Dino-Portal`} activeTab="topics" description={topic.summary} ogImage={`/${topic.image}`} schema={articleSchema} preloadImage={`/${topic.image}`}>

    <article class="topic-article hud-panel">
        <div class="topic-detail-header" style="border-bottom: 1px solid var(--panel-border); padding-bottom: 15px; margin-bottom: 20px;">
            <div class="topic-meta" style="font-size: 11px; color: var(--primary-neon); font-family: var(--font-mono); margin-bottom: 8px;">
                {topic.date}
            </div>
            <h1 class="topic-title" style="color: var(--primary-neon); margin: 0; line-height: 1.35;">{topic.title}</h1>
        </div>
        
        <img src={`/${topic.image}`} class="topic-detail-img" alt={topic.title} width="800" height="400" decoding="async" fetchpriority="high">
        
        <div class="topic-content">
            <Content />
        </div>

        {affiliateId && (
            <AffiliateSection dinoId={affiliateId} />
        )}
        
        {relatedDinos.length > 0 && (
            <section class="related-specimens" style="margin-top: 60px;">
                <h2 class="related-title" style="border-bottom: 1px solid var(--panel-border); padding-bottom: 10px; margin-bottom: 20px; font-size: 14px; font-family: var(--font-mono); color: var(--primary-neon); font-weight: bold; letter-spacing: 1px;">
                    [ 関連する恐竜図鑑・実寸サイズ比較 ]
                </h2>
                <div class="related-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px;">
                    {relatedDinos.map(d => (
                        <a href={`/dictionary/${d.id}/`} style="text-decoration: none; color: inherit;" title={`【${d.name}】人間との実寸サイズ比較・図鑑データを見る`}>
                            <div class="related-card hud-panel" style="cursor: pointer; height: 100%;">
                                <div class="related-img-wrap" style="width: 100%; height: auto; aspect-ratio: 1 / 1; overflow: hidden; position: relative; background: #000;">
                                    <img src={`/${d.image}`} alt={d.name} width="160" height="160" loading="lazy" decoding="async" style="width: 100%; height: 100%; display: block; object-fit: contain;">
                                </div>
                                <h3 class="related-name" style="font-size: 13px; margin: 8px 0 4px 0; color: var(--text-main); font-weight: bold;">{d.name}</h3>
                                <div class="related-meta" style="font-size: 9px; color: var(--text-dim);">{d.era} / {d.region}</div>
                                <span style="font-size: 10px; color: var(--primary-neon); font-family: var(--font-mono); display: block; margin-top: 6px; font-weight: bold;">
                                    [ 実寸比較・詳細図鑑 &raquo; ]
                                </span>
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}

        <!-- 全トピックス共通の目玉機能（サイズ比較・クイズ）誘導 -->
        <section class="topic-features-cta hud-panel" style="margin-top: 50px; padding: 22px; border: 1px solid var(--panel-border); background: rgba(0, 242, 255, 0.02); border-radius: 6px;">
            <div style="font-size: 11px; font-family: var(--font-mono); color: var(--primary-neon); margin-bottom: 6px; letter-spacing: 1.5px; font-weight: bold;">
                [ INTERACTIVE LAB / 体験型シミュレータ＆機能 ]
            </div>
            <div style="font-size: 15px; font-weight: bold; color: #fff; margin-bottom: 12px;">
                Dino-Portalの体験機能で遊んでみよう
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 15px;">
                <a href="/size-comparison/" style="text-decoration: none; color: inherit; display: block; padding: 15px; border: 1px solid var(--panel-border); background: var(--panel-bg); border-radius: 4px; transition: all 0.3s ease;">
                    <div style="font-size: 14px; font-weight: bold; color: var(--primary-neon); margin-bottom: 5px;">📐 実寸サイズ比較シミュレータ</div>
                    <div style="font-size: 12px; color: var(--text-dim); line-height: 1.5;">好きな恐竜と人間（170cm）を1:1スケールで自由に並べて大きさを体感！</div>
                </a>
                <a href="/quiz/" style="text-decoration: none; color: inherit; display: block; padding: 15px; border: 1px solid var(--panel-border); background: var(--panel-bg); border-radius: 4px; transition: all 0.3s ease;">
                    <div style="font-size: 14px; font-weight: bold; color: var(--primary-neon); margin-bottom: 5px;">☵ 恐竜クイズチャレンジ</div>
                    <div style="font-size: 12px; color: var(--text-dim); line-height: 1.5;">古生物学の最新知識をテスト！全問正解を目指そう。</div>
                </a>
            </div>
        </section>
        
        <div style="margin-top: 40px; border-top: 1px solid var(--panel-border); padding-top: 20px;">
            <a href="/topics/" class="nav-link" aria-label="トピックス一覧に戻る" style="text-decoration: none;">[ トピックス一覧に戻る ]</a>
        </div>
    </article>
</Layout>
