---
import Layout from '../layouts/Layout.astro';
import PillarNav from '../components/PillarNav.astro';
import { getCollection } from 'astro:content';

const allDinosaurs = await getCollection('dinosaurs');
// 肉食恐竜・獣脚類（植物食を除く獣脚類、または肉食・魚食）を動的抽出
const carnivoreDinosaurs = allDinosaurs
  .filter(entry => {
    const d = entry.data;
    const isMeatOrFish = d.diet.includes('肉食') || d.diet.includes('魚食') || d.diet.includes('動物食');
    const isCarnivorousTheropod = d.group === '獣脚類' && !d.diet.includes('植物食');
    return isMeatOrFish || isCarnivorousTheropod;
  })
  .map(entry => entry.data);

// 50音順にデフォルトソート
carnivoreDinosaurs.sort((a, b) => a.kana.localeCompare(b.kana, 'ja'));

// パンくずリスト & 構造化データ (Schema.org)
const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://dino-portal.com/" },
  { "@type": "ListItem", "position": 2, "name": "恐竜図鑑", "item": "https://dino-portal.com/dictionary/" },
  { "@type": "ListItem", "position": 3, "name": "最強の肉食恐竜図鑑", "item": "https://dino-portal.com/carnivores/" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "最強の肉食恐竜図鑑 - 獣脚類の狩猟生態・噛む力・体長徹底比較",
    "description": "中生代に君臨した肉食恐竜・獣脚類を完全網羅。ティラノサウルス、スピノサウルス、ギガノトサウルス等の咬合力、捕食戦術、骨格適応を学術的に比較。",
    "url": "https://dino-portal.com/carnivores/",
    "hasPart": carnivoreDinosaurs.map(d => ({
      "@type": "Thing",
      "name": d.name,
      "url": `https://dino-portal.com/dictionary/${d.id}/`,
      "description": d.description
    }))
  }
];
---

<Layout 
  title="最強の肉食恐竜図鑑 - 獣脚類の狩猟生態・噛む力・体長徹底比較 | Dino-Portal" 
  description="ティラノサウルス、スピノサウルス、ギガノトサウルス、アロサウルスなど中生代の肉食恐竜・獣脚類を完全網羅。咬合力（噛む力）比較、捕食戦術、骨格適応、羽毛と知能の進化を学術的データで徹底解剖。"
  activeTab="dictionary"
  schema={schema}
>
  <div class="pillar-container" style="max-width: 1400px; margin: 0 auto; padding: 20px 20px 80px;">
    
    <!-- Breadcrumb bar -->
    <nav aria-label="パンくずリスト" style="margin-bottom: 25px; font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <a href="/" style="color: var(--primary-neon); text-decoration: none;">HOME</a>
      <span>/</span>
      <a href="/dictionary/" style="color: var(--primary-neon); text-decoration: none;">DICTIONARY</a>
      <span>/</span>
      <span style="color: var(--text-main);">TOPIC: CARNIVORES</span>
    </nav>

    <!-- Hero Banner Header -->
    <header class="pillar-hero hud-panel" style="padding: 40px; margin-bottom: 40px; position: relative; overflow: hidden; border-color: rgba(255, 153, 0, 0.4); background: linear-gradient(135deg, rgba(255, 153, 0, 0.08) 0%, rgba(3, 6, 8, 0.8) 100%);">
      <div class="hero-tag" style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: rgba(255, 153, 0, 0.15); border: 1px solid #ff9900; border-radius: 2px; font-family: var(--font-mono); font-size: 11px; color: #ff9900; margin-bottom: 15px; letter-spacing: 1.5px;">
        <span>// PREDATOR TAXONOMY ARCHIVE</span>
        <span>|</span>
        <span>THEROPODA & APEX HUNTERS</span>
      </div>
      
      <h1 style="font-size: clamp(26px, 4vw, 42px); font-weight: 800; color: var(--text-main); line-height: 1.3; margin-bottom: 15px; letter-spacing: -0.5px;">
        最強の肉食恐竜図鑑<br>
        <span style="font-size: clamp(16px, 2.5vw, 24px); color: #ff9900; font-weight: 600;">獣脚類の狩猟生態・咬合力・進化系統の全貌</span>
      </h1>

      <p style="font-size: 15px; line-height: 1.8; color: var(--text-dim); max-width: 900px; margin-bottom: 25px;">
        三畳紀後期の黎明期から白亜紀最末期に至るまで、陸上生態系の頂点捕食者として君臨し続けた肉食恐竜たち（獣脚類）。骨を噛み砕く超絶的な咬合力を誇るティラノサウルス、水辺の巨大魚類を仕留めた異形の巨獣スピノサウルス、鋭利な刃歯で巨大竜脚類に挑んだカルカロドントサウルス類、そして群れで獲物を追い詰めた知能派ドロマエオサウルス科。究極のハンターたちの武器と進化史を徹底解剖します。
      </p>

      <div class="hero-stats" style="display: flex; gap: 20px; flex-wrap: wrap; align-items: center; border-top: 1px solid rgba(255, 153, 0, 0.2); padding-top: 20px;">
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">REGISTERED CARNIVORES</span>
          <span style="font-size: 24px; font-weight: 700; color: #ff9900;">{carnivoreDinosaurs.length} <span style="font-size: 14px; color: var(--text-dim);">種掲載中</span></span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 153, 0, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">MAX BITE FORCE</span>
          <span style="font-size: 18px; font-weight: 600; color: var(--text-main);">推定 35,000 – 57,000 N</span>
        </div>
        <div style="height: 30px; width: 1px; background: rgba(255, 153, 0, 0.2);"></div>
        <div style="font-family: var(--font-mono);">
          <span style="font-size: 11px; color: var(--text-dim); display: block;">KEY FAMILIES</span>
          <span style="font-size: 14px; font-weight: 600; color: var(--text-main);">ティラノサウルス科 / スピノサウルス科 / アロサウルス上科</span>
        </div>
      </div>
    </header>

    <!-- Academic Guide Article Section -->
    <article class="academic-guide hud-panel" style="padding: 40px; margin-bottom: 50px; background: rgba(3, 6, 8, 0.6); border-color: rgba(255, 153, 0, 0.25);">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px; border-bottom: 2px solid #ff9900; padding-bottom: 15px;">
        <span style="font-size: 24px;">⚡</span>
        <h2 style="font-size: 22px; color: #ff9900; font-weight: 700; margin: 0; letter-spacing: 0.5px;">
          獣脚類の古生物学：解剖学的特長、捕食戦術、咬合力シミュレーション
        </h2>
      </div>

      <div class="article-content" style="color: var(--text-main); font-size: 15px; line-height: 1.9;">
        
        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ff9900; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            1. 獣脚類（Theropoda）：究極の捕食マシンの解剖学的共通点
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            肉食恐竜のほぼすべてが属する<strong style="color: var(--text-main); font-weight: 700;">獣脚類（Theropoda：けものあしるい）</strong>は、二足歩行に完全に特化した骨格を持ちます。強靭な尾が運動時のカウンターバランサー（釣り合い錘）として機能し、重心を骨盤直下に集中させることで、急停止や急速旋回を可能にしました。
          </p>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            骨の内部は極限まで空洞化（含気骨）されており、巨大な体躯でありながら俊敏なフットワークを実現。さらに、鳥類と同様の一方向性気嚢呼吸システムにより、激しい追跡劇の最中でも血中酸素濃度を極限まで高く保つことができました。歯の前後縁にはミクロ単位の<strong style="color: var(--text-main); font-weight: 700;">鋸歯（セレーション）</strong>が並び、獲物の分厚い皮や筋肉繊維をステーキナイフのように効率的に切り裂く構造となっています。
          </p>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ff9900; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            2. 三大超大型プレデターの比較：誰が「真の最強」か？
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            大衆文化において常に論争となる「最強の肉食恐竜」ですが、古生物学的にはそれぞれが全く異なる獲物と生態系ニッチに適応した「各分野のスペシャリスト」であることが分かっています。
          </p>
          
          <div style="background: rgba(255, 153, 0, 0.04); border-left: 3px solid #ff9900; padding: 15px 20px; margin: 15px 0; border-radius: 0 4px 4px 0;">
            <h4 style="font-size: 14px; color: #ff9900; margin-bottom: 8px; font-weight: 700;">⚔️ 三大超巨大肉食恐竜の生態学的プロファイル</h4>
            <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--text-dim); line-height: 1.7;">
              <li><strong>ティラノサウルス・レックス（骨砕き型）:</strong> 全長12〜13m、体重8〜9トン。咬合力は約35,000〜57,000ニュートン（現生ワニの3倍以上）。断面が楕円形のバナナ型歯で獲物の骨ごと粉砕・圧殺する絶対的パワー。両眼の視野が約55度重複し、優れた立体視と距離測定能力を誇る。</li>
              <li><strong>スピノサウルス（半水生・魚食型）:</strong> 全長14m超、体重7〜8トン。ワニのように細長い吻部、円滑な円錐歯、水流を感じ取る吻部の感覚神経孔、パドル状の平たい尾鰭。水深の深い河川環境でオンコプリスティス等の巨大魚類を捕食した水陸両棲の巨獣。</li>
              <li><strong>ギガノトサウルス（肉裂きスライサー型）:</strong> 全長12〜13m、体重7〜8トン。薄く平たいブレード状の歯が並び、超大型竜脚類（ティタノサウルス類）に深い裂傷を負わせて失血死を狙うハンティング戦術。</li>
            </ul>
          </div>
        </section>

        <section style="margin-bottom: 35px;">
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ff9900; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            3. 小型〜中型ハンターの知能・感覚器と羽毛の進化
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            巨大肉食恐竜の陰で、小型獣脚類は驚異的な知能と感覚器官の進化を遂げました。<strong style="color: var(--text-main); font-weight: 700;">ドロマエオサウルス科（ヴェロキラプトル、デイノニクス等）</strong>は、後肢第2指に大きく反り返った鋭利な「シックルクロー（鎌状鉤爪）」を持ち、獲物の背中に飛び乗って固定具として使用したと推測されています。
          </p>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            また、<strong style="color: var(--text-main); font-weight: 700;">トロオドン科</strong>は全恐竜中で最も高い脳化指数（EQ）を持ち、頭骨に占める脳容積が極めて大きく、大きな眼窩から夜間視覚や高度な状況判断能力を持っていたことが分かっています。彼らの体表を覆っていた羽毛は、敏捷な跳躍時の空気抵抗制御や求愛ディスプレイに用いられ、この系譜から現生鳥類が誕生しました。
          </p>
        </section>

        <section>
          <h3 style="font-size: 18px; color: #fff; border-left: 4px solid #ff9900; padding-left: 12px; margin-bottom: 15px; font-weight: 700;">
            4. 咬合力ランキングと最新の生体力学シミュレーション
          </h3>
          <p style="margin-bottom: 12px; color: var(--text-dim);">
            近年、有限要素法（FEA）によるCTスキャンデータを用いた咬合シミュレーションが劇的な進歩を遂げています。顎骨の骨密度、咬筋・翼突筋の付着面積、顎関節の応力分布を総合的に解析した結果、ティラノサウルスの噛む力は成体の象を上に乗せたのと同等の圧力を奥歯1本に集中させることが可能であったことが確認されました。
          </p>
          <p style="margin-bottom: 0; color: var(--text-dim);">
            一方で、アロサウルスの咬合力はライオン程度（約3,000N）と比較的控えめであったものの、頭骨全体の強度が極めて高く、上顎を打ち付ける「インパクトアタック」に耐える設計になっていたなど、単なる「数値の大小」ではなく、各恐竜が生存のために編み出した攻撃戦術の多様性が次々と明らかになっています。
          </p>
        </section>

      </div>
    </article>

    <!-- Specimen List & Interactive Filter Section -->
    <section class="specimen-section" style="margin-bottom: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 153, 0, 0.2); padding-bottom: 15px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 11px; color: #ff9900; letter-spacing: 2px;">// CARNIVORE SPECIMEN DATABASE</span>
          <h2 style="font-size: 24px; color: var(--text-main); margin-top: 5px; font-weight: 700;">肉食恐竜・獣脚類の登録標本一覧</h2>
        </div>

        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input 
            type="text" 
            id="specimen-search" 
            placeholder="肉食恐竜を検索..." 
            aria-label="肉食恐竜の名前で検索"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 153, 0, 0.05); border: 1px solid #ff9900; color: var(--text-main); border-radius: 4px; width: 220px;"
          >
          <select 
            id="specimen-sort" 
            aria-label="並び替え順"
            style="padding: 10px 15px; font-size: 13px; background: rgba(255, 153, 0, 0.05); border: 1px solid #ff9900; color: var(--text-main); border-radius: 4px;"
          >
            <option value="kana">かな順（あいうえお）</option>
            <option value="size-desc">全長順（大きい順）</option>
            <option value="size-asc">全長順（小さい順）</option>
          </select>
        </div>
      </div>

      <!-- Dinosaur Card Grid -->
      <div class="dino-grid" id="specimen-grid">
        {carnivoreDinosaurs.map(d => (
          <div class="dino-card hud-panel" data-name={d.name} data-kana={d.kana} data-length={d.length} data-diet={d.diet} data-group={d.group}>
            <a href={`/dictionary/${d.id}/`} style="text-decoration: none; color: inherit; display: block; height: 100%;">
              <div class="card-img-wrap" style="position: relative; overflow: hidden; aspect-ratio: 1 / 1; background: #000;">
                <img src={`/${d.image}`} alt={d.name} loading="lazy" decoding="async" width="400" height="400" style="width: 100%; height: 100%; object-fit: contain;">
                <div style="position: absolute; top: 8px; left: 8px; background: rgba(0, 0, 0, 0.7); padding: 2px 8px; border-radius: 2px; font-family: var(--font-mono); font-size: 10px; color: #ff9900; border: 1px solid rgba(255, 153, 0, 0.3);">
                  {d.era}
                </div>
              </div>
              <div class="card-info" style="padding: 15px;">
                <h3 class="card-title" style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 4px;">{d.name}</h3>
                <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-bottom: 10px; font-style: italic;">{d.scientificName}</div>
                <div class="card-tags" style="display: flex; gap: 6px; flex-wrap: wrap;">
                  <span class="card-tag group-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 153, 0, 0.1); border: 1px solid rgba(255, 153, 0, 0.3); border-radius: 2px; color: #ff9900;">{d.group || '獣脚類'}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: var(--text-dim);">{d.length}</span>
                  <span class="card-tag" style="font-size: 11px; padding: 2px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 2px; color: var(--text-dim);">{d.diet}</span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Topic Cluster Cross-Nav -->
    <PillarNav currentPillar="carnivores" />

  </div>

  <script>
    function initPillarSpecimens() {
      const search = document.getElementById('specimen-search') as HTMLInputElement;
      const sort = document.getElementById('specimen-sort') as HTMLSelectElement;
      const grid = document.getElementById('specimen-grid');
      if (!search || !sort || !grid) return;

      const cards = Array.from(grid.getElementsByClassName('dino-card')) as HTMLElement[];

      const parseLen = (str: string) => {
        const m = str.match(/[0-9.]+/);
        return m ? parseFloat(m[0]) : 0;
      };

      function updateGrid() {
        const query = search.value.trim().toLowerCase();
        const sortVal = sort.value;

        cards.forEach(card => {
          const name = (card.dataset.name || '').toLowerCase();
          const kana = (card.dataset.kana || '').toLowerCase();
          const match = !query || name.includes(query) || kana.includes(query);
          card.style.display = match ? 'block' : 'none';
        });

        const sorted = cards.slice().sort((a, b) => {
          if (sortVal === 'kana') {
            return (a.dataset.kana || '').localeCompare(b.dataset.kana || '', 'ja');
          } else if (sortVal === 'size-desc') {
            return parseLen(b.dataset.length || '0') - parseLen(a.dataset.length || '0');
          } else if (sortVal === 'size-asc') {
            return parseLen(a.dataset.length || '0') - parseLen(b.dataset.length || '0');
          }
          return 0;
        });

        sorted.forEach(c => grid.appendChild(c));
      }

      search.addEventListener('input', updateGrid);
      sort.addEventListener('change', updateGrid);
    }

    document.addEventListener('astro:page-load', initPillarSpecimens);
    initPillarSpecimens();
  </script>
</Layout>
