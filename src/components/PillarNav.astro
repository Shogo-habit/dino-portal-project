---
interface Props {
  currentPillar?: 'jurassic' | 'cretaceous' | 'carnivores' | 'marine-reptiles' | 'japan-dinosaurs';
}

const { currentPillar } = Astro.props;

const PILLARS = [
  {
    id: 'jurassic',
    href: '/period/jurassic/',
    badge: '時代別ピラー',
    title: 'ジュラ紀の恐竜完全ガイド',
    desc: '巨大竜脚類と剣竜類の黄金時代。モリソン層などジュラ紀の全貌。',
    accentColor: '#00f2ff',
    icon: '🦕'
  },
  {
    id: 'cretaceous',
    href: '/period/cretaceous/',
    badge: '時代別ピラー',
    title: '白亜紀の恐竜完全ガイド',
    desc: 'ティラノやトリケラが君臨した多様性の頂点とK-Pg大量絶滅。',
    accentColor: '#ff0055',
    icon: '🦖'
  },
  {
    id: 'carnivores',
    href: '/carnivores/',
    badge: '生態・系統別ピラー',
    title: '最強の肉食恐竜図鑑',
    desc: '二足歩行の頂点捕食者・獣脚類。噛む力・体長・狩猟生態を徹底比較。',
    accentColor: '#ff9900',
    icon: '⚡'
  },
  {
    id: 'marine-reptiles',
    href: '/marine-reptiles/',
    badge: '生息圏別ピラー',
    title: '中生代の海生爬虫類図鑑',
    desc: 'モササウルス、首長竜、魚竜。太古の海を支配した海棲プレデター。',
    accentColor: '#00d0ff',
    icon: '🌊'
  },
  {
    id: 'japan-dinosaurs',
    href: '/japan-dinosaurs/',
    badge: '地域特化ピラー',
    title: '日本の恐竜完全名鑑',
    desc: 'フクイラプトルからカムイサウルスまで、日本列島産化石の全網羅。',
    accentColor: '#00ff66',
    icon: '🗾'
  }
];
---

<section class="pillar-nav-section hud-panel" style="margin-top: 50px; padding: 30px 25px; border-color: var(--panel-border);">
  <div style="margin-bottom: 25px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 15px; border-bottom: 1px solid rgba(0, 242, 255, 0.2); padding-bottom: 15px;">
    <div>
      <span style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 2px;">TOPIC CLUSTER NAVIGATION</span>
      <h3 style="font-size: 20px; color: var(--text-main); margin-top: 5px; font-weight: 700;">テーマ別ピラーページ（完全網羅ガイド）</h3>
    </div>
    <span style="font-size: 13px; color: var(--text-dim); font-family: var(--font-mono);">全5大特集アーカイブ</span>
  </div>

  <div class="pillar-cards-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px;">
    {PILLARS.map(p => {
      const isCurrent = p.id === currentPillar;
      return (
        <a 
          href={p.href} 
          class={`pillar-nav-card ${isCurrent ? 'active' : ''}`}
          style={`text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; padding: 18px; border-radius: 4px; background: ${isCurrent ? 'rgba(0, 242, 255, 0.08)' : 'rgba(0, 0, 0, 0.4)'}; border: 1px solid ${isCurrent ? p.accentColor : 'rgba(255, 255, 255, 0.1)'}; transition: all 0.3s ease; position: relative; overflow: hidden;`}
        >
          <div style="margin-bottom: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style={`font-family: var(--font-mono); font-size: 10px; color: ${p.accentColor}; letter-spacing: 1px; background: rgba(0, 0, 0, 0.5); padding: 2px 6px; border-radius: 2px; border: 1px solid ${p.accentColor}44;`}>
                {p.badge}
              </span>
              <span style="font-size: 18px;">{p.icon}</span>
            </div>
            <h4 style={`font-size: 15px; font-weight: 700; color: ${isCurrent ? p.accentColor : 'var(--text-main)'}; margin-bottom: 6px; line-height: 1.4;`}>
              {p.title}
            </h4>
            <p style="font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0;">
              {p.desc}
            </p>
          </div>
          <div style={`font-family: var(--font-mono); font-size: 11px; color: ${p.accentColor}; display: flex; align-items: center; gap: 5px; margin-top: 10px;`}>
            {isCurrent ? '● 現在のページ' : '閲覧する →'}
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .pillar-nav-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary-neon) !important;
    background: rgba(0, 242, 255, 0.06) !important;
    box-shadow: 0 4px 15px rgba(0, 242, 255, 0.15);
  }
</style>
