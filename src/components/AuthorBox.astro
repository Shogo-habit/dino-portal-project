---
import { AUTHOR_DATA } from '../data/author';

interface Props {
  lastUpdated?: string;
}

const { lastUpdated } = Astro.props;
---

<div class="author-box-panel hud-panel" style="margin-top: 50px; padding: 24px; border: 1px solid var(--panel-border); background: rgba(0, 242, 255, 0.03); border-radius: 6px; position: relative;">
  <div class="hud-corner top-left"></div>
  <div class="hud-corner bottom-right"></div>
  
  <div style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 1px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
    <span style="font-weight: bold;">記事執筆・編集体制</span>
    {lastUpdated && (
      <span style="color: var(--text-dim); font-size: 10px;">最終査読・更新: {lastUpdated}</span>
    )}
  </div>

  <div class="author-content-wrap" style="display: flex; gap: 20px; align-items: flex-start;">
    <div class="author-avatar-wrap" style="flex-shrink: 0; text-align: center;">
      <div style="width: 72px; height: 72px; border: 2px solid var(--primary-neon); border-radius: 50%; overflow: hidden; background: #000; box-shadow: 0 0 15px rgba(0, 242, 255, 0.25); margin: 0 auto 8px auto;">
        <img src={AUTHOR_DATA.avatar} alt={AUTHOR_DATA.name} width="72" height="72" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <span style="display: inline-block; font-family: var(--font-mono); font-size: 9px; color: var(--secondary-neon); border: 1px solid var(--secondary-neon); padding: 1px 6px; border-radius: 3px; background: rgba(0, 255, 170, 0.08);">
        EDITOR
      </span>
    </div>

    <div class="author-info" style="flex: 1; min-width: 0;">
      <div style="display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 6px;">
        <h4 style="font-size: 16px; font-weight: bold; color: #fff; margin: 0;">{AUTHOR_DATA.name}</h4>
        <span style="font-size: 11px; color: var(--primary-neon); font-family: var(--font-mono);">{AUTHOR_DATA.role}</span>
      </div>
      
      <p style="font-size: 12.5px; color: #cfe6eb; line-height: 1.65; margin: 0 0 12px 0;">
        {AUTHOR_DATA.bio}
      </p>

      <!-- 編集・ファクトチェック方針の要約バッジ -->
      <div style="background: rgba(1, 15, 28, 0.7); border: 1px solid rgba(0, 242, 255, 0.2); padding: 10px 14px; border-radius: 4px; font-size: 11.5px; line-height: 1.6; color: var(--text-dim); margin-bottom: 12px;">
        <div style="color: var(--secondary-neon); font-weight: bold; font-family: var(--font-mono); font-size: 10px; margin-bottom: 4px;">
          🔬 科学的根拠とファクトチェック基準:
        </div>
        本記事は、国内外の査読付き一次論文（Nature, Science, Cretaceous Research等）および博物館の公式標本データを参照して構成しています。数値・解剖学的特徴は公開論文に基づき編集者が検証を行っています。
      </div>

      <!-- リンク導線 -->
      <div style="display: flex; gap: 15px; font-size: 11px; font-family: var(--font-mono); flex-wrap: wrap;">
        <a href="/about/" style="color: var(--primary-neon); text-decoration: none;">[ 運営者プロフィール・編集ポリシー詳細 &raquo; ]</a>
        <a href="/contact/" style="color: var(--text-dim); text-decoration: none;">[ 情報提供・誤り指摘窓口 &raquo; ]</a>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 600px) {
    .author-content-wrap {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .author-info {
      text-align: left;
    }
  }
</style>
