---
import '../styles/global.css';
import '@fontsource-variable/inter';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  activeTab?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
  preloadImage?: string;
}

const { 
  title, 
  description = 'Dino-Portal: デジタル恐竜図鑑。300種以上の恐竜データを最新の学説に基づき網羅。AI検索に最適化された次世代の生物学的アーカイブ。', 
  activeTab = 'home',
  ogImage = '/images/map/world/cyber_world_map.webp',
  ogType = 'website',
  noindex = false,
  schema,
  preloadImage
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dino-portal.com/');
const fullOgImageUrl = new URL(ogImage, 'https://dino-portal.com/');
---
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Favicon and App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL.href}>
    
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    


    <!-- Open Graph / Facebook (SEO & SNS) -->
    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalURL.href}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={fullOgImageUrl.href}>

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalURL.href}>
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content={fullOgImageUrl.href}>

    <!-- Google Search Console verification -->
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}

    <!-- Google Analytics (GA4) -->
    {import.meta.env.PUBLIC_GA_TRACKING_ID && (
      <>
        <script is:inline type="text/javascript" src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_TRACKING_ID}`} defer></script>
        <script is:inline type="text/javascript" define:vars={{ gaId: import.meta.env.PUBLIC_GA_TRACKING_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Base Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Dino-Portal Lab",
      "url": "https://dino-portal.com/",
      "logo": "https://dino-portal.com/logo.png",
      "description": "次世代の恐竜デジタルアーカイブプロジェクト"
    }
    </script>
    
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
    
    <ClientRouter />
</head>
<body class="hud-theme">
    <!-- Overlay effects -->
    <div class="scanlines" style="pointer-events: none;"></div>
    <div class="grid-overlay" style="pointer-events: none;"></div>
    <div class="noise-overlay" style="pointer-events: none;"></div>
 
    <header class="main-header">
        <a href="/" class="logo-container" style="text-decoration: none;">
            <div class="logo-prefix">プロジェクト</div>
            <div class="logo-text">DINO-PORTAL</div>
            <div class="status-indicator">ディノ・ポータル</div>
        </a>
        <nav class="nav-menu" aria-label="メインナビゲーション">
            <a href="/" class={`nav-link ${activeTab === 'home' ? 'active' : ''}`} aria-label="ホーム画面へ">
                <span class="nav-icon" aria-hidden="true">▤</span> ホーム
            </a>
            <a href="/dictionary/" class={`nav-link ${activeTab === 'dictionary' ? 'active' : ''}`} aria-label="恐竜図鑑を表示">
                <span class="nav-icon" aria-hidden="true">☷</span> 恐竜図鑑
            </a>
            <a href="/size-comparison/" class={`nav-link ${activeTab === 'comparison' ? 'active' : ''}`} aria-label="サイズ比較シミュレータを表示">
                <span class="nav-icon" aria-hidden="true">📐</span> サイズ比較
            </a>
            <a href="/world-map/" class={`nav-link ${activeTab === 'world-map' ? 'active' : ''}`} aria-label="世界地図から探索">
                <span class="nav-icon" aria-hidden="true">◰</span> 世界地図
            </a>
            <a href="/topics/" class={`nav-link ${activeTab === 'topics' ? 'active' : ''}`} aria-label="恐竜に関するトピックスを読む">
                <span class="nav-icon" aria-hidden="true">▧</span> トピックス
            </a>
            <a href="/my-collection/" class={`nav-link ${activeTab === 'my-collection' ? 'active' : ''}`} aria-label="自分の観測データを確認">
                <span class="nav-icon" aria-hidden="true">📊</span> マイ図鑑
            </a>
            <a href="/quiz/" class={`nav-link ${activeTab === 'quiz' ? 'active' : ''}`} aria-label="恐竜クイズに挑戦">
                <span class="nav-icon" aria-hidden="true">☵</span> クイズ
            </a>
            <a href="/contact/" class={`nav-link ${activeTab === 'contact' ? 'active' : ''}`} aria-label="お問い合わせ">
                <span class="nav-icon" aria-hidden="true">✉</span> お問い合わせ
            </a>
        </nav>
    </header>

    <main id="app-container">
        <div id="app-content-wrapper">
            <slot />
        </div>

        <footer class="main-footer" style="padding: 40px 20px 25px; border-top: 1px solid rgba(0, 242, 255, 0.2); background: rgba(3, 6, 8, 0.95); margin-top: 60px;">
            <div class="footer-nav-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; max-width: 1300px; margin: 0 auto 35px;">
                <div>
                    <div style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 1.5px; margin-bottom: 12px; font-weight: bold;">
                        [ GEOLOGICAL ERAS / 時代別アーカイブ ]
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; line-height: 2;">
                        <li><a href="/period/triassic/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">三畳紀の古生物完全ガイド</a></li>
                        <li><a href="/period/jurassic/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">ジュラ紀の恐竜完全ガイド</a></li>
                        <li><a href="/period/cretaceous/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">白亜紀の恐竜完全ガイド</a></li>
                    </ul>
                </div>
                <div>
                    <div style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 1.5px; margin-bottom: 12px; font-weight: bold;">
                        [ TAXONOMY & CLADES / 生態・系統別 ]
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; line-height: 2;">
                        <li><a href="/carnivores/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">最強の肉食恐竜図鑑</a></li>
                        <li><a href="/herbivores/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">巨大草食恐竜図鑑</a></li>
                        <li><a href="/marine-reptiles/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">中生代の海生爬虫類図鑑</a></li>
                        <li><a href="/japan-dinosaurs/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">日本の恐竜完全名鑑</a></li>
                    </ul>
                </div>
                <div>
                    <div style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 1.5px; margin-bottom: 12px; font-weight: bold;">
                        [ INTERACTIVE FEATURES / シミュレータ・マップ ]
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; line-height: 2;">
                        <li><a href="/size-comparison/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">実寸サイズ比較シミュレータ</a></li>
                        <li><a href="/world-map/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">世界恐竜発見マップ</a></li>
                        <li><a href="/japan-map/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">日本恐竜発掘マップ</a></li>
                        <li><a href="/quiz/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">恐竜博士クイズ</a></li>
                    </ul>
                </div>
                <div>
                    <div style="font-family: var(--font-mono); font-size: 11px; color: var(--primary-neon); letter-spacing: 1.5px; margin-bottom: 12px; font-weight: bold;">
                        [ FEATURED TOPICS / 注目の特集記事 ]
                    </div>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; line-height: 2;">
                        <li><a href="/topics/jurassic-world-dinosaurs-vs-reality/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">映画と本物の恐竜の違い徹底検証</a></li>
                        <li><a href="/topics/dinosaur-size-ranking/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">太古で一番大きい恐竜ランキング</a></li>
                        <li><a href="/topics/strongest-dinosaur-debate/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">最強恐竜は誰だ？徹底論争</a></li>
                        <li><a href="/topics/not-dinosaurs-truth/" style="color: #cfe6eb; text-decoration: none; transition: color 0.2s ease;">翼竜・首長竜が恐竜じゃない理由</a></li>
                    </ul>
                </div>
            </div>

            <div class="ai-disclaimer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; border-top: 1px solid rgba(0, 242, 255, 0.15); padding-top: 20px; max-width: 1300px; margin: 0 auto;">
                <span style="font-size: 12px; color: var(--text-dim);">本図鑑の視覚データは、最新の古生物学的知見に基づきAIによって生成されたシミュレーション画像です。</span>
                <div class="footer-links" style="display: flex; gap: 15px;">
                    <a href="/privacy/" class="footer-privacy-link" style="color: var(--primary-neon); text-decoration: none; font-size: 11px; font-family: var(--font-mono); transition: opacity 0.3s ease;">
                        [ PRIVACY POLICY ]
                    </a>
                    <a href="/contact/" class="footer-privacy-link" style="color: var(--primary-neon); text-decoration: none; font-size: 11px; font-family: var(--font-mono); transition: opacity 0.3s ease;">
                        [ CONTACT ]
                    </a>
                </div>
            </div>
        </footer>
    </main>

    <!-- Global Scroll Restoration for #app-container & window across Astro ClientRouter -->
    <script>
        const SCROLL_POS_CACHE_KEY = 'dino_portal_scroll_positions';
        const FORCE_BACK_KEY = 'dino_force_back_navigation';
        let navigationMode: 'idle' | 'back' | 'forward' = 'idle';
        let restoreTimer: any = null;

        function normalizePath(rawPath: string): string {
            try {
                const url = new URL(rawPath, window.location.origin);
                let p = url.pathname;
                if (!p.endsWith('/')) p += '/';
                return url.search ? `${p}${url.search}` : p;
            } catch (_) {
                return rawPath;
            }
        }

        function getContainer(): HTMLElement | null {
            return document.getElementById('app-container');
        }

        function getScrollTop(container: HTMLElement | null): number {
            if (container && container.scrollHeight > container.clientHeight && getComputedStyle(container).overflowY !== 'visible') {
                return container.scrollTop;
            }
            return window.pageYOffset || document.documentElement.scrollTop;
        }

        function setScrollTop(container: HTMLElement | null, top: number) {
            if (container && container.scrollHeight > container.clientHeight && getComputedStyle(container).overflowY !== 'visible') {
                container.scrollTop = top;
            }
            window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
        }

        function saveCurrentPosition() {
            const container = getContainer();
            const currentPath = normalizePath(window.location.pathname + window.location.search);
            const currentScroll = getScrollTop(container);

            if (currentScroll > 0) {
                try {
                    const cache = JSON.parse(sessionStorage.getItem(SCROLL_POS_CACHE_KEY) || '{}');
                    cache[currentPath] = currentScroll;
                    sessionStorage.setItem(SCROLL_POS_CACHE_KEY, JSON.stringify(cache));
                } catch (_) {}
            }
        }

        // スクロール中も常に最新位置をキャッシュ（80msデバウンス）
        let scrollSaveTimer: any = null;
        function onScrollThrottled() {
            clearTimeout(scrollSaveTimer);
            scrollSaveTimer = setTimeout(() => {
                saveCurrentPosition();
            }, 80);
        }

        // 1. Astro ClientRouterのナビゲーション開始を監視
        document.addEventListener('astro:before-preparation', (event: any) => {
            const isBackward = event.direction === 'backward' || event.direction === 'back';
            const fromPath = normalizePath(window.location.pathname);
            const toUrl = new URL(event.to.href, window.location.origin);
            const toPath = normalizePath(toUrl.pathname);

            // 詳細ページから一覧ページ（/dictionary/ または /topics/）へ戻る場合
            const isReturnToDictionary = fromPath.startsWith('/dictionary/') && fromPath !== '/dictionary/' && toPath === '/dictionary/';
            const isReturnToTopics = fromPath.startsWith('/topics/') && fromPath !== '/topics/' && toPath === '/topics/';
            const isForceBack = sessionStorage.getItem(FORCE_BACK_KEY) === 'true';

            if (isBackward || isReturnToDictionary || isReturnToTopics || isForceBack) {
                navigationMode = 'back';
            } else {
                navigationMode = 'forward';
            }
            sessionStorage.removeItem(FORCE_BACK_KEY);
            saveCurrentPosition();
        });

        // 2. ブラウザ標準のpopstate（戻る・進む）でも捕捉
        window.addEventListener('popstate', () => {
            navigationMode = 'back';
        });

        // 3. ページ離脱直前（before-swap）でも確実に最新位置を保存
        document.addEventListener('astro:before-swap', saveCurrentPosition);

        // 4. カード等のリンククリック時に即座に現在位置を保存
        document.addEventListener('click', (e) => {
            const target = (e.target as HTMLElement)?.closest('a');
            if (target && target.href && !target.href.startsWith('#')) {
                saveCurrentPosition();
            }
        }, { capture: true, passive: true });

        // 5. スクロール復元処理
        function performScrollRestoration() {
            const container = getContainer();
            const targetPath = normalizePath(window.location.pathname + window.location.search);

            // スクロールリスナーの再登録
            if (container) {
                container.removeEventListener('scroll', onScrollThrottled);
                container.addEventListener('scroll', onScrollThrottled, { passive: true });
            }
            window.removeEventListener('scroll', onScrollThrottled);
            window.addEventListener('scroll', onScrollThrottled, { passive: true });

            if (navigationMode === 'back') {
                try {
                    const cache = JSON.parse(sessionStorage.getItem(SCROLL_POS_CACHE_KEY) || '{}');
                    const savedPos = cache[targetPath];

                    if (typeof savedPos === 'number' && savedPos > 0) {
                        const applyScroll = () => {
                            setScrollTop(container, savedPos);
                        };

                        // DOM描画や画像のレイアウト確定のズレに対応して多段で確実に固定
                        applyScroll();
                        requestAnimationFrame(applyScroll);
                        setTimeout(applyScroll, 30);
                        setTimeout(applyScroll, 80);
                        setTimeout(applyScroll, 180);
                        setTimeout(applyScroll, 320);
                        setTimeout(applyScroll, 500);
                    }
                } catch (_) {}

                // 一定時間経過後にナビゲーションモードをidleにリセット（page-load等での誤爆防止）
                clearTimeout(restoreTimer);
                restoreTimer = setTimeout(() => {
                    navigationMode = 'idle';
                }, 600);
            } else if (navigationMode === 'forward') {
                // 通常の前方遷移時は一番上から表示
                setScrollTop(container, 0);
                navigationMode = 'idle';
            }
        }

        document.addEventListener('astro:after-swap', performScrollRestoration);
        document.addEventListener('astro:page-load', performScrollRestoration);
    </script>
</body>
</html>
